(module parse
  (import rdf
    (Term Triple term-eq term-kind make-iri make-literal triple-subject triple-predicate triple-object Literal IRI TermKind))
  (import index
    (IndexedGraph indexed-graph-match indexed-graph-objects indexed-graph-subjects indexed-graph-size indexed-graph-contains indexed-graph-for-each indexed-graph-create))
  (import list (rdf-list-elements-indexed))
  (import vocab
    (RDF_TYPE SHACL_NODE_SHAPE SHACL_PROPERTY_SHAPE SHACL_TARGET_NODE SHACL_TARGET_CLASS SHACL_TARGET_SUBJECTS_OF SHACL_TARGET_OBJECTS_OF SHACL_PATH SHACL_INVERSE_PATH SHACL_ALTERNATIVE_PATH SHACL_ZERO_OR_MORE_PATH SHACL_ONE_OR_MORE_PATH SHACL_ZERO_OR_ONE_PATH SHACL_CLASS SHACL_DATATYPE SHACL_NODE_KIND SHACL_MIN_COUNT SHACL_MAX_COUNT SHACL_MIN_INCLUSIVE SHACL_MAX_INCLUSIVE SHACL_MIN_EXCLUSIVE SHACL_MAX_EXCLUSIVE SHACL_MIN_LENGTH SHACL_MAX_LENGTH SHACL_PATTERN SHACL_FLAGS SHACL_LANGUAGE_IN SHACL_UNIQUE_LANG SHACL_EQUALS SHACL_DISJOINT SHACL_LESS_THAN SHACL_LESS_THAN_OR_EQUALS SHACL_NOT SHACL_AND SHACL_OR SHACL_XONE SHACL_NODE SHACL_PROPERTY SHACL_QUALIFIED_VALUE_SHAPE SHACL_QUALIFIED_MIN_COUNT SHACL_QUALIFIED_MAX_COUNT SHACL_QUALIFIED_VALUE_SHAPES_DISJOINT SHACL_CLOSED SHACL_IGNORED_PROPERTIES SHACL_HAS_VALUE SHACL_IN SHACL_IRI SHACL_BLANK_NODE SHACL_LITERAL SHACL_BLANK_NODE_OR_IRI SHACL_BLANK_NODE_OR_LITERAL SHACL_IRI_OR_LITERAL SHACL_SEVERITY SHACL_VIOLATION SHACL_WARNING SHACL_INFO SHACL_SHAPE RDF_FIRST RDF_REST RDF_NIL XSD_INTEGER XSD_BOOLEAN))
  (import strlib (parse-int))
  (import types
    (ShaclPath NodeKind Severity Constraint PropertyShape NodeShape ShapesGraph))
  (export
    parse-shapes-graph
    parse-node-shape
    parse-property-shape
    parse-path
    parse-constraints
    parse-node-kind
    parse-severity)

  (@doc "Parse SHACL shapes from RDF triples into structured shapes graph")

  (fn shape-has-path ((arena Arena) (g IndexedGraph) (ref Term))
    (@intent
      "True if the referenced shape declares an sh:path, i.e. it is a property shape (SHACL 2.1.2)")
    (@spec ((Arena IndexedGraph Term) -> Bool))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/s"))
      ->
      false)
    (>
      (list-len (indexed-graph-objects arena g ref (make-iri arena SHACL_PATH)))
      0))

  (fn register-inline-shapes ((arena Arena) (g IndexedGraph) (node-shapes (List NodeShape)) (prop-shapes (List PropertyShape)) (shape-map (Map Term NodeShape)) (property-shape-map (Map Term PropertyShape)))
    (@intent
      "Register inline blank node shapes referenced by constraints into shape maps")
    (@spec
      ((Arena IndexedGraph (List NodeShape) (List PropertyShape) (Map Term NodeShape) (Map Term PropertyShape)) -> Unit))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (list-new arena NodeShape)
        (list-new arena PropertyShape)
        (map-new arena Term NodeShape)
        (map-new arena Term PropertyShape)))
    (let ((mut ns-queue (list-new arena Term))
          (mut ps-queue (list-new arena Term)))
      (for-each (ns node-shapes)
        (for-each (c (. ns constraints))
          (match c
            ((con-not ref) (list-push ns-queue ref))
            ((con-and refs) (for-each (r refs) (list-push ns-queue r)))
            ((con-or refs) (for-each (r refs) (list-push ns-queue r)))
            ((con-xone refs) (for-each (r refs) (list-push ns-queue r)))
            ((con-node ref) (list-push ns-queue ref))
            ((con-qualified-value-shape ref _ _ _) (list-push ns-queue ref))
            ((con-property ref) (list-push ps-queue ref))
            (_ (do))))
        (for-each (ps (. ns property-shapes))
          (for-each (c (. ps constraints))
            (match c
              ((con-not ref) (list-push ns-queue ref))
              ((con-and refs) (for-each (r refs) (list-push ns-queue r)))
              ((con-or refs) (for-each (r refs) (list-push ns-queue r)))
              ((con-xone refs) (for-each (r refs) (list-push ns-queue r)))
              ((con-node ref) (list-push ns-queue ref))
              ((con-qualified-value-shape ref _ _ _) (list-push ns-queue ref))
              ((con-property ref) (list-push ps-queue ref))
              (_ (do))))))
      (for-each (ps prop-shapes)
        (for-each (c (. ps constraints))
          (match c
            ((con-not ref) (list-push ns-queue ref))
            ((con-and refs) (for-each (r refs) (list-push ns-queue r)))
            ((con-or refs) (for-each (r refs) (list-push ns-queue r)))
            ((con-xone refs) (for-each (r refs) (list-push ns-queue r)))
            ((con-node ref) (list-push ns-queue ref))
            ((con-qualified-value-shape ref _ _ _) (list-push ns-queue ref))
            ((con-property ref) (list-push ps-queue ref))
            (_ (do)))))
      (let ((mut ns-i 0)
            (mut ps-i 0)
            (mut changed true))
        (while changed
          (set! changed false)
          (while (< ns-i (list-len ns-queue))
            (match (list-get ns-queue ns-i)
              ((some ref)
                (match (map-get shape-map ref)
                  ((none)
                    (if (shape-has-path arena g ref)
                      (match (map-get property-shape-map ref)
                        ((none) (set! changed true) (list-push ps-queue ref))
                        ((some _) (do)))
                      (do
                        (set! changed true)
                        (let ((ns (parse-node-shape arena g ref)))
                          (map-put shape-map ref ns)
                          (for-each (c (. ns constraints))
                            (match c
                              ((con-not r) (list-push ns-queue r))
                              ((con-and rs)
                                (for-each (r rs) (list-push ns-queue r)))
                              ((con-or rs)
                                (for-each (r rs) (list-push ns-queue r)))
                              ((con-xone rs)
                                (for-each (r rs) (list-push ns-queue r)))
                              ((con-node r) (list-push ns-queue r))
                              ((con-qualified-value-shape r _ _ _)
                                (list-push ns-queue r))
                              ((con-property r) (list-push ps-queue r))
                              (_ (do))))
                          (for-each (ps (. ns property-shapes))
                            (match (map-get property-shape-map (. ps id))
                              ((none) (map-put property-shape-map (. ps id) ps))
                              ((some _) (do)))
                            (for-each (c (. ps constraints))
                              (match c
                                ((con-not r) (list-push ns-queue r))
                                ((con-and rs)
                                  (for-each (r rs) (list-push ns-queue r)))
                                ((con-or rs)
                                  (for-each (r rs) (list-push ns-queue r)))
                                ((con-xone rs)
                                  (for-each (r rs) (list-push ns-queue r)))
                                ((con-node r) (list-push ns-queue r))
                                ((con-qualified-value-shape r _ _ _)
                                  (list-push ns-queue r))
                                ((con-property r) (list-push ps-queue r))
                                (_ (do)))))))))
                  ((some _) (do))))
              ((none) (do)))
            (set! ns-i (+ ns-i 1)))
          (while (< ps-i (list-len ps-queue))
            (match (list-get ps-queue ps-i)
              ((some ref)
                (match (map-get property-shape-map ref)
                  ((none)
                    (set! changed true)
                    (let ((ps (parse-property-shape arena g ref)))
                      (map-put property-shape-map ref ps)
                      (for-each (c (. ps constraints))
                        (match c
                          ((con-not r) (list-push ns-queue r))
                          ((con-and rs)
                            (for-each (r rs) (list-push ns-queue r)))
                          ((con-or rs) (for-each (r rs) (list-push ns-queue r)))
                          ((con-xone rs)
                            (for-each (r rs) (list-push ns-queue r)))
                          ((con-node r) (list-push ns-queue r))
                          ((con-qualified-value-shape r _ _ _)
                            (list-push ns-queue r))
                          ((con-property r) (list-push ps-queue r))
                          (_ (do))))))
                  ((some _) (do))))
              ((none) (do)))
            (set! ps-i (+ ps-i 1)))))))

  (fn parse-shapes-graph ((arena Arena) (shapes-graph IndexedGraph))
    (@intent
      "Extract all SHACL shapes from an RDF shapes graph into a structured ShapesGraph")
    (@spec ((Arena IndexedGraph) -> ShapesGraph))
    (@alloc arena)
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    (@post (>= (list-len (. $result node-shapes)) 0))
    (@example (arena (indexed-graph-create arena)))
    (let ((type-pred (make-iri arena RDF_TYPE))
          (ns-type (make-iri arena SHACL_NODE_SHAPE))
          (ps-type (make-iri arena SHACL_PROPERTY_SHAPE))
          (no-term (Option Term) (none))
          (ns-subjects (indexed-graph-subjects arena shapes-graph type-pred ns-type))
          (ps-subjects (indexed-graph-subjects arena shapes-graph type-pred ps-type))
          (mut node-shapes (list-new arena NodeShape))
          (mut prop-shapes (list-new arena PropertyShape))
          (shape-map (map-new arena Term NodeShape))
          (property-shape-map (map-new arena Term PropertyShape)))
      (for-each (ns-id ns-subjects)
        (let ((ns (parse-node-shape arena shapes-graph ns-id)))
          (list-push node-shapes ns)
          (map-put shape-map ns-id ns)
          (for-each (ps (. ns property-shapes))
            (map-put property-shape-map (. ps id) ps))))
      (for-each (ps-id ps-subjects)
        (let ((ps (parse-property-shape arena shapes-graph ps-id))
              (t-nodes (indexed-graph-objects arena shapes-graph ps-id (make-iri arena SHACL_TARGET_NODE)))
              (t-classes (indexed-graph-objects arena shapes-graph ps-id (make-iri arena SHACL_TARGET_CLASS)))
              (t-subj (indexed-graph-objects arena shapes-graph ps-id (make-iri arena SHACL_TARGET_SUBJECTS_OF)))
              (t-obj (indexed-graph-objects arena shapes-graph ps-id (make-iri arena SHACL_TARGET_OBJECTS_OF))))
          (map-put property-shape-map ps-id ps)
          (if (or
              (> (list-len t-nodes) 0)
              (or
                (> (list-len t-classes) 0)
                (or (> (list-len t-subj) 0) (> (list-len t-obj) 0))))
            (let ((mut ps-list (list-new arena PropertyShape)))
              (list-push ps-list ps)
              (let ((ns (record-new NodeShape (id ps-id) (target-nodes t-nodes) (target-classes t-classes) (target-subjects-of t-subj) (target-objects-of t-obj) (property-shapes ps-list) (constraints (list-new arena Constraint)) (severity 'severity-violation) (message (none)) (deactivated (. ps deactivated)))))
                (list-push node-shapes ns)
                (map-put shape-map ps-id ns)))
            (list-push prop-shapes ps))))
      (let ((target-pred-tn (make-iri arena SHACL_TARGET_NODE))
            (target-pred-tc (make-iri arena SHACL_TARGET_CLASS))
            (target-pred-ts (make-iri arena SHACL_TARGET_SUBJECTS_OF))
            (target-pred-to (make-iri arena SHACL_TARGET_OBJECTS_OF))
            (path-pred (make-iri arena SHACL_PATH))
            (mut target-preds (list-new arena Term)))
        (list-push target-preds target-pred-tn)
        (list-push target-preds target-pred-tc)
        (list-push target-preds target-pred-ts)
        (list-push target-preds target-pred-to)
        (for-each (tp target-preds)
          (let ((triples (indexed-graph-match arena shapes-graph no-term (some tp) no-term)))
            (for-each (tr triples)
              (let ((subj (triple-subject tr)))
                (match (map-get shape-map subj)
                  ((some _) (do))
                  ((none)
                    (let ((path-vals (indexed-graph-objects arena shapes-graph subj path-pred)))
                      (if (> (list-len path-vals) 0)
                        (let ((ps (parse-property-shape arena shapes-graph subj))
                              (t-nodes (indexed-graph-objects arena shapes-graph subj target-pred-tn))
                              (t-classes (indexed-graph-objects arena shapes-graph subj target-pred-tc))
                              (t-subj (indexed-graph-objects arena shapes-graph subj target-pred-ts))
                              (t-obj (indexed-graph-objects arena shapes-graph subj target-pred-to)))
                          (map-put property-shape-map subj ps)
                          (let ((mut ps-list (list-new arena PropertyShape)))
                            (list-push ps-list ps)
                            (let ((ns (record-new NodeShape (id subj) (target-nodes t-nodes) (target-classes t-classes) (target-subjects-of t-subj) (target-objects-of t-obj) (property-shapes ps-list) (constraints (list-new arena Constraint)) (severity 'severity-violation) (message (none)) (deactivated (. ps deactivated)))))
                              (list-push node-shapes ns)
                              (map-put shape-map subj ns))))
                        (let ((ns (parse-node-shape arena shapes-graph subj)))
                          (list-push node-shapes ns)
                          (map-put shape-map subj ns)
                          (for-each (ps (. ns property-shapes))
                            (map-put property-shape-map (. ps id) ps))))))))))))
      (register-inline-shapes
        arena
        shapes-graph
        node-shapes
        prop-shapes
        shape-map
        property-shape-map)
      (record-new
        ShapesGraph
        (node-shapes node-shapes)
        (property-shapes prop-shapes)
        (shape-map shape-map)
        (property-shape-map property-shape-map)))
    :c-name
    "snarl_parse_shapes_graph")

  (fn parse-node-shape ((arena Arena) (g IndexedGraph) (shape-id Term))
    (@intent "Parse a single NodeShape from the shapes graph by its identifier")
    (@spec ((Arena IndexedGraph Term) -> NodeShape))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/Shape")))
    (let ((target-nodes (indexed-graph-objects arena g shape-id (make-iri arena SHACL_TARGET_NODE)))
          (target-classes (indexed-graph-objects arena g shape-id (make-iri arena SHACL_TARGET_CLASS)))
          (target-subjects-of (indexed-graph-objects arena g shape-id (make-iri arena SHACL_TARGET_SUBJECTS_OF)))
          (target-objects-of (indexed-graph-objects arena g shape-id (make-iri arena SHACL_TARGET_OBJECTS_OF)))
          (prop-refs (indexed-graph-objects arena g shape-id (make-iri arena SHACL_PROPERTY)))
          (mut prop-shapes (list-new arena PropertyShape))
          (constraints (parse-constraints arena g shape-id))
          (severity (parse-shape-severity arena g shape-id))
          (message (parse-shape-message arena g shape-id))
          (deactivated (parse-shape-deactivated arena g shape-id)))
      (for-each (ps-ref prop-refs)
        (list-push prop-shapes (parse-property-shape arena g ps-ref)))
      (record-new
        NodeShape
        (id shape-id)
        (target-nodes target-nodes)
        (target-classes target-classes)
        (target-subjects-of target-subjects-of)
        (target-objects-of target-objects-of)
        (property-shapes prop-shapes)
        (constraints constraints)
        (severity severity)
        (message message)
        (deactivated deactivated)))
    :c-name
    "snarl_parse_node_shape")

  (fn parse-property-shape ((arena Arena) (g IndexedGraph) (shape-id Term))
    (@intent
      "Parse a single PropertyShape from the shapes graph by its identifier")
    (@spec ((Arena IndexedGraph Term) -> PropertyShape))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/ps")))
    (let ((path-objects (indexed-graph-objects arena g shape-id (make-iri arena SHACL_PATH)))
          (path (if (> (list-len path-objects) 0) (match (list-get path-objects 0) ((some path-term) (parse-path arena g path-term)) ((none) (union-new ShaclPath path-predicate shape-id))) (union-new ShaclPath path-predicate shape-id)))
          (constraints (parse-constraints arena g shape-id))
          (severity (parse-shape-severity arena g shape-id))
          (message (parse-shape-message arena g shape-id))
          (deactivated (parse-shape-deactivated arena g shape-id)))
      (record-new
        PropertyShape
        (id shape-id)
        (path path)
        (constraints constraints)
        (severity severity)
        (message message)
        (deactivated deactivated)))
    :c-name
    "snarl_parse_property_shape")

  (fn parse-path ((arena Arena) (g IndexedGraph) (path-node Term))
    (@intent
      "Parse a SHACL path expression from an RDF node in the shapes graph")
    (@spec ((Arena IndexedGraph Term) -> ShaclPath))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/name")))
    (let ((no-term (Option Term) (none))
          (first-pred (make-iri arena RDF_FIRST))
          (first-objs (indexed-graph-objects arena g path-node first-pred))
          (inverse-objs (indexed-graph-objects arena g path-node (make-iri arena SHACL_INVERSE_PATH)))
          (alt-objs (indexed-graph-objects arena g path-node (make-iri arena SHACL_ALTERNATIVE_PATH)))
          (zom-objs (indexed-graph-objects arena g path-node (make-iri arena SHACL_ZERO_OR_MORE_PATH)))
          (oom-objs (indexed-graph-objects arena g path-node (make-iri arena SHACL_ONE_OR_MORE_PATH)))
          (zoo-objs (indexed-graph-objects arena g path-node (make-iri arena SHACL_ZERO_OR_ONE_PATH))))
      (cond
        ((> (list-len first-objs) 0)
          (let ((elements (rdf-list-elements-indexed arena g path-node))
                (mut paths (list-new arena ShaclPath)))
            (for-each (elem elements)
              (list-push paths (parse-path arena g elem)))
            (union-new ShaclPath path-sequence paths)))
        ((> (list-len inverse-objs) 0)
          (match (list-get inverse-objs 0)
            ((some inner)
              (let ((p (parse-path arena g inner))
                    (ptr (cast (Ptr ShaclPath) (arena-alloc arena 128))))
                (set! (deref ptr) p)
                (union-new ShaclPath path-inverse ptr)))
            ((none) (union-new ShaclPath path-predicate path-node))))
        ((> (list-len alt-objs) 0)
          (match (list-get alt-objs 0)
            ((some list-head)
              (let ((elements (rdf-list-elements-indexed arena g list-head))
                    (mut paths (list-new arena ShaclPath)))
                (for-each (elem elements)
                  (list-push paths (parse-path arena g elem)))
                (union-new ShaclPath path-alternative paths)))
            ((none) (union-new ShaclPath path-predicate path-node))))
        ((> (list-len zom-objs) 0)
          (match (list-get zom-objs 0)
            ((some inner)
              (let ((p (parse-path arena g inner))
                    (ptr (cast (Ptr ShaclPath) (arena-alloc arena 128))))
                (set! (deref ptr) p)
                (union-new ShaclPath path-zero-or-more ptr)))
            ((none) (union-new ShaclPath path-predicate path-node))))
        ((> (list-len oom-objs) 0)
          (match (list-get oom-objs 0)
            ((some inner)
              (let ((p (parse-path arena g inner))
                    (ptr (cast (Ptr ShaclPath) (arena-alloc arena 128))))
                (set! (deref ptr) p)
                (union-new ShaclPath path-one-or-more ptr)))
            ((none) (union-new ShaclPath path-predicate path-node))))
        ((> (list-len zoo-objs) 0)
          (match (list-get zoo-objs 0)
            ((some inner)
              (let ((p (parse-path arena g inner))
                    (ptr (cast (Ptr ShaclPath) (arena-alloc arena 128))))
                (set! (deref ptr) p)
                (union-new ShaclPath path-zero-or-one ptr)))
            ((none) (union-new ShaclPath path-predicate path-node))))
        (true (union-new ShaclPath path-predicate path-node))))
    :c-name
    "snarl_parse_path")

  (fn parse-constraints ((arena Arena) (g IndexedGraph) (shape-id Term))
    (@intent "Parse all SHACL constraints declared on a shape node")
    (@spec ((Arena IndexedGraph Term) -> (List Constraint)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/Shape")))
    (let ((mut constraints (list-new arena Constraint)))
      (let ((class-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_CLASS))))
        (for-each (v class-vals)
          (list-push constraints (union-new Constraint con-class v))))
      (let ((dt-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_DATATYPE))))
        (for-each (v dt-vals)
          (list-push constraints (union-new Constraint con-datatype v))))
      (let ((nk-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_NODE_KIND))))
        (for-each (v nk-vals)
          (match (parse-node-kind v)
            ((some nk)
              (list-push constraints (union-new Constraint con-node-kind nk)))
            ((none) (do)))))
      (let ((mc-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MIN_COUNT))))
        (for-each (v mc-vals)
          (match (term-to-int v)
            ((some n)
              (list-push constraints (union-new Constraint con-min-count n)))
            ((none) (do)))))
      (let ((mc-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MAX_COUNT))))
        (for-each (v mc-vals)
          (match (term-to-int v)
            ((some n)
              (list-push constraints (union-new Constraint con-max-count n)))
            ((none) (do)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MIN_INCLUSIVE))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-min-inclusive v))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MAX_INCLUSIVE))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-max-inclusive v))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MIN_EXCLUSIVE))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-min-exclusive v))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MAX_EXCLUSIVE))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-max-exclusive v))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MIN_LENGTH))))
        (for-each (v vals)
          (match (term-to-int v)
            ((some n)
              (list-push constraints (union-new Constraint con-min-length n)))
            ((none) (do)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_MAX_LENGTH))))
        (for-each (v vals)
          (match (term-to-int v)
            ((some n)
              (list-push constraints (union-new Constraint con-max-length n)))
            ((none) (do)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_PATTERN))))
        (for-each (v vals)
          (match (term-to-string v)
            ((some s)
              (list-push constraints (union-new Constraint con-pattern s)))
            ((none) (do)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_LANGUAGE_IN))))
        (for-each (v vals)
          (let ((langs (parse-string-list arena g v)))
            (list-push constraints (union-new Constraint con-language-in langs)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_UNIQUE_LANG))))
        (for-each (v vals)
          (match (term-to-string v)
            ((some s)
              (when (string-eq s "true")
                (list-push
                  constraints
                  (union-new Constraint con-unique-lang true))))
            ((none) (do)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_EQUALS))))
        (for-each (v vals)
          (list-push
            constraints
            (union-new
              Constraint
              con-equals
              (union-new ShaclPath path-predicate v)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_DISJOINT))))
        (for-each (v vals)
          (list-push
            constraints
            (union-new
              Constraint
              con-disjoint
              (union-new ShaclPath path-predicate v)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_LESS_THAN))))
        (for-each (v vals)
          (list-push
            constraints
            (union-new
              Constraint
              con-less-than
              (union-new ShaclPath path-predicate v)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_LESS_THAN_OR_EQUALS))))
        (for-each (v vals)
          (list-push
            constraints
            (union-new
              Constraint
              con-less-than-or-equals
              (union-new ShaclPath path-predicate v)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_NOT))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-not v))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_AND))))
        (for-each (v vals)
          (let ((shapes (rdf-list-elements-indexed arena g v)))
            (list-push constraints (union-new Constraint con-and shapes)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_OR))))
        (for-each (v vals)
          (let ((shapes (rdf-list-elements-indexed arena g v)))
            (list-push constraints (union-new Constraint con-or shapes)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_XONE))))
        (for-each (v vals)
          (let ((shapes (rdf-list-elements-indexed arena g v)))
            (list-push constraints (union-new Constraint con-xone shapes)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_NODE))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-node v))))
      (let ((prop-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_PROPERTY))))
        (for-each (v prop-vals)
          (list-push constraints (union-new Constraint con-property v))))
      (let ((qvs-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_QUALIFIED_VALUE_SHAPE))))
        (for-each (v qvs-vals)
          (let ((qmin-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_QUALIFIED_MIN_COUNT)))
                (qmax-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_QUALIFIED_MAX_COUNT)))
                (qmin (if (> (list-len qmin-vals) 0) (match (list-get qmin-vals 0) ((some t) (match (term-to-int t) ((some n) n) ((none) 0))) ((none) 0)) 0))
                (qmax (if (> (list-len qmax-vals) 0) (match (list-get qmax-vals 0) ((some t) (match (term-to-int t) ((some n) (some n)) ((none) (none)))) ((none) (none))) (none)))
                (disjoint-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_QUALIFIED_VALUE_SHAPES_DISJOINT)))
                (disjoint (if (> (list-len disjoint-vals) 0) (match (list-get disjoint-vals 0) ((some t) (match (term-to-bool t) ((some b) b) ((none) false))) ((none) false)) false)))
            (list-push
              constraints
              (union-new
                Constraint
                con-qualified-value-shape
                v
                qmin
                qmax
                disjoint)))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_HAS_VALUE))))
        (for-each (v vals)
          (list-push constraints (union-new Constraint con-has-value v))))
      (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_IN))))
        (for-each (v vals)
          (let ((elements (rdf-list-elements-indexed arena g v)))
            (list-push constraints (union-new Constraint con-in elements)))))
      (let ((closed-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_CLOSED))))
        (for-each (v closed-vals)
          (match (term-to-bool v)
            ((some b)
              (when b
                (let ((ignored-vals (indexed-graph-objects arena g shape-id (make-iri arena SHACL_IGNORED_PROPERTIES)))
                      (mut ignored-paths (list-new arena ShaclPath)))
                  (for-each (iv ignored-vals)
                    (let ((elements (rdf-list-elements-indexed arena g iv)))
                      (for-each (elem elements)
                        (list-push
                          ignored-paths
                          (union-new ShaclPath path-predicate elem)))))
                  (list-push
                    constraints
                    (union-new Constraint con-closed true ignored-paths)))))
            ((none) (do)))))
      constraints)
    :c-name
    "snarl_parse_constraints")

  (fn parse-node-kind ((term Term))
    (@intent "Parse an sh:nodeKind value from its IRI term")
    (@spec ((Term) -> (Option NodeKind)))
    (@pure)
    (@example ((term-iri (IRI "http://www.w3.org/ns/shacl#IRI"))))
    (@example ((term-literal (Literal "foo" (none) (none)))))
    (match term
      ((term-iri iri)
        (cond
          ((string-eq (. iri value) SHACL_BLANK_NODE)
            (some 'node-kind-blank-node))
          ((string-eq (. iri value) SHACL_IRI) (some 'node-kind-iri))
          ((string-eq (. iri value) SHACL_LITERAL)
            (some 'node-kind-literal))
          ((string-eq (. iri value) SHACL_BLANK_NODE_OR_IRI)
            (some 'node-kind-blank-node-or-iri))
          ((string-eq (. iri value) SHACL_BLANK_NODE_OR_LITERAL)
            (some 'node-kind-blank-node-or-literal))
          ((string-eq (. iri value) SHACL_IRI_OR_LITERAL)
            (some 'node-kind-iri-or-literal))
          (else (none))))
      (_ (none)))
    :c-name
    "snarl_parse_node_kind")

  (fn parse-severity ((term Term))
    (@intent "Parse sh:severity value from IRI term")
    (@spec ((Term) -> Severity))
    (@pure)
    (@example ((term-iri (IRI "http://www.w3.org/ns/shacl#Warning"))))
    (@example ((term-iri (IRI "http://www.w3.org/ns/shacl#Violation"))))
    (match term
      ((term-iri iri)
        (cond
          ((string-eq (. iri value) SHACL_WARNING) 'severity-warning)
          ((string-eq (. iri value) SHACL_INFO) 'severity-info)
          (else 'severity-violation)))
      (_ 'severity-violation))
    :c-name
    "snarl_parse_severity")

  (fn parse-shape-severity ((arena Arena) (g IndexedGraph) (shape-id Term))
    (@intent "Get the severity declared on a shape, defaulting to violation")
    (@spec ((Arena IndexedGraph Term) -> Severity))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/Shape")))
    (let ((sev-vals (indexed-graph-objects arena g shape-id (make-iri arena "http://www.w3.org/ns/shacl#severity"))))
      (if (> (list-len sev-vals) 0)
        (match (list-get sev-vals 0)
          ((some v) (parse-severity v))
          ((none) 'severity-violation))
        'severity-violation)))

  (fn parse-shape-message ((arena Arena) (g IndexedGraph) (shape-id Term))
    (@intent "Get the sh:message declared on a shape, if any")
    (@spec ((Arena IndexedGraph Term) -> (Option String)))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/Shape")))
    (let ((msg-vals (indexed-graph-objects arena g shape-id (make-iri arena "http://www.w3.org/ns/shacl#message"))))
      (if (> (list-len msg-vals) 0)
        (match (list-get msg-vals 0)
          ((some v) (term-to-string v))
          ((none) (none)))
        (none))))

  (fn parse-shape-deactivated ((arena Arena) (g IndexedGraph) (shape-id Term))
    (@intent "Check if a shape has sh:deactivated true")
    (@spec ((Arena IndexedGraph Term) -> Bool))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/Shape")))
    (let ((vals (indexed-graph-objects arena g shape-id (make-iri arena "http://www.w3.org/ns/shacl#deactivated"))))
      (if (> (list-len vals) 0)
        (match (list-get vals 0)
          ((some v) (match (term-to-bool v) ((some b) b) ((none) false)))
          ((none) false))
        false)))

  (fn term-to-int ((t Term))
    (@intent "Extract integer value from a literal term")
    (@spec ((Term) -> (Option (Int 0 ..))))
    (@pure)
    (@example
      ((term-literal (Literal "42" (some "http://www.w3.org/2001/XMLSchema#integer") (none))))
      ->
      (some 42))
    (@example ((term-literal (Literal "hello" (none) (none)))) -> (none))
    (@example ((term-iri (IRI "http://example.org/x"))) -> (none))
    (match t
      ((term-literal lit)
        (match (parse-int (. lit value))
          ((ok n) (if (>= n 0) (some n) (none)))
          ((error _) (none))))
      (_ (none))))

  (fn term-to-string ((t Term))
    (@intent "Extract string value from a literal term")
    (@spec ((Term) -> (Option String)))
    (@pure)
    (@example
      ((term-literal (Literal "hello" (none) (none))))
      ->
      (some "hello"))
    (@example ((term-iri (IRI "http://example.org/x"))) -> (none))
    (match t
      ((term-literal lit) (some (. lit value)))
      (_ (none))))

  (fn term-to-bool ((t Term))
    (@intent "Extract boolean value from a literal term")
    (@spec ((Term) -> (Option Bool)))
    (@pure)
    (@example
      ((term-literal (Literal "true" (some "http://www.w3.org/2001/XMLSchema#boolean") (none))))
      ->
      (some true))
    (@example
      ((term-literal (Literal "false" (some "http://www.w3.org/2001/XMLSchema#boolean") (none))))
      ->
      (some false))
    (@example ((term-iri (IRI "http://example.org/x"))) -> (none))
    (match t
      ((term-literal lit)
        (cond
          ((string-eq (. lit value) "true") (some true))
          ((string-eq (. lit value) "1") (some true))
          ((string-eq (. lit value) "false") (some false))
          ((string-eq (. lit value) "0") (some false))
          (else (none))))
      (_ (none))))

  (fn parse-string-list ((arena Arena) (g IndexedGraph) (list-head Term))
    (@intent "Parse an RDF list of literal strings")
    (@spec ((Arena IndexedGraph Term) -> (List String)))
    (@alloc arena)
    (@example
      (arena
        (indexed-graph-create arena)
        (make-iri arena "http://example.org/list")))
    (let ((elements (rdf-list-elements-indexed arena g list-head))
          (mut result (list-new arena String)))
      (for-each (elem elements)
        (match (term-to-string elem)
          ((some s) (list-push result s))
          ((none) (do))))
      result)))
