(module engine
  (import rdf (Term Triple IRI term-eq term-kind make-iri triple-subject))
  (import index (TermSet))
  (import strlib (string-build))
  (import data-graph
    (SnarlDataGraph snarl-data-graph-size snarl-data-graph-object-set snarl-data-graph-term-set-size snarl-data-graph-term-set-to-list snarl-data-graph-has-object))
  (import vocab
    (SHACL_CLASS SHACL_DATATYPE SHACL_NODE_KIND SHACL_MIN_COUNT SHACL_MAX_COUNT SHACL_MIN_INCLUSIVE SHACL_MAX_INCLUSIVE SHACL_MIN_EXCLUSIVE SHACL_MAX_EXCLUSIVE SHACL_MIN_LENGTH SHACL_MAX_LENGTH SHACL_PATTERN SHACL_EQUALS SHACL_DISJOINT SHACL_LESS_THAN SHACL_LESS_THAN_OR_EQUALS SHACL_NOT SHACL_AND SHACL_OR SHACL_XONE SHACL_NODE SHACL_PROPERTY SHACL_QUALIFIED_VALUE_SHAPE SHACL_HAS_VALUE SHACL_IN SHACL_CLOSED))
  (import types
    (ShaclPath NodeKind Severity Constraint PropertyShape NodeShape ShapesGraph ValidationResult ValidationReport ValidatorConfig ValidatorResult make-validation-report report-add-result report-conforms default-validator-config term-display-label))
  (import target (ClassIndex build-class-index target-cache-create resolve-targets resolve-targets-cached))
  (import path (resolve-path))
  (import value-type (check-class check-class-with-index check-datatype check-node-kind))
  (import cardinality (check-min-count check-max-count))
  (import value-range
    (check-min-inclusive check-max-inclusive check-min-exclusive check-max-exclusive))
  (import string
    (check-min-length check-max-length check-pattern check-language-in check-unique-lang))
  (import other (check-has-value check-in check-closed))
  (import pair
    (check-equals check-disjoint check-less-than check-less-than-or-equals))
  (import logical (check-not check-and check-or check-xone))
  (import shape (check-node check-qualified-value-shape))
  (export
    engine-validate
    evaluate-node-shape
    evaluate-node-shape-cached
    evaluate-property-shape
    evaluate-property-shape-cached
    evaluate-constraint
    evaluate-constraint-cached
    evaluate-constraint-for-property-cached
    evaluate-shape-against-node
    evaluate-shape-against-node-cached
    property-shape-conforms-cached)

  (@doc "SHACL validation engine: single-pass constraint evaluation")

  ;; ============================================================
  ;; Shape-recursion guard
  ;;
  ;; Path-scoped, pair-keyed cycle detection for shape-reference recursion
  ;; (sh:not / sh:and / sh:or / sh:xone / sh:node / sh:qualifiedValueShape /
  ;; sh:property). `pairs` tracks (shape-ref, focus-or-value-node) pairs
  ;; currently on the active recursion path: outer map keyed by shape-ref,
  ;; inner map holds, per node, a small integer count of how many active
  ;; descents through that (shape-ref, node) pair are currently open on THIS
  ;; guard. Keying on the pair (not the shape alone) is required: the same
  ;; shape legitimately re-evaluated against a *different* node (e.g. a
  ;; recursive PersonShape walking alice -> bob over acyclic data) is not a
  ;; cycle, only a revisit of the same pair is. `errors` holds the first
  ;; deterministic cycle message, if any; engine-validate reads it and mints
  ;; ValidatorResult::Error instead of a success report.
  ;;
  ;; `errors` is a single-slot Map (key 0), not a List: CycleGuard is passed
  ;; *by value* everywhere it is threaded, and only Map/Set fields carry
  ;; genuine pointer (shared, mutable-through-a-copy) semantics here — a List
  ;; field mutated deep in the recursion would only update that call's local
  ;; stack copy and never be seen by engine-validate's own copy. `pairs`
  ;; above is already Map-backed for the same reason.
  ;;
  ;; Callers add a pair before descending into a shape reference and remove
  ;; it after returning (DFS ancestor-stack discipline), so unrelated
  ;; sibling references to the same shape (a diamond DAG) never collide.
  ;;
  ;; FB2 root cause (fix-round finding, confirmed empirically): the inner
  ;; per-shape-ref collection used to be a `TermSet` (a `Set Term`, i.e. a
  ;; `Map Term <dummy>` under the hood), and cycle-guard-remove called
  ;; `set-remove` on it. The generic open-addressed hash table backing every
  ;; `Set`/`Map` in this runtime (csrc/runtime/slop_runtime.h's
  ;; `slop_map_remove`) vacates a slot on removal WITHOUT leaving a
  ;; tombstone, which breaks the linear-probe invariant `slop_map_get` and
  ;; `slop_map_put` rely on (both stop scanning at the first unoccupied
  ;; slot): a later lookup or insert for a DIFFERENT key that originally
  ;; probed past the now-vacated slot can be corrupted -- silently
  ;; misreported as present (false positive), silently missed (false
  ;; negative), or duplicated. One CycleGuard's `pairs` entry is shared and
  ;; mutated by EVERY focus node of a node-shape (engine-validate creates it
  ;; once per node-shape, see below), so a shape like a `sh:targetClass`
  ;; PersonShape recursing over dozens/hundreds of independently-targeted,
  ;; sequentially-named nodes drives exactly the add/remove churn on one
  ;; shared table that reproduces this: `f1-chain-50.ttl` (50 nodes, all
  ;; independently ex:Person-targeted, each triggering a full add-chain /
  ;; remove-chain through the SAME shared TermSet) produced a false "Shape
  ;; recursion" report on a 100% acyclic chain. This runtime hash table is
  ;; NOT SLOP source (csrc/runtime/, not regenerated by `make csrc`, and out
  ;; of the "no hand-edited csrc/*" fence's reach either way) -- the fix
  ;; here is to never call the buggy removal path AT ALL: track an integer
  ;; descent COUNT per (shape-ref, node) pair instead of set membership, and
  ;; always mutate it via `map-put` (insert-or-UPDATE-in-place), which never
  ;; vacates a slot and so never corrupts a probe chain. "On the current
  ;; path" becomes "count > 0"; cycle-guard-remove decrements in place
  ;; rather than deleting the entry.
  ;; ============================================================

  ;; ------------------------------------------------------------
  ;; FB2 depth budget: a SEPARATE, empirically-measured native-C-stack
  ;; backstop, independent of the pair-revisit corruption fixed above.
  ;;
  ;; Even with the reference-counting fix, a LEGITIMATE (acyclic) shape
  ;; recursing through a long chain of distinct data nodes still recurses
  ;; natively through this engine's mutually-recursive evaluate-* family
  ;; (evaluate-shape-against-node-cached -> evaluate-node-shape-cached ->
  ;; evaluate-property-shape-cached / evaluate-simple-predicate-property-
  ;; shape-cached -> evaluate-constraint-for-property-cached /
  ;; evaluate-constraint-for-simple-predicate-cached ->
  ;; evaluate-constraint-cached (for con-node) -> back) once per chain
  ;; level -- roughly five C stack frames per level, none of it SLOP-level
  ;; recursion this guard can see or short-circuit mid-way. Bisected
  ;; empirically on this machine (ulimit -s 8176, -O2, DIRECTLY against the
  ;; compiled build/snarl, both with a single sh:node constraint and with a
  ;; heavier 3-property-shape/6-constraint-per-level shape): safe through
  ;; depth ~850-860, SIGSEGV at depth ~870-880 regardless of per-level
  ;; constraint count (confirms the ceiling is the fixed mutual-recursion
  ;; call chain, not per-level work). This is NOT the CycleGuard bug --
  ;; it reproduces identically on a from-scratch build with the corrected,
  ;; reference-counted guard above. Re-bisected again AFTER adding this
  ;; very depth-tracking machinery below (its own map-put/map-get calls add
  ;; a little more per-frame stack use): safe through ~760, SIGSEGV at
  ;; ~780. MAX_RECURSION_DEPTH is set with real margin under THAT
  ;; (post-instrumentation) measured number, not the earlier one.
  ;;
  ;; A genuine fix requires converting that mutual recursion into an
  ;; explicit iterative worklist -- the same technique this fix-round
  ;; applies to the parse-time path structures (see parse.slop) -- but
  ;; that is a rewrite of the core evaluator's control flow, not a
  ;; guard-local change, and is out of this round's scope. Per the fix-
  ;; round brief's own guidance ("legitimate deep recursion needs an
  ;; explicit depth-budget ERROR (never a crash) -- determine which and
  ;; say so"): this IS that case. The budget below comfortably covers
  ;; "dozens to hundreds" of chained entities -- the realistic scale the
  ;; fix-round's own test-adequacy lens (lens 3) used to frame what
  ;; legitimate data looks like. It does NOT cover N=3000: seeing this
  ;; budget message where a genuine, much deeper conforming answer was
  ;; expected is the signal that the evaluator's recursion itself needs to
  ;; become iterative, not that the budget should simply be raised
  ;; (raising it just moves the same native-stack crash to a larger, still
  ;; finite N -- verified: raising it to 800 without re-measuring the
  ;; post-instrumentation boundary reproduced the SIGSEGV this budget
  ;; exists to prevent).
  (fn cycle-guard-max-recursion-depth ()
    (@intent "Named ceiling on active (shape-ref, node) descents open at once on a single guard, see the depth-budget note above")
    (@spec (() -> Int))
    (@pure)
    600)

  (type CycleGuard (record
    (pairs (Map Term (Map Term Int)))
    (depth (Map Int Int))
    (errors (Map Int String))))

  ;; NIT (lens-1 finding): `depth` and `errors` are each single-slot Maps
  ;; (see the by-value/pointer-semantics note above); the slot key is
  ;; always this one named constant, never a real, meaningful Int, so it
  ;; reads at each call site as "the one slot" rather than an unexplained
  ;; bare 0.
  (const CYCLE_GUARD_SLOT Int 0)

  (fn cycle-guard-new ((arena Arena))
    (@intent "Create a fresh, empty shape-recursion guard for a new evaluation root")
    (@spec ((Arena) -> CycleGuard))
    (@alloc arena)
    (record-new CycleGuard
      (pairs (map-new arena Term (Map Term Int)))
      (depth (map-new arena Int Int))
      (errors (map-new arena Int String))))

  (fn cycle-guard-depth ((guard CycleGuard))
    (@intent "Current active recursion depth on this guard: the number of cycle-guard-add calls not yet matched by a cycle-guard-remove")
    (@spec ((CycleGuard) -> Int))
    (match (map-get (. guard depth) CYCLE_GUARD_SLOT)
      ((some d) d)
      ((none) 0)))

  (fn cycle-guard-pair-active ((guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "True if (shape-ref, node) is already on the current recursion path, i.e. has a positive open-descent count. The narrow pair-revisit check; cycle-guard-has below widens this with the depth-budget backstop.")
    (@spec ((CycleGuard Term Term) -> Bool))
    (match (map-get (. guard pairs) shape-ref)
      ((some counts)
        (match (map-get counts node)
          ((some c) (> c 0))
          ((none) false)))
      ((none) false)))

  (fn cycle-guard-has ((guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "True if descending into (shape-ref, node) must be refused: either it is already on the current recursion path (a genuine shape-reference cycle), or this guard has reached its recursion depth budget (a backstop against legitimate-but-too-deep recursion overflowing the native C stack -- see the depth-budget note above). Every call site's existing fail-closed cycle-guard-flag handling covers both cases identically; cycle-guard-flag itself disambiguates which one fired for the error message.")
    (@spec ((CycleGuard Term Term) -> Bool))
    (or
      (cycle-guard-pair-active guard shape-ref node)
      (>= (cycle-guard-depth guard) (cycle-guard-max-recursion-depth))))

  (fn cycle-guard-add ((arena Arena) (guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "Add (shape-ref, node) to the current recursion path before descending into it -- increments its open-descent count and the guard's overall depth via map-put (never a removing/deleting op, so it never exercises the runtime's tombstone-less-deletion hazard, see FB2 note above)")
    (@spec ((Arena CycleGuard Term Term) -> Unit))
    (map-put (. guard depth) CYCLE_GUARD_SLOT (+ (cycle-guard-depth guard) 1))
    (match (map-get (. guard pairs) shape-ref)
      ((some counts)
        (match (map-get counts node)
          ((some c) (map-put counts node (+ c 1)))
          ((none) (map-put counts node 1))))
      ((none)
        (let ((counts (map-new arena Term Int)))
          (map-put counts node 1)
          (map-put (. guard pairs) shape-ref counts)))))

  (fn cycle-guard-remove ((arena Arena) (guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "Remove (shape-ref, node) from the current recursion path after returning from it -- decrements its open-descent count and the guard's overall depth via map-put (in place; entries are never deleted, only zeroed, so the underlying table is never mutated through the runtime's buggy removal path, see FB2 note above)")
    (@spec ((Arena CycleGuard Term Term) -> Unit))
    (@pre (cycle-guard-pair-active guard shape-ref node))
    (map-put (. guard depth) CYCLE_GUARD_SLOT (- (cycle-guard-depth guard) 1))
    (match (map-get (. guard pairs) shape-ref)
      ((some counts)
        (match (map-get counts node)
          ((some c) (map-put counts node (- c 1)))
          ;; Unreachable given adds/removes are paired by construction
          ;; (@pre above documents and, in debug builds, enforces that);
          ;; kept as a defensive no-op rather than a hard failure in release
          ;; builds so an unbalanced-descent bug degrades to "guard under-
          ;; counts" instead of a crash.
          ((none) (do))))
      ((none) (do))))

  (fn cycle-guard-flag ((arena Arena) (guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "Record a deterministic error message for a refused (shape-ref, node) descent -- a genuine revisit (shape recursion) or a depth-budget hit, disambiguated by re-checking the narrow pair-active condition. First flag on a given guard wins; later flags on the same guard are no-ops.")
    (@spec ((Arena CycleGuard Term Term) -> Unit))
    (if (cycle-guard-pair-active guard shape-ref node)
      (cycle-guard-flag-recursion arena guard shape-ref node)
      (cycle-guard-flag-depth-budget arena guard shape-ref node)))

  (fn cycle-guard-flag-depth-budget ((arena Arena) (guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "Record a deterministic recursion-depth-budget error message. See the depth-budget note above CycleGuard's declaration for why this backstop exists and what it does and does not cover.")
    (@spec ((Arena CycleGuard Term Term) -> Unit))
    (when (not (map-has (. guard errors) CYCLE_GUARD_SLOT))
      (let ((shape-label (term-display-label shape-ref "[anonymous shape]"))
            (node-label (term-display-label node "[anonymous node]"))
            (mut parts (list-new arena String)))
        (list-push parts "Shape recursion depth budget (")
        (list-push parts (int-to-string arena (cycle-guard-max-recursion-depth)))
        (list-push parts ") exceeded: shape ")
        (list-push parts shape-label)
        (list-push parts " re-entered while resolving node ")
        (list-push parts node-label)
        (list-push parts " -- recursion this deep cannot be proven acyclic without risking a native stack overflow")
        (map-put (. guard errors) CYCLE_GUARD_SLOT (string-build arena parts)))))

  (fn cycle-guard-flag-recursion ((arena Arena) (guard CycleGuard) (shape-ref Term) (node Term))
    (@intent "Record a deterministic shape-recursion error message for a revisited (shape-ref, node) pair. First flag on a given guard wins; later flags on the same guard are no-ops.")
    (@spec ((Arena CycleGuard Term Term) -> Unit))
    (when (not (map-has (. guard errors) CYCLE_GUARD_SLOT))
      (let ((shape-label (term-display-label shape-ref "[anonymous shape]"))
            (node-label (term-display-label node "[anonymous node]"))
            (mut parts (list-new arena String)))
        (list-push parts "Shape recursion detected: shape ")
        (list-push parts shape-label)
        (list-push parts " was re-entered for node ")
        (list-push parts node-label)
        (list-push parts " while still on the current validation path")
        (map-put (. guard errors) CYCLE_GUARD_SLOT (string-build arena parts)))))

  (fn optional-term-set-size ((values (Option TermSet)))
    (@intent "Count an optional term set")
    (@spec (((Option TermSet)) -> (Int 0 ..)))
    (@pure)
    (@post (>= $result 0))
    (match values
      ((some terms) (snarl-data-graph-term-set-size terms))
      ((none) 0)))

  (fn optional-term-set-to-list ((arena Arena) (values (Option TermSet)))
    (@intent "Materialize an optional term set only when a list-based constraint needs it")
    (@spec ((Arena (Option TermSet)) -> (List Term)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (match values
      ((some terms) (snarl-data-graph-term-set-to-list arena terms))
      ((none) (list-new arena Term))))

  (fn evaluate-shape-against-node ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (node Term) (shape NodeShape) (visited CycleGuard))
    (@intent
      "Evaluate whether a node conforms to a given shape, returning true if no violations")
    (@spec ((Arena SnarlDataGraph ShapesGraph Term NodeShape CycleGuard) -> Bool))
    (@alloc arena)
    (@example)
    (let ((class-index (build-class-index arena data-graph shapes-graph)))
      (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index node shape visited))
    :c-name
    "snarl_evaluate_shape_against_node")

  (fn evaluate-shape-against-node-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (node Term) (shape NodeShape) (visited CycleGuard))
    (@intent
      "Evaluate whether a node conforms to a given shape using cached class membership")
    (@spec ((Arena SnarlDataGraph ShapesGraph ClassIndex Term NodeShape CycleGuard) -> Bool))
    (@alloc arena)
    (let ((config (default-validator-config))
          (results (evaluate-node-shape-cached arena data-graph shapes-graph class-index shape node visited config)))
      (== (list-len results) 0))
    :c-name
    "snarl_evaluate_shape_against_node_cached")

  (fn property-shape-conforms ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (node Term) (ps PropertyShape))
    (@intent
      "Evaluate whether a node conforms to a property shape used as a member of a logical/sh:node constraint: every value node along the shape's path must satisfy the shape. Vacuously true when the path yields no value nodes (SHACL 4.6.x: a shape with no results conforms).")
    (@spec ((Arena SnarlDataGraph ShapesGraph Term PropertyShape) -> Bool))
    (@alloc arena)
    (@example)
    (let ((class-index (build-class-index arena data-graph shapes-graph)))
      (property-shape-conforms-cached arena data-graph shapes-graph class-index node ps))
    :c-name
    "snarl_property_shape_conforms")

  (fn property-shape-conforms-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (node Term) (ps PropertyShape))
    (@intent
      "Evaluate whether a property shape conforms using cached class membership")
    (@spec ((Arena SnarlDataGraph ShapesGraph ClassIndex Term PropertyShape) -> Bool))
    (@alloc arena)
    ;; True evaluation root: reached ONLY from the standalone public
    ;; property-shape-conforms entry point (a genuine caller-facing API
    ;; boundary) -- a fresh guard here is correct, not a reset-bug. The five
    ;; con-not/con-and/con-or/con-xone/con-node property-shape-map arms call
    ;; property-shape-conforms-with-guard instead: those calls are
    ;; mid-recursion continuations of the SAME evaluation (already several
    ;; frames into engine-validate's descent), not new roots, so they must
    ;; thread the caller's guard the same way the shape-map arm already does.
    (let ((rec-visited (cycle-guard-new arena))
          (empty-siblings (list-new arena Term))
          (results (evaluate-property-shape-cached arena data-graph shapes-graph class-index ps node rec-visited (default-validator-config) empty-siblings)))
      (== (list-len results) 0))
    :c-name
    "snarl_property_shape_conforms_cached")

  (fn property-shape-conforms-with-guard ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (node Term) (ps PropertyShape) (visited CycleGuard))
    (@intent
      "Evaluate whether a property shape conforms, threading the CALLER's cycle guard through instead of minting a fresh one. Used at the five con-not/con-and/con-or/con-xone/con-node property-shape-map sites, which are mid-recursion continuations of an evaluation already in progress -- never a true evaluation root. The caller is responsible for the cycle-guard-has/add/remove dance around this call (matching the shape-map arm's own discipline); this function only threads the guard one level deeper, exactly as evaluate-shape-against-node-cached does for node-shape references.")
    (@spec ((Arena SnarlDataGraph ShapesGraph ClassIndex Term PropertyShape CycleGuard) -> Bool))
    (@alloc arena)
    (let ((empty-siblings (list-new arena Term))
          (results (evaluate-property-shape-cached arena data-graph shapes-graph class-index ps node visited (default-validator-config) empty-siblings)))
      (== (list-len results) 0)))

  (fn engine-validate ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (config ValidatorConfig))
    (@intent
      "Run SHACL validation: evaluate all shapes against their target focus nodes")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ValidatorConfig) -> ValidatorResult))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@example)
    ;; Target and class indexes are per validation run: they cache shape-derived
    ;; access patterns without becoming part of the data graph representation.
    (let ((class-index (build-class-index arena data-graph shapes-graph))
          (target-cache (target-cache-create arena))
          (mut report (make-validation-report arena))
          (mut error-count 0)
          (mut cycle-message (Option String) (none))
          (max-errors (. config max-errors)))
      (for-each (ns (. shapes-graph node-shapes))
        (when (not (. ns deactivated))
          ;; CLEANUP (max-errors precedence, fix-round finding): node-shape
          ;; and focus-node evaluation itself is UNCONDITIONAL -- never
          ;; gated on max-errors. Only report-accumulation below is. An
          ;; engine error (shape recursion) must never be silently missed
          ;; just because an earlier, unrelated node-shape already reported
          ;; enough ordinary violations to hit the cap: max-errors bounds
          ;; how large the SUCCESS report can grow, it must never bound
          ;; which inputs get evaluated for correctness/error purposes. An
          ;; engine error always takes precedence over a truncated report
          ;; (see engine-validate's cycle-message check below, which is
          ;; still reached for every node-shape regardless of error-count).
          ;;
          ;; True evaluation root: one fresh guard per node-shape, shared
          ;; across all of its focus nodes. This is safe (not a global
          ;; cross-focus-node leak) because every recursive descent that
          ;; uses this guard adds its pair before descending and removes
          ;; it after returning — by the time one focus node's evaluation
          ;; finishes, its adds have all been popped back out.
          (let ((focus-nodes (resolve-targets-cached arena data-graph target-cache ns))
                (visited (cycle-guard-new arena)))
            (for-each (focus-node focus-nodes)
              ;; Once this guard has flagged, the run's outcome is already
              ;; decided: the first flag wins (later flags on the same guard
              ;; are no-ops) and an engine error discards `report` wholesale.
              ;; Evaluating the remaining focus nodes cannot change the answer
              ;; and costs a full depth-budget descent EACH -- O(targets x
              ;; depth) arena that is never reclaimed (a 49KB cyclic ring hit
              ;; 18GB before this exit, OOM-killing 7GB CI runners).
              (match (map-get (. visited errors) 0)
                ((some _) (do))
                ((none)
                  (let ((results (evaluate-node-shape-cached arena data-graph shapes-graph class-index ns focus-node visited config)))
                    (for-each (r results)
                      (let ((include (match (. r severity) (severity-violation true) (severity-warning (. config include-warnings)) (severity-info (. config include-infos)))))
                        (when include
                          (when (or (== max-errors 0) (< error-count max-errors))
                            (set! report (report-add-result arena report r))
                            (match (. r severity)
                              (severity-violation
                                (set! error-count (+ error-count 1)))
                              (_ (do)))))))))))
            ;; Any shape-recursion cycle hit while evaluating this
            ;; node-shape overrides the whole run: first cycle found, in
            ;; deterministic traversal order, wins.
            (match cycle-message
              ((none)
                (match (map-get (. visited errors) 0)
                  ((some msg) (set! cycle-message (some msg)))
                  ((none) (do))))
              ((some _) (do))))))
      (match cycle-message
        ((some msg) (union-new ValidatorResult validate-error msg))
        ((none) (union-new ValidatorResult validate-success report))))
    :c-name
    "snarl_engine_validate")

  (fn evaluate-node-shape ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (shape NodeShape) (focus-node Term) (visited CycleGuard) (config ValidatorConfig))
    (@intent "Evaluate a node shape against a single focus node")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph NodeShape Term CycleGuard ValidatorConfig)
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@example)
    (let ((class-index (build-class-index arena data-graph shapes-graph)))
      (evaluate-node-shape-cached arena data-graph shapes-graph class-index shape focus-node visited config))
    :c-name
    "snarl_evaluate_node_shape")

  (fn evaluate-node-shape-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (shape NodeShape) (focus-node Term) (visited CycleGuard) (config ValidatorConfig))
    (@intent "Evaluate a node shape against a single focus node using cached class membership")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ClassIndex NodeShape Term CycleGuard ValidatorConfig)
        ->
        (List ValidationResult)))
    (@alloc arena)
    (let ((mut results (list-new arena ValidationResult))
          (shape-severity (. shape severity))
          (shape-message (. shape message))
          (shape-id (. shape id))
          (no-path (Option ShaclPath) (none)))
      (for-each (constraint (. shape constraints))
        (let ((constraint-results (evaluate-constraint-cached arena data-graph shapes-graph class-index focus-node focus-node constraint no-path shape-id shape-severity shape-message visited)))
          (for-each (r constraint-results) (list-push results r))))
      (for-each (constraint (. shape constraints))
        (match constraint
          ((con-closed true ignored-paths)
            (let ((mut allowed-paths (list-new arena ShaclPath))
                  (ign-len (list-len ignored-paths)))
              (for-each (ps (. shape property-shapes))
                (list-push allowed-paths (. ps path)))
              (let ((mut i 0))
                (while (< i ign-len)
                  (match (list-get ignored-paths i)
                    ((some ip) (list-push allowed-paths ip))
                    ((none) (do)))
                  (set! i (+ i 1))))
              (let ((closed-results (check-closed arena data-graph focus-node allowed-paths no-path shape-id shape-severity shape-message)))
                (for-each (r closed-results) (list-push results r)))))
          (_ (do))))
      (let ((mut all-disjoint-qvs (list-new arena Term))
            (mut all-disjoint-ps-ids (list-new arena Term)))
        (for-each (ps (. shape property-shapes))
          (when (not (. ps deactivated))
            (for-each (c (. ps constraints))
              (match c
                ((con-qualified-value-shape ref _ _ disjoint)
                  (when disjoint
                    (list-push all-disjoint-qvs ref)
                    (list-push all-disjoint-ps-ids (. ps id))))
                (_ (do))))))
        (for-each (ps (. shape property-shapes))
          (when (not (. ps deactivated))
            (let ((mut sibling-refs (list-new arena Term))
                  (ps-id (. ps id))
                  (mut i 0)
                  (n (list-len all-disjoint-qvs)))
              (while (< i n)
                (match (list-get all-disjoint-ps-ids i)
                  ((some pid)
                    (when (not (term-eq pid ps-id))
                      (match (list-get all-disjoint-qvs i)
                        ((some ref) (list-push sibling-refs ref))
                        ((none) (do)))))
                  ((none) (do)))
                (set! i (+ i 1)))
              (let ((ps-results (evaluate-property-shape-cached arena data-graph shapes-graph class-index ps focus-node visited config sibling-refs)))
                (for-each (r ps-results) (list-push results r)))))))
      results)
    :c-name
    "snarl_evaluate_node_shape_cached")

  (fn evaluate-property-shape ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (shape PropertyShape) (focus-node Term) (visited CycleGuard) (config ValidatorConfig) (sibling-qvs-refs (List Term)))
    (@intent
      "Evaluate a property shape against a focus node by resolving the path")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph PropertyShape Term CycleGuard ValidatorConfig (List Term))
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@example)
    (let ((class-index (build-class-index arena data-graph shapes-graph)))
      (evaluate-property-shape-cached arena data-graph shapes-graph class-index shape focus-node visited config sibling-qvs-refs))
    :c-name
    "snarl_evaluate_property_shape")

  (fn evaluate-property-shape-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (shape PropertyShape) (focus-node Term) (visited CycleGuard) (config ValidatorConfig) (sibling-qvs-refs (List Term)))
    (@intent
      "Evaluate a property shape against a focus node by resolving the path using cached class membership")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ClassIndex PropertyShape Term CycleGuard ValidatorConfig (List Term))
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (let ((path (. shape path)))
      (match path
        ((path-predicate pred)
          (evaluate-simple-predicate-property-shape-cached arena data-graph shapes-graph class-index shape focus-node pred visited config sibling-qvs-refs))
        (_
          (let ((mut results (list-new arena ValidationResult))
                (shape-severity (. shape severity))
                (shape-message (. shape message))
                (shape-id (. shape id))
                (path-opt (some path))
                (value-nodes (resolve-path arena data-graph focus-node path))
                (value-count (list-len value-nodes)))
            (for-each (constraint (. shape constraints))
              (let ((constraint-results (evaluate-constraint-for-property-cached arena data-graph shapes-graph class-index focus-node value-nodes value-count constraint path-opt shape-id shape-severity shape-message visited sibling-qvs-refs)))
                (for-each (r constraint-results) (list-push results r))))
            results))))
    :c-name
    "snarl_evaluate_property_shape_cached")

  (fn evaluate-simple-predicate-property-shape-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (shape PropertyShape) (focus-node Term) (pred Term) (visited CycleGuard) (config ValidatorConfig) (sibling-qvs-refs (List Term)))
    (@intent "Evaluate a simple predicate property shape directly against the Snarl data index")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ClassIndex PropertyShape Term Term CycleGuard ValidatorConfig (List Term))
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    ;; Simple predicate paths dominate the benchmark fixtures. They can evaluate
    ;; directly against the object set and only allocate a value list for
    ;; constraints whose existing implementation requires list semantics.
    (let ((mut results (list-new arena ValidationResult))
          (shape-severity (. shape severity))
          (shape-message (. shape message))
          (shape-id (. shape id))
          (path (. shape path))
          (path-opt (some path))
          (value-set (snarl-data-graph-object-set data-graph focus-node pred))
          (value-count (optional-term-set-size value-set)))
      (for-each (constraint (. shape constraints))
        (let ((constraint-results (evaluate-constraint-for-simple-predicate-cached arena data-graph shapes-graph class-index focus-node pred value-set value-count constraint path-opt shape-id shape-severity shape-message visited sibling-qvs-refs)))
          (for-each (r constraint-results) (list-push results r))))
      results))

  (fn evaluate-constraint ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (focus-node Term) (value-node Term) (constraint Constraint) (path (Option ShaclPath)) (shape-id Term) (severity Severity) (message (Option String)) (visited CycleGuard))
    (@intent "Evaluate a single constraint against a focus node and value node")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph Term Term Constraint (Option ShaclPath) Term Severity (Option String) CycleGuard)
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@example)
    (let ((class-index (build-class-index arena data-graph shapes-graph)))
      (evaluate-constraint-cached arena data-graph shapes-graph class-index focus-node value-node constraint path shape-id severity message visited))
    :c-name
    "snarl_evaluate_constraint")

  (fn evaluate-constraint-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (focus-node Term) (value-node Term) (constraint Constraint) (path (Option ShaclPath)) (shape-id Term) (severity Severity) (message (Option String)) (visited CycleGuard))
    (@intent "Evaluate a single constraint against a focus node and value node using cached class membership")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ClassIndex Term Term Constraint (Option ShaclPath) Term Severity (Option String) CycleGuard)
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (let ((mut results (list-new arena ValidationResult)))
      (match constraint
        ((con-class required-class)
          (match (check-class-with-index arena data-graph class-index focus-node value-node required-class path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-datatype required-dt)
          (match (check-datatype arena focus-node value-node required-dt path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-node-kind required-kind)
          (match (check-node-kind arena focus-node value-node required-kind path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-min-count _) (do))
        ((con-max-count _) (do))
        ((con-min-inclusive limit)
          (match (check-min-inclusive arena focus-node value-node limit path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-max-inclusive limit)
          (match (check-max-inclusive arena focus-node value-node limit path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-min-exclusive limit)
          (match (check-min-exclusive arena focus-node value-node limit path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-max-exclusive limit)
          (match (check-max-exclusive arena focus-node value-node limit path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-min-length min-len)
          (match (check-min-length arena focus-node value-node min-len path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-max-length max-len)
          (match (check-max-length arena focus-node value-node max-len path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-pattern pat)
          (match (check-pattern arena focus-node value-node pat path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-language-in allowed-langs)
          (match (check-language-in arena focus-node value-node allowed-langs path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-unique-lang _) (do))
        ((con-equals other-path)
          (let ((single-list (list-new arena Term)))
            (list-push single-list value-node)
            (let ((eq-results (check-equals arena data-graph focus-node single-list other-path path shape-id severity message)))
              (for-each (r eq-results) (list-push results r)))))
        ((con-disjoint other-path)
          (let ((single-list (list-new arena Term)))
            (list-push single-list value-node)
            (let ((dj-results (check-disjoint arena data-graph focus-node single-list other-path path shape-id severity message)))
              (for-each (r dj-results) (list-push results r)))))
        ((con-less-than other-path)
          (let ((single-list (list-new arena Term)))
            (list-push single-list value-node)
            (let ((lt-results (check-less-than arena data-graph focus-node single-list other-path path shape-id severity message)))
              (for-each (r lt-results) (list-push results r)))))
        ((con-less-than-or-equals other-path)
          (let ((single-list (list-new arena Term)))
            (list-push single-list value-node)
            (let ((le-results (check-less-than-or-equals arena data-graph focus-node single-list other-path path shape-id severity message)))
              (for-each (r le-results) (list-push results r)))))
        ((con-has-value required-value)
          (let ((single-list (list-new arena Term)))
            (list-push single-list value-node)
            (match (check-has-value arena focus-node single-list required-value path shape-id severity message)
              ((some r) (list-push results r))
              ((none) (do)))))
        ((con-in allowed-values)
          (match (check-in arena focus-node value-node allowed-values path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-closed _ _) (do))
        ((con-not shape-ref)
          ;; Reset-bug site (fixed) -- BOTH arms now thread the caller's
          ;; guard: a repeat (shape-ref, value-node) pair on the current path
          ;; used to be masked by a fresh rec-visited in the property-shape-map
          ;; arm (FB1). conforms=true on a cut-short cycle is deliberately
          ;; fail-closed: it makes check-not report a violation rather than
          ;; silently passing sh:not.
          (let ((conforms
                  (match (map-get (. shapes-graph property-shape-map) shape-ref)
                    ((some ref-ps)
                      (if (cycle-guard-has visited shape-ref value-node)
                        (do
                          (cycle-guard-flag arena visited shape-ref value-node)
                          true)
                        (do
                          (cycle-guard-add arena visited shape-ref value-node)
                          (let ((r (property-shape-conforms-with-guard arena data-graph shapes-graph class-index value-node ref-ps visited)))
                            (cycle-guard-remove arena visited shape-ref value-node)
                            r))))
                    ((none)
                      (match (map-get (. shapes-graph shape-map) shape-ref)
                        ((some ref-shape)
                          (if (cycle-guard-has visited shape-ref value-node)
                            (do
                              (cycle-guard-flag arena visited shape-ref value-node)
                              true)
                            (do
                              (cycle-guard-add arena visited shape-ref value-node)
                              (let ((r (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index value-node ref-shape visited)))
                                (cycle-guard-remove arena visited shape-ref value-node)
                                r))))
                        ((none) false))))))
            (match (check-not arena focus-node conforms path shape-id severity message)
              ((some r) (list-push results r))
              ((none) (do)))))
        ((con-and shape-refs)
          ;; Reset-bug site (fixed) -- BOTH arms now thread the caller's
          ;; guard. Cut-short => all-pass=false (fail-closed: check-and
          ;; reports a violation rather than silently passing).
          (let ((mut all-pass true))
            (for-each (ref shape-refs)
              (match (map-get (. shapes-graph property-shape-map) ref)
                ((some ref-ps)
                  (if (cycle-guard-has visited ref value-node)
                    (do
                      (cycle-guard-flag arena visited ref value-node)
                      (set! all-pass false))
                    (do
                      (cycle-guard-add arena visited ref value-node)
                      (let ((ok (property-shape-conforms-with-guard arena data-graph shapes-graph class-index value-node ref-ps visited)))
                        (cycle-guard-remove arena visited ref value-node)
                        (when (not ok) (set! all-pass false))))))
                ((none)
                  (match (map-get (. shapes-graph shape-map) ref)
                    ((some ref-shape)
                      (if (cycle-guard-has visited ref value-node)
                        (do
                          (cycle-guard-flag arena visited ref value-node)
                          (set! all-pass false))
                        (do
                          (cycle-guard-add arena visited ref value-node)
                          (let ((ok (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index value-node ref-shape visited)))
                            (cycle-guard-remove arena visited ref value-node)
                            (when (not ok) (set! all-pass false))))))
                    ((none) (do))))))
            (match (check-and arena focus-node all-pass path shape-id severity message)
              ((some r) (list-push results r))
              ((none) (do)))))
        ((con-or shape-refs)
          ;; Reset-bug site (fixed) -- BOTH arms now thread the caller's
          ;; guard. Cut-short contributes nothing toward any-pass
          ;; (fail-closed: does not spuriously satisfy sh:or).
          (let ((mut any-pass false))
            (for-each (ref shape-refs)
              (match (map-get (. shapes-graph property-shape-map) ref)
                ((some ref-ps)
                  (if (cycle-guard-has visited ref value-node)
                    (cycle-guard-flag arena visited ref value-node)
                    (do
                      (cycle-guard-add arena visited ref value-node)
                      (let ((ok (property-shape-conforms-with-guard arena data-graph shapes-graph class-index value-node ref-ps visited)))
                        (cycle-guard-remove arena visited ref value-node)
                        (when ok (set! any-pass true))))))
                ((none)
                  (match (map-get (. shapes-graph shape-map) ref)
                    ((some ref-shape)
                      (if (cycle-guard-has visited ref value-node)
                        (cycle-guard-flag arena visited ref value-node)
                        (do
                          (cycle-guard-add arena visited ref value-node)
                          (let ((ok (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index value-node ref-shape visited)))
                            (cycle-guard-remove arena visited ref value-node)
                            (when ok (set! any-pass true))))))
                    ((none) (do))))))
            (match (check-or arena focus-node any-pass path shape-id severity message)
              ((some r) (list-push results r))
              ((none) (do)))))
        ((con-xone shape-refs)
          ;; Reset-bug site (fixed) -- BOTH arms now thread the caller's
          ;; guard. Cut-short does not increment pass-count (fail-closed:
          ;; never lets a cycle spuriously produce the "exactly one" pass
          ;; that would satisfy sh:xone).
          (let ((mut pass-count 0))
            (for-each (ref shape-refs)
              (match (map-get (. shapes-graph property-shape-map) ref)
                ((some ref-ps)
                  (if (cycle-guard-has visited ref value-node)
                    (cycle-guard-flag arena visited ref value-node)
                    (do
                      (cycle-guard-add arena visited ref value-node)
                      (let ((ok (property-shape-conforms-with-guard arena data-graph shapes-graph class-index value-node ref-ps visited)))
                        (cycle-guard-remove arena visited ref value-node)
                        (when ok (set! pass-count (+ pass-count 1)))))))
                ((none)
                  (match (map-get (. shapes-graph shape-map) ref)
                    ((some ref-shape)
                      (if (cycle-guard-has visited ref value-node)
                        (cycle-guard-flag arena visited ref value-node)
                        (do
                          (cycle-guard-add arena visited ref value-node)
                          (let ((ok (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index value-node ref-shape visited)))
                            (cycle-guard-remove arena visited ref value-node)
                            (when ok (set! pass-count (+ pass-count 1)))))))
                    ((none) (do))))))
            (match (check-xone arena focus-node pass-count path shape-id severity message)
              ((some r) (list-push results r))
              ((none) (do)))))
        ((con-node shape-ref)
          ;; Reset-bug site (fixed) -- BOTH arms now thread the caller's
          ;; guard. This is the self-loop pattern: a shape with a property
          ;; shape whose sh:node points back at itself, evaluated over data
          ;; with a matching cycle. value-conforms=false on cut-short is
          ;; fail-closed (check-node reports a violation rather than
          ;; silently passing sh:node).
          (let ((value-conforms
                  (match (map-get (. shapes-graph property-shape-map) shape-ref)
                    ((some ref-ps)
                      (if (cycle-guard-has visited shape-ref value-node)
                        (do
                          (cycle-guard-flag arena visited shape-ref value-node)
                          false)
                        (do
                          (cycle-guard-add arena visited shape-ref value-node)
                          (let ((ok (property-shape-conforms-with-guard arena data-graph shapes-graph class-index value-node ref-ps visited)))
                            (cycle-guard-remove arena visited shape-ref value-node)
                            ok))))
                    ((none)
                      (match (map-get (. shapes-graph shape-map) shape-ref)
                        ((some ref-shape)
                          (if (cycle-guard-has visited shape-ref value-node)
                            (do
                              (cycle-guard-flag arena visited shape-ref value-node)
                              false)
                            (do
                              (cycle-guard-add arena visited shape-ref value-node)
                              (let ((ok (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index value-node ref-shape visited)))
                                (cycle-guard-remove arena visited shape-ref value-node)
                                ok))))
                        ((none) true))))))
            (match (check-node arena focus-node value-node value-conforms path shape-id severity message)
              ((some r) (list-push results r))
              ((none) (do)))))
        ((con-property _) (do))
        ((con-qualified-value-shape _ _ _ _) (do)))
      results)
    :c-name
    "snarl_evaluate_constraint_cached")

  (fn evaluate-constraint-for-property ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (focus-node Term) (value-nodes (List Term)) (value-count Int) (constraint Constraint) (path (Option ShaclPath)) (shape-id Term) (severity Severity) (message (Option String)) (visited CycleGuard) (sibling-qvs-refs (List Term)))
    (@intent
      "Evaluate a constraint in property shape context with access to all value nodes")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph Term (List Term) Int Constraint (Option ShaclPath) Term Severity (Option String) CycleGuard (List Term))
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@example)
    (let ((class-index (build-class-index arena data-graph shapes-graph)))
      (evaluate-constraint-for-property-cached arena data-graph shapes-graph class-index focus-node value-nodes value-count constraint path shape-id severity message visited sibling-qvs-refs))
    :c-name
    "snarl_evaluate_constraint_for_property")

  (fn evaluate-constraint-for-property-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (focus-node Term) (value-nodes (List Term)) (value-count Int) (constraint Constraint) (path (Option ShaclPath)) (shape-id Term) (severity Severity) (message (Option String)) (visited CycleGuard) (sibling-qvs-refs (List Term)))
    (@intent
      "Evaluate a constraint in property shape context with access to all value nodes using cached class membership")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ClassIndex Term (List Term) Int Constraint (Option ShaclPath) Term Severity (Option String) CycleGuard (List Term))
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (@pre (>= value-count 0))
    (let ((mut results (list-new arena ValidationResult)))
      (match constraint
        ((con-min-count min-c)
          (match (check-min-count arena focus-node value-count min-c path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-max-count max-c)
          (match (check-max-count arena focus-node value-count max-c path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-unique-lang b)
          (when b
            (let ((ul-results (check-unique-lang arena focus-node value-nodes path shape-id severity message)))
              (for-each (r ul-results) (list-push results r)))))
        ((con-has-value required-value)
          (match (check-has-value arena focus-node value-nodes required-value path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-closed _ _) (do))
        ((con-equals other-path)
          (let ((eq-results (check-equals arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r eq-results) (list-push results r))))
        ((con-disjoint other-path)
          (let ((dj-results (check-disjoint arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r dj-results) (list-push results r))))
        ((con-less-than other-path)
          (let ((lt-results (check-less-than arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r lt-results) (list-push results r))))
        ((con-less-than-or-equals other-path)
          (let ((le-results (check-less-than-or-equals arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r le-results) (list-push results r))))
        ((con-qualified-value-shape shape-ref q-min q-max disjoint)
          ;; Reset-bug site (fixed) — two independent resets (main ref and
          ;; disjoint-sibling ref) both threaded through the caller's guard
          ;; now. A cut-short vn is treated as not-conforming (fail-closed:
          ;; fewer conforming values, never a spurious minCount pass); a
          ;; cut-short sibling check is treated as not-conforming-to-sibling
          ;; (fail-closed for the disjoint check specifically — see report).
          (let ((mut conforming-count 0))
            (for-each (vn value-nodes)
              (match (map-get (. shapes-graph shape-map) shape-ref)
                ((some ref-shape)
                  (let ((vn-conforms
                          (if (cycle-guard-has visited shape-ref vn)
                            (do (cycle-guard-flag arena visited shape-ref vn) false)
                            (do
                              (cycle-guard-add arena visited shape-ref vn)
                              (let ((ok (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index vn ref-shape visited)))
                                (cycle-guard-remove arena visited shape-ref vn)
                                ok)))))
                    (when vn-conforms
                      (if (and disjoint (> (list-len sibling-qvs-refs) 0))
                        (let ((mut conforms-to-sibling false))
                          (for-each (sib-ref sibling-qvs-refs)
                            (match (map-get (. shapes-graph shape-map) sib-ref)
                              ((some sib-shape)
                                (let ((sib-ok
                                        (if (cycle-guard-has visited sib-ref vn)
                                          (do (cycle-guard-flag arena visited sib-ref vn) false)
                                          (do
                                            (cycle-guard-add arena visited sib-ref vn)
                                            (let ((ok (evaluate-shape-against-node-cached arena data-graph shapes-graph class-index vn sib-shape visited)))
                                              (cycle-guard-remove arena visited sib-ref vn)
                                              ok)))))
                                  (when sib-ok (set! conforms-to-sibling true))))
                              ((none) (do))))
                          (when (not conforms-to-sibling)
                            (set! conforming-count (+ conforming-count 1))))
                        (set! conforming-count (+ conforming-count 1))))))
                ((none) (do))))
            (let ((qvs-results (check-qualified-value-shape arena focus-node conforming-count q-min q-max path shape-id severity message)))
              (for-each (r qvs-results) (list-push results r)))))
        ((con-property ps-ref)
          ;; Reset-bug site (fixed). Cut-short contributes zero results for
          ;; that value node — safe because con-property is only reached via
          ;; the engine-validate root, whose final report is discarded and
          ;; replaced by ValidatorResult::Error whenever the guard flags a
          ;; cycle (see engine-validate).
          (match (map-get (. shapes-graph property-shape-map) ps-ref)
            ((some ref-ps)
              (for-each (vn value-nodes)
                (let ((empty-siblings (list-new arena Term)))
                  (if (cycle-guard-has visited ps-ref vn)
                    (cycle-guard-flag arena visited ps-ref vn)
                    (do
                      (cycle-guard-add arena visited ps-ref vn)
                      (let ((ps-results (evaluate-property-shape-cached arena data-graph shapes-graph class-index ref-ps vn visited (default-validator-config) empty-siblings)))
                        (cycle-guard-remove arena visited ps-ref vn)
                        (for-each (r ps-results) (list-push results r))))))))
            ((none) (do))))
        (_
          (for-each (value-node value-nodes)
            (let ((vr (evaluate-constraint-cached arena data-graph shapes-graph class-index focus-node value-node constraint path shape-id severity message visited)))
              (for-each (r vr) (list-push results r))))))
      results)
    :c-name
    "snarl_evaluate_constraint_for_property_cached")

  (fn evaluate-constraint-for-simple-predicate-cached ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph) (class-index ClassIndex) (focus-node Term) (pred Term) (value-set (Option TermSet)) (value-count Int) (constraint Constraint) (path (Option ShaclPath)) (shape-id Term) (severity Severity) (message (Option String)) (visited CycleGuard) (sibling-qvs-refs (List Term)))
    (@intent "Evaluate a property-shape constraint against a simple predicate object set")
    (@spec
      ((Arena SnarlDataGraph ShapesGraph ClassIndex Term Term (Option TermSet) Int Constraint (Option ShaclPath) Term Severity (Option String) CycleGuard (List Term))
        ->
        (List ValidationResult)))
    (@alloc arena)
    (@pre (>= value-count 0))
    (@post (>= (list-len $result) 0))
    (let ((mut results (list-new arena ValidationResult)))
      (match constraint
        ((con-min-count min-c)
          (match (check-min-count arena focus-node value-count min-c path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-max-count max-c)
          (match (check-max-count arena focus-node value-count max-c path shape-id severity message)
            ((some r) (list-push results r))
            ((none) (do))))
        ((con-has-value required-value)
          (when (not (snarl-data-graph-has-object data-graph focus-node pred required-value))
            (list-push results
              (record-new ValidationResult
                (focus-node focus-node)
                (result-path path)
                (value (none))
                (source-shape shape-id)
                (source-constraint-component SHACL_HAS_VALUE)
                (severity severity)
                (message message)))))
        ((con-closed _ _) (do))
        ((con-equals other-path)
          ;; Pair constraints compare complete value sets, so they deliberately
          ;; use the legacy list-based implementation after lazy materialization.
          (let ((value-nodes (optional-term-set-to-list arena value-set))
                (eq-results (check-equals arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r eq-results) (list-push results r))))
        ((con-disjoint other-path)
          (let ((value-nodes (optional-term-set-to-list arena value-set))
                (dj-results (check-disjoint arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r dj-results) (list-push results r))))
        ((con-less-than other-path)
          (let ((value-nodes (optional-term-set-to-list arena value-set))
                (lt-results (check-less-than arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r lt-results) (list-push results r))))
        ((con-less-than-or-equals other-path)
          (let ((value-nodes (optional-term-set-to-list arena value-set))
                (le-results (check-less-than-or-equals arena data-graph focus-node value-nodes other-path path shape-id severity message)))
            (for-each (r le-results) (list-push results r))))
        ((con-unique-lang b)
          (when b
            (let ((value-nodes (optional-term-set-to-list arena value-set))
                  (ul-results (check-unique-lang arena focus-node value-nodes path shape-id severity message)))
              (for-each (r ul-results) (list-push results r)))))
        ((con-qualified-value-shape _ _ _ _)
          (let ((value-nodes (optional-term-set-to-list arena value-set))
                (qvs-results (evaluate-constraint-for-property-cached arena data-graph shapes-graph class-index focus-node value-nodes value-count constraint path shape-id severity message visited sibling-qvs-refs)))
            (for-each (r qvs-results) (list-push results r))))
        ((con-property _)
          (let ((value-nodes (optional-term-set-to-list arena value-set))
                (property-results (evaluate-constraint-for-property-cached arena data-graph shapes-graph class-index focus-node value-nodes value-count constraint path shape-id severity message visited sibling-qvs-refs)))
            (for-each (r property-results) (list-push results r))))
        (_
          (match value-set
            ((some terms)
              (for-each (value-node terms)
                (let ((vr (evaluate-constraint-cached arena data-graph shapes-graph class-index focus-node value-node constraint path shape-id severity message visited)))
                  (for-each (r vr) (list-push results r)))))
            ((none) (do)))))
      results))
)
