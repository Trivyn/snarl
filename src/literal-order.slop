(module literal-order
  (@doc "Lexical validity and ordering of literals, as the SHACL value-range, pair and datatype constraints need them (SPARQL operator semantics)")

  ;; Interim home, like af-vocab: slop-rdf's xsd module orders only
  ;; xsd:integer, decimal, float, double and boolean, so every xsd:dateTime,
  ;; xsd:date, xsd:int, xsd:long ... value was incomparable there, and failed
  ;; every sh:minInclusive and its siblings. This module adds the derived
  ;; integer types, dateTime and date, and string ordering, and falls back to
  ;; xsd-compare for the rest. It belongs in slop-rdf's xsd module.

  (import rdf (Term Literal make-literal make-iri))
  (import strlib (parse-int parse-float char-at compare))
  (import vocab
    (XSD_STRING XSD_INTEGER XSD_DECIMAL XSD_FLOAT XSD_DOUBLE XSD_LONG XSD_INT XSD_SHORT XSD_BYTE
     XSD_UNSIGNED_LONG XSD_UNSIGNED_INT XSD_UNSIGNED_SHORT XSD_UNSIGNED_BYTE
     XSD_NON_NEGATIVE_INTEGER XSD_POSITIVE_INTEGER XSD_NEGATIVE_INTEGER XSD_NON_POSITIVE_INTEGER
     XSD_DATE_TIME XSD_DATE_TIME_STAMP XSD_DATE))
  (import xsd (XsdCompareResult xsd-validate-lexical xsd-compare))
  (export
    lexical-form-is-valid
    literal-compare)

  (const XSD_INT_T String "http://www.w3.org/2001/XMLSchema#integer")
  (const XSD_DATE_TIME_T String "http://www.w3.org/2001/XMLSchema#dateTime")
  (const XSD_DATE_T String "http://www.w3.org/2001/XMLSchema#date")

  ;; A point on the timeline: seconds from 1970-01-01T00:00:00 (in UTC if
  ;; zoned, in unknown local time if not) and the fraction of a second.
  (type Instant (record
    (valid Bool)
    (seconds Int)
    (fraction Float)
    (zoned Bool)))

  (fn datatype-is-integer ((dt String))
    (@intent "True for xsd:integer and the types derived from it")
    (@spec ((String) -> Bool))
    (@pure)
    (or
      (string-eq dt XSD_INTEGER) (string-eq dt XSD_LONG) (string-eq dt XSD_INT)
      (string-eq dt XSD_SHORT) (string-eq dt XSD_BYTE)
      (string-eq dt XSD_UNSIGNED_LONG) (string-eq dt XSD_UNSIGNED_INT)
      (string-eq dt XSD_UNSIGNED_SHORT) (string-eq dt XSD_UNSIGNED_BYTE)
      (string-eq dt XSD_NON_NEGATIVE_INTEGER) (string-eq dt XSD_POSITIVE_INTEGER)
      (string-eq dt XSD_NEGATIVE_INTEGER) (string-eq dt XSD_NON_POSITIVE_INTEGER)))

  (fn datatype-is-numeric ((dt String))
    (@intent "True for the XSD numeric types, which SPARQL compares with each other by value")
    (@spec ((String) -> Bool))
    (@pure)
    (or
      (datatype-is-integer dt)
      (string-eq dt XSD_DECIMAL) (string-eq dt XSD_FLOAT) (string-eq dt XSD_DOUBLE)))

  (fn datatype-is-date-time ((dt String))
    (@intent "True for xsd:dateTime and xsd:dateTimeStamp")
    (@spec ((String) -> Bool))
    (@pure)
    (or (string-eq dt XSD_DATE_TIME) (string-eq dt XSD_DATE_TIME_STAMP)))

  (fn two-digits ((s String) (i Int))
    (@intent "The two-digit number at byte i of s, or -1 if those two bytes are not both digits")
    (@spec ((String Int) -> Int))
    (@pure)
    (@pre (>= i 0))
    (@post (and (>= $result -1) (<= $result 99)))
    (let ((a (char-at s i))
          (b (char-at s (+ i 1))))
      (if (and (>= a 48) (<= a 57) (>= b 48) (<= b 57))
        (+ (* (- a 48) 10) (- b 48))
        -1)))

  (fn days-in-month ((year Int) (month Int))
    (@intent "Days in a month of the proleptic Gregorian calendar")
    (@spec ((Int Int) -> Int))
    (@pure)
    (@post (and (>= $result 28) (<= $result 31)))
    (@example (2024 2) -> 29)
    (@example (2023 2) -> 28)
    (@example (1900 2) -> 28)
    (@example (2000 2) -> 29)
    (@example (2023 4) -> 30)
    (cond
      ((== month 2)
        (if (and (== (% year 4) 0) (or (!= (% year 100) 0) (== (% year 400) 0))) 29 28))
      ((or (== month 4) (== month 6) (== month 9) (== month 11)) 30)
      (else 31)))

  (fn days-from-civil ((year Int) (month Int) (day Int))
    (@intent "Days from 1970-01-01 to a proleptic Gregorian date")
    (@spec ((Int Int Int) -> Int))
    (@pure)
    (@pre (and (>= month 1) (<= month 12)))
    (@example (1970 1 1) -> 0)
    (@example (1970 1 2) -> 1)
    (@example (2000 3 1) -> 11017)
    (@example (1969 12 31) -> -1)
    (let ((y (if (<= month 2) (- year 1) year)))
      (let ((era (/ (if (>= y 0) y (- y 399)) 400)))
        (let ((yoe (- y (* era 400)))
              (mp (if (> month 2) (- month 3) (+ month 9))))
          (let ((doy (+ (/ (+ (* 153 mp) 2) 5) (- day 1))))
            (+ (- (+ (* era 146097) (+ (- (+ (* yoe 365) (/ yoe 4)) (/ yoe 100)) doy)) 719468) 0))))))

  (fn invalid-instant ()
    (@intent "The result of parsing an ill-formed date or dateTime")
    (@spec (() -> Instant))
    (@pure)
    (@post (not (. $result valid)))
    (record-new Instant (valid false) (seconds 0) (fraction 0.0) (zoned false)))

  (fn parse-instant ((s String) (with-time Bool))
    (@intent "Parse the lexical form of an xsd:dateTime (with-time) or xsd:date: -?YYYY-MM-DD, then for a dateTime Thh:mm:ss(.s+)?, then an optional Z or (+|-)hh:mm. An xsd:date is the instant its day starts. Invalid if any part is missing, malformed or out of range.")
    (@spec ((String Bool) -> Instant))
    (@pure)
    (let ((len (string-len s))
          (negative (== (char-at s 0) 45))
          (mut i 0)
          (mut year 0)
          (mut year-digits 0)
          (mut fraction 0.0)
          (mut scale 0.1)
          (mut hour 0)
          (mut minute 0)
          (mut second 0)
          (mut zoned false)
          (mut offset 0)
          (mut ok true))
      (when negative (set! i 1))
      (while (and (>= (char-at s i) 48) (<= (char-at s i) 57) (< year-digits 9))
        (set! year (+ (* year 10) (- (char-at s i) 48)))
        (set! year-digits (+ year-digits 1))
        (set! i (+ i 1)))
      (when negative (set! year (- 0 year)))
      (let ((month (two-digits s (+ i 1)))
            (day (two-digits s (+ i 4))))
        (when (or
                (< year-digits 4)
                (!= (char-at s i) 45)
                (!= (char-at s (+ i 3)) 45)
                (< month 1) (> month 12)
                (< day 1))
          (set! ok false))
        (when ok
          (when (> day (days-in-month year month)) (set! ok false)))
        (set! i (+ i 6))
        (when (and ok with-time)
          (set! hour (two-digits s (+ i 1)))
          (set! minute (two-digits s (+ i 4)))
          (set! second (two-digits s (+ i 7)))
          (when (or
                  (!= (char-at s i) 84)
                  (!= (char-at s (+ i 3)) 58)
                  (!= (char-at s (+ i 6)) 58)
                  (< hour 0) (> hour 24)
                  (< minute 0) (> minute 59)
                  (< second 0) (> second 59))
            (set! ok false))
          (set! i (+ i 9))
          (when (and ok (== (char-at s i) 46))
            (set! i (+ i 1))
            (when (or (< (char-at s i) 48) (> (char-at s i) 57)) (set! ok false))
            (while (and (>= (char-at s i) 48) (<= (char-at s i) 57))
              (set! fraction (+ fraction (* scale (cast Float (- (char-at s i) 48)))))
              (set! scale (/ scale 10.0))
              (set! i (+ i 1))))
          ;; 24:00:00 is the only hour-24 time
          (when (and (== hour 24) (or (!= minute 0) (!= second 0) (> fraction 0.0)))
            (set! ok false)))
        (when (and ok (< i len))
          (let ((c (char-at s i)))
            (cond
              ((== c 90)
                (set! zoned true)
                (set! i (+ i 1)))
              ((or (== c 43) (== c 45))
                (let ((oh (two-digits s (+ i 1)))
                      (om (two-digits s (+ i 4))))
                  (when (or
                          (!= (char-at s (+ i 3)) 58)
                          (< oh 0) (> oh 14)
                          (< om 0) (> om 59)
                          (and (== oh 14) (!= om 0)))
                    (set! ok false))
                  (set! zoned true)
                  (set! offset (* (+ (* oh 3600) (* om 60)) (if (== c 45) -1 1)))
                  (set! i (+ i 6))))
              (else (set! ok false)))))
        (when (!= i len) (set! ok false))
        (if ok
          (record-new Instant
            (valid true)
            (seconds (- (+ (* (days-from-civil year month day) 86400)
                           (+ (* hour 3600) (+ (* minute 60) second)))
                        offset))
            (fraction fraction)
            (zoned zoned))
          (invalid-instant)))))

  (fn lexical-form-is-valid ((lexical String) (datatype-iri String))
    (@intent "False if the lexical form is known to be ill-formed for the datatype: the XSD numeric and boolean types (slop-rdf's xsd-validate-lexical), xsd:dateTime, xsd:dateTimeStamp and xsd:date. True for every datatype this cannot check.")
    (@spec ((String String) -> Bool))
    (@pure)
    (@example ("42" XSD_INT_T) -> true)
    (@example ("aldi" XSD_INT_T) -> false)
    (@example ("2002-10-10T12:00:00-05:00" XSD_DATE_TIME_T) -> true)
    (@example ("2002-10-10T12:00:00" XSD_DATE_TIME_T) -> true)
    (@example ("2002-10-10" XSD_DATE_TIME_T) -> false)
    (@example ("2002-02-30" XSD_DATE_T) -> false)
    (@example ("2002-10-10Z" XSD_DATE_T) -> true)
    (cond
      ((string-eq datatype-iri XSD_DATE_TIME) (. (parse-instant lexical true) valid))
      ((string-eq datatype-iri XSD_DATE_TIME_STAMP)
        (let ((t (parse-instant lexical true)))
          (and (. t valid) (. t zoned))))
      ((string-eq datatype-iri XSD_DATE) (. (parse-instant lexical false) valid))
      (else (xsd-validate-lexical lexical datatype-iri))))

  (fn order-ints ((a Int) (b Int))
    (@intent "Order two integers")
    (@spec ((Int Int) -> XsdCompareResult))
    (@pure)
    (if (< a b) 'xsd-compare-less (if (> a b) 'xsd-compare-greater 'xsd-compare-equal)))

  (fn order-floats ((a Float) (b Float))
    (@intent "Order two floats; a NaN on either side is incomparable")
    (@spec ((Float Float) -> XsdCompareResult))
    (@pure)
    (cond
      ((< a b) 'xsd-compare-less)
      ((> a b) 'xsd-compare-greater)
      ((== a b) 'xsd-compare-equal)
      (else 'xsd-compare-incomparable)))

  (fn order-instants ((a Instant) (b Instant))
    (@intent "Order two instants as XSD does (XML Schema Datatypes 3.2.7.4). Two zoned or two unzoned instants compare directly. An unzoned instant may be up to 14 hours either side of the same reading in UTC, so it compares with a zoned one only when they are further apart than that; otherwise the pair is incomparable.")
    (@spec ((Instant Instant) -> XsdCompareResult))
    (@pure)
    (cond
      ((or (not (. a valid)) (not (. b valid))) 'xsd-compare-incomparable)
      ((== (. a zoned) (. b zoned))
        (if (== (. a seconds) (. b seconds))
          (order-floats (. a fraction) (. b fraction))
          (order-ints (. a seconds) (. b seconds))))
      ((< (+ (. a seconds) 50400) (. b seconds)) 'xsd-compare-less)
      ((> (- (. a seconds) 50400) (. b seconds)) 'xsd-compare-greater)
      ;; within 14 hours either way: exactly 14 hours apart is still
      ;; indeterminate unless the fractions settle it, which they cannot
      (else 'xsd-compare-incomparable)))

  (fn order-numerics ((lex-a String) (dt-a String) (lex-b String) (dt-b String))
    (@intent "Order two well-formed numeric literals by value: as integers when both are of integer types, as floats otherwise")
    (@spec ((String String String String) -> XsdCompareResult))
    (@pure)
    (if (and (datatype-is-integer dt-a) (datatype-is-integer dt-b))
      (match (parse-int lex-a)
        ((ok a)
          (match (parse-int lex-b)
            ((ok b) (order-ints a b))
            ((error _) 'xsd-compare-incomparable)))
        ((error _) 'xsd-compare-incomparable))
      (match (parse-float lex-a)
        ((ok a)
          (match (parse-float lex-b)
            ((ok b) (order-floats a b))
            ((error _) 'xsd-compare-incomparable)))
        ((error _) 'xsd-compare-incomparable))))

  (fn literal-datatype ((lit Literal))
    (@intent "A literal's datatype IRI: xsd:string when none is given, and the empty string for a language-tagged literal, which orders with nothing")
    (@spec ((Literal) -> String))
    (@pure)
    (match (. lit lang)
      ((some _) "")
      ((none)
        (match (. lit datatype)
          ((some d) d)
          ((none) XSD_STRING)))))

  (fn literal-compare ((arena Arena) (a Term) (b Term))
    (@intent "Order two terms as the SPARQL < operator does (SHACL 4.5 and 4.6.3): numeric literals of any numeric types by value, xsd:dateTime and xsd:date literals on the timeline, xsd:string literals by code point, and everything else as slop-rdf's xsd-compare does. Non-literals, ill-formed literals, language-tagged literals and literals of unrelated types are incomparable.")
    (@spec ((Arena Term Term) -> XsdCompareResult))
    (@alloc arena)
    (@example (arena (make-literal arena "5" (some "http://www.w3.org/2001/XMLSchema#int") (none)) (make-literal arena "3" (some "http://www.w3.org/2001/XMLSchema#integer") (none))) -> 'xsd-compare-greater)
    (@example (arena (make-literal arena "2002-10-10T12:00:00Z" (some "http://www.w3.org/2001/XMLSchema#dateTime") (none)) (make-literal arena "2002-10-10T07:00:00-05:00" (some "http://www.w3.org/2001/XMLSchema#dateTime") (none))) -> 'xsd-compare-equal)
    (@example (arena (make-literal arena "2002-10-10T12:00:00" (some "http://www.w3.org/2001/XMLSchema#dateTime") (none)) (make-literal arena "2002-10-10T12:00:00Z" (some "http://www.w3.org/2001/XMLSchema#dateTime") (none))) -> 'xsd-compare-incomparable)
    (@example (arena (make-literal arena "a" (none) (none)) (make-literal arena "b" (none) (none))) -> 'xsd-compare-less)
    (@example (arena (make-iri arena "http://example.org/a") (make-literal arena "b" (none) (none))) -> 'xsd-compare-incomparable)
    (match a
      ((term-literal lit-a)
        (match b
          ((term-literal lit-b)
            (let ((dt-a (literal-datatype lit-a))
                  (dt-b (literal-datatype lit-b))
                  (lex-a (. lit-a value))
                  (lex-b (. lit-b value)))
              (cond
                ((or (== (string-len dt-a) 0) (== (string-len dt-b) 0)) 'xsd-compare-incomparable)
                ((and (datatype-is-numeric dt-a) (datatype-is-numeric dt-b))
                  (if (and (lexical-form-is-valid lex-a dt-a) (lexical-form-is-valid lex-b dt-b))
                    (order-numerics lex-a dt-a lex-b dt-b)
                    'xsd-compare-incomparable))
                ((and (datatype-is-date-time dt-a) (datatype-is-date-time dt-b))
                  (order-instants (parse-instant lex-a true) (parse-instant lex-b true)))
                ((and (string-eq dt-a XSD_DATE) (string-eq dt-b XSD_DATE))
                  (order-instants (parse-instant lex-a false) (parse-instant lex-b false)))
                ((and (string-eq dt-a XSD_STRING) (string-eq dt-b XSD_STRING))
                  (order-ints (compare lex-a lex-b) 0))
                (else (xsd-compare arena a b)))))
          (_ 'xsd-compare-incomparable)))
      (_ 'xsd-compare-incomparable))
    :c-name "snarl_literal_compare"))
