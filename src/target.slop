(module target
  (import rdf
    (Term Triple term-eq term-kind make-iri make-triple triple-subject triple-predicate triple-object))
  (import data-graph
    (SnarlDataGraph snarl-data-graph-subjects snarl-data-graph-subjects-of snarl-data-graph-objects-of snarl-data-graph-size snarl-data-graph-create snarl-data-graph-add snarl-data-graph-contains))
  (import vocab (RDF_TYPE RDFS_SUBCLASS_OF))
  (import types (NodeShape PropertyShape ShaclPath Severity Constraint ShapesGraph))
  (export
    ClassInstances
    ClassIndex
    build-class-index
    class-index-has-class
    class-index-has-instance
    resolve-targets
    resolve-target-node
    resolve-target-class
    resolve-target-subjects-of
    resolve-target-objects-of
    resolve-implicit-class-targets
    is-shacl-instance-of-class)

  (@doc "SHACL target resolution: determines focus nodes for each shape")

  (const EX_ALICE String "http://example.org/alice")

  (const EX_BOB String "http://example.org/bob")

  (const EX_PERSON String "http://example.org/Person")

  (const EX_SHAPE String "http://example.org/Shape1")

  (const EX_NAME String "http://example.org/name")

  (const EX_KNOWS String "http://example.org/knows")

  (type ClassInstances (record
    (class-term Term)
    (instances (Set Term))))

  (type ClassIndex (record
    (entries (List ClassInstances))))

  (fn fixture-g-typed ((arena Arena))
    (@intent "Graph with (alice rdf:type Person), (bob rdf:type Person)")
    (@spec ((Arena) -> SnarlDataGraph))
    (let ((mut g (snarl-data-graph-create arena)))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_ALICE)
            (make-iri arena RDF_TYPE)
            (make-iri arena EX_PERSON))))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_BOB)
            (make-iri arena RDF_TYPE)
            (make-iri arena EX_PERSON))))
      g))

  (fn fixture-g-alice-name ((arena Arena))
    (@intent "Graph with (alice name 'Alice')")
    (@spec ((Arena) -> SnarlDataGraph))
    (let ((mut g (snarl-data-graph-create arena)))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_ALICE)
            (make-iri arena EX_NAME)
            (make-iri arena "http://example.org/AliceName"))))
      g))

  (fn fixture-g-alice-knows-bob ((arena Arena))
    (@intent "Graph with (alice knows bob)")
    (@spec ((Arena) -> SnarlDataGraph))
    (let ((mut g (snarl-data-graph-create arena)))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_ALICE)
            (make-iri arena EX_KNOWS)
            (make-iri arena EX_BOB))))
      g))

  (fn fixture-target-nodes-alice ((arena Arena))
    (@intent "Create term list: [alice]")
    (@spec ((Arena) -> (List Term)))
    (let ((mut nodes (list-new arena Term)))
      (list-push nodes (make-iri arena EX_ALICE))
      nodes))

  (fn fixture-ns-target-class ((arena Arena))
    (@intent "NodeShape with target-classes=[Person]")
    (@spec ((Arena) -> NodeShape))
    (record-new
      NodeShape
      (id (make-iri arena EX_SHAPE))
      (target-nodes (list-new arena Term))
      (target-classes
        (let ((mut tc (list-new arena Term)))
          (list-push tc (make-iri arena EX_PERSON))
          tc))
      (target-subjects-of (list-new arena Term))
      (target-objects-of (list-new arena Term))
      (property-shapes (list-new arena PropertyShape))
      (constraints (list-new arena Constraint))
      (severity severity-violation)
      (message (none))
      (deactivated false)))

  (fn resolve-targets ((arena Arena) (data-graph SnarlDataGraph) (shape NodeShape))
    (@intent
      "Resolve all target declarations for a shape, returning unique focus nodes")
    (@spec ((Arena SnarlDataGraph NodeShape) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example (arena (fixture-g-typed arena) (fixture-ns-target-class arena)))
    (let ((mut result (list-new arena Term))
          (seen (set-new arena Term)))
      (for-each (node (. shape target-nodes))
        (when (not (set-has seen node))
          (set-put seen node)
          (list-push result node)))
      (for-each (cls (. shape target-classes))
        (let ((instances (resolve-target-class arena data-graph cls)))
          (for-each (inst instances)
            (when (not (set-has seen inst))
              (set-put seen inst)
              (list-push result inst)))))
      (for-each (pred (. shape target-subjects-of))
        (let ((subjects (resolve-target-subjects-of arena data-graph pred)))
          (for-each (subj subjects)
            (when (not (set-has seen subj))
              (set-put seen subj)
              (list-push result subj)))))
      (for-each (pred (. shape target-objects-of))
        (let ((objects (resolve-target-objects-of arena data-graph pred)))
          (for-each (obj objects)
            (when (not (set-has seen obj))
              (set-put seen obj)
              (list-push result obj)))))
      (let ((implicit (resolve-implicit-class-targets arena data-graph (. shape id))))
        (for-each (inst implicit)
          (when (not (set-has seen inst))
            (set-put seen inst)
            (list-push result inst))))
      result)
    :c-name
    "snarl_resolve_targets")

  (fn resolve-target-node ((arena Arena) (nodes (List Term)))
    (@intent "Return target nodes directly (they are the focus nodes)")
    (@spec ((Arena (List Term)) -> (List Term)))
    (@alloc arena)
    (@pure)
    (@post (== (list-len $result) (list-len nodes)))
    (@example (arena (fixture-target-nodes-alice arena)))
    nodes
    :c-name
    "snarl_resolve_target_node")

  (fn add-class-if-needed ((arena Arena) (classes (List Term)) (seen (Set Term)) (class-term Term))
    (@intent "Append a class to a collection once")
    (@spec ((Arena (List Term) (Set Term) Term) -> Unit))
    (@alloc arena)
    (when (not (set-has seen class-term))
      (set-put seen class-term)
      (list-push classes class-term)))

  (fn collect-constraint-classes ((arena Arena) (classes (List Term)) (seen (Set Term)) (constraint Constraint))
    (@intent "Collect classes referenced by sh:class constraints")
    (@spec ((Arena (List Term) (Set Term) Constraint) -> Unit))
    (@alloc arena)
    (match constraint
      ((con-class class-term)
        (add-class-if-needed arena classes seen class-term))
      (_ (do))))

  (fn collect-property-shape-classes ((arena Arena) (classes (List Term)) (seen (Set Term)) (ps PropertyShape))
    (@intent "Collect sh:class values from a property shape")
    (@spec ((Arena (List Term) (Set Term) PropertyShape) -> Unit))
    (@alloc arena)
    (for-each (constraint (. ps constraints))
      (collect-constraint-classes arena classes seen constraint)))

  (fn collect-node-shape-classes ((arena Arena) (classes (List Term)) (seen (Set Term)) (ns NodeShape))
    (@intent "Collect sh:class values from a node shape and its inline property shapes")
    (@spec ((Arena (List Term) (Set Term) NodeShape) -> Unit))
    (@alloc arena)
    (for-each (constraint (. ns constraints))
      (collect-constraint-classes arena classes seen constraint))
    (for-each (ps (. ns property-shapes))
      (collect-property-shape-classes arena classes seen ps)))

  (fn collect-class-constraints ((arena Arena) (shapes-graph ShapesGraph))
    (@intent "Collect all unique class terms used by sh:class constraints")
    (@spec ((Arena ShapesGraph) -> (List Term)))
    (@alloc arena)
    (let ((mut classes (list-new arena Term))
          (seen (set-new arena Term)))
      (for-each (ns (. shapes-graph node-shapes))
        (do
          (for-each (constraint (. ns constraints))
            (match constraint
              ((con-class class-term)
                (when (not (set-has seen class-term))
                  (set-put seen class-term)
                  (list-push classes class-term)))
              (_ (do))))
          (for-each (ps (. ns property-shapes))
            (for-each (constraint (. ps constraints))
              (match constraint
                ((con-class class-term)
                  (when (not (set-has seen class-term))
                    (set-put seen class-term)
                    (list-push classes class-term)))
                (_ (do)))))))
      (for-each (ps (. shapes-graph property-shapes))
        (for-each (constraint (. ps constraints))
          (match constraint
            ((con-class class-term)
              (when (not (set-has seen class-term))
                (set-put seen class-term)
                (list-push classes class-term)))
            (_ (do)))))
      classes))

  (fn build-class-index ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph ShapesGraph))
    (@intent "Precompute instance sets for all classes used by sh:class constraints")
    (@spec ((Arena SnarlDataGraph ShapesGraph) -> ClassIndex))
    (@alloc arena)
    (let ((classes (collect-class-constraints arena shapes-graph))
          (mut entries (list-new arena ClassInstances)))
      (for-each (class-term classes)
        (let ((instance-list (resolve-target-class arena data-graph class-term))
              (instances (set-new arena Term)))
          (for-each (inst instance-list)
            (set-put instances inst))
          (list-push entries
            (record-new ClassInstances
              (class-term class-term)
              (instances instances)))))
      (record-new ClassIndex (entries entries))))

  (fn class-index-has-class ((index ClassIndex) (class-term Term))
    (@intent "True if the class index has a cached entry for class-term")
    (@spec ((ClassIndex Term) -> Bool))
    (@pure)
    (let ((mut found false))
      (for-each (entry (. index entries))
        (when (and (not found) (term-eq (. entry class-term) class-term))
          (set! found true)))
      found))

  (fn class-index-has-instance ((index ClassIndex) (node Term) (class-term Term))
    (@intent "True if node is in the cached instance set for class-term")
    (@spec ((ClassIndex Term Term) -> Bool))
    (@pure)
    (let ((mut found false))
      (for-each (entry (. index entries))
        (when (and (not found) (term-eq (. entry class-term) class-term))
          (when (set-has (. entry instances) node)
            (set! found true))))
      found))

  (fn find-subclasses ((arena Arena) (data-graph SnarlDataGraph) (class-term Term))
    (@intent
      "Find class-term plus all transitive subclasses via rdfs:subClassOf in the data graph")
    (@spec ((Arena SnarlDataGraph Term) -> (List Term)))
    (@alloc arena)
    (@post (>= (list-len $result) 1))
    (@example (arena (fixture-g-typed arena) (make-iri arena EX_PERSON)))
    (let ((subclass-pred (make-iri arena RDFS_SUBCLASS_OF))
          (mut result (list-new arena Term))
          (visited (set-new arena Term))
          (mut queue (list-new arena Term))
          (mut qi 0))
      (list-push queue class-term)
      (set-put visited class-term)
      (while (< qi (list-len queue))
        (match (list-get queue qi)
          ((some current)
            (list-push result current)
            (let ((subs (snarl-data-graph-subjects arena data-graph subclass-pred current)))
              (for-each (sub subs)
                (when (not (set-has visited sub))
                  (set-put visited sub)
                  (list-push queue sub)))))
          ((none) (do)))
        (set! qi (+ qi 1)))
      result))

  (fn is-shacl-instance-of-class ((arena Arena) (data-graph SnarlDataGraph) (node Term) (class-term Term))
    (@intent
      "True if node is a SHACL instance of class-term: it has rdf:type C' where C' is class-term or a transitive rdfs:subClassOf of class-term (SHACL spec 2.1.3.1). Same relation used to resolve sh:targetClass.")
    (@spec ((Arena SnarlDataGraph Term Term) -> Bool))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@example
      (arena
        (fixture-g-typed arena)
        (make-iri arena EX_ALICE)
        (make-iri arena EX_PERSON))
      ->
      true)
    (@example
      (arena
        (fixture-g-typed arena)
        (make-iri arena EX_ALICE)
        (make-iri arena EX_BOB))
      ->
      false)
    (let ((type-pred (make-iri arena RDF_TYPE))
          (all-classes (find-subclasses arena data-graph class-term))
          (mut result false))
      (for-each (cls all-classes)
        (when (not result)
          (let ((type-triple (record-new Triple (subject node) (predicate type-pred) (object cls))))
            (when (snarl-data-graph-contains data-graph type-triple)
              (set! result true)))))
      result)
    :c-name
    "snarl_is_shacl_instance_of_class")

  (fn resolve-target-class ((arena Arena) (data-graph SnarlDataGraph) (class-term Term))
    (@intent
      "Find all instances of a class and its subclasses via rdf:type in the data graph")
    (@spec ((Arena SnarlDataGraph Term) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example (arena (fixture-g-typed arena) (make-iri arena EX_PERSON)))
    (let ((type-pred (make-iri arena RDF_TYPE))
          (all-classes (find-subclasses arena data-graph class-term))
          (mut result (list-new arena Term))
          (seen (set-new arena Term)))
      (for-each (cls all-classes)
        (let ((instances (snarl-data-graph-subjects arena data-graph type-pred cls)))
          (for-each (inst instances)
            (when (not (set-has seen inst))
              (set-put seen inst)
              (list-push result inst)))))
      result)
    :c-name
    "snarl_resolve_target_class")

  (fn resolve-target-subjects-of ((arena Arena) (data-graph SnarlDataGraph) (predicate Term))
    (@intent "Find all subjects that have a given predicate in the data graph")
    (@spec ((Arena SnarlDataGraph Term) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example (arena (fixture-g-alice-name arena) (make-iri arena EX_NAME)))
    (snarl-data-graph-subjects-of arena data-graph predicate)
    :c-name
    "snarl_resolve_target_subjects_of")

  (fn resolve-target-objects-of ((arena Arena) (data-graph SnarlDataGraph) (predicate Term))
    (@intent "Find all objects that have a given predicate in the data graph")
    (@spec ((Arena SnarlDataGraph Term) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example
      (arena (fixture-g-alice-knows-bob arena) (make-iri arena EX_KNOWS)))
    (snarl-data-graph-objects-of arena data-graph predicate)
    :c-name
    "snarl_resolve_target_objects_of")

  (fn resolve-implicit-class-targets ((arena Arena) (data-graph SnarlDataGraph) (shape-id Term))
    (@intent
      "If the shape IRI is used as an rdf:type class in the data graph, return those instances (including subclass instances)")
    (@spec ((Arena SnarlDataGraph Term) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example (arena (fixture-g-typed arena) (make-iri arena EX_PERSON)))
    (resolve-target-class arena data-graph shape-id)
    :c-name
    "snarl_resolve_implicit_class_targets"))
