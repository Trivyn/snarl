(module snarl
  (import rdf (Term Triple))
  (import index (IndexedGraph indexed-graph-size indexed-graph-create))
  (import data-graph
    (SnarlDataGraph snarl-data-graph-size snarl-data-graph-create snarl-data-graph-from-indexed))
  (import types
    (ShaclPath NodeKind Severity Constraint PropertyShape NodeShape ShapesGraph ValidationResult ValidationReport ValidatorConfig ValidatorResult default-validator-config make-validation-report report-conforms))
  (import parse (parse-shapes-graph))
  (import engine (engine-validate))
  (import report
    (report-to-string report-to-graph severity-to-string term-to-display-string path-to-display-string))
  (export
    ShaclPath
    NodeKind
    Severity
    Constraint
    PropertyShape
    NodeShape
    ShapesGraph
    ValidationResult
    ValidationReport
    ValidatorConfig
    ValidatorResult
    validate
    validate-with-config
    validate-data-graph
    validate-data-graph-with-config
    conforms
    conforms-data-graph
    default-config
    get-violations
    get-warnings
    get-result-count
    report-to-graph
    report-to-string)

  (@doc "SHACL Core validator with stable C FFI")

  (fn default-config ()
    (@intent "Create default validator configuration")
    (@spec (() -> ValidatorConfig))
    (@pure)
    (@post (== (. $result verbose) false))
    (@post (== (. $result max-errors) 0))
    (@post (== (. $result include-warnings) true))
    (@post (== (. $result include-infos) true))
    (@example () -> (ValidatorConfig false 0 true true))
    :c-name
    "snarl_default_config"
    (default-validator-config))

  (fn validate ((arena Arena) (data-graph IndexedGraph) (shapes-graph IndexedGraph))
    (@intent
      "Validate a data graph against a shapes graph using default config")
    (@spec ((Arena IndexedGraph IndexedGraph) -> ValidatorResult))
    (@alloc arena)
    (@pre (>= (indexed-graph-size data-graph) 0))
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    (@post
      (match $result
        ((validate-success report) (>= (list-len (. report results)) 0))
        ((validate-error _) true)))
    (@example (arena (indexed-graph-create arena) (indexed-graph-create arena)))
    :c-name
    "snarl_validate"
    (validate-with-config arena data-graph shapes-graph (default-config)))

  (fn validate-with-config ((arena Arena) (data-graph IndexedGraph) (shapes-graph IndexedGraph) (config ValidatorConfig))
    (@intent "Validate a data graph against a shapes graph with custom config")
    (@spec
      ((Arena IndexedGraph IndexedGraph ValidatorConfig) -> ValidatorResult))
    (@alloc arena)
    (@pre (>= (indexed-graph-size data-graph) 0))
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    (@example
      (arena
        (indexed-graph-create arena)
        (indexed-graph-create arena)
        (default-config)))
    :c-name
    "snarl_validate_with_config"
    (let ((fast-data (snarl-data-graph-from-indexed arena data-graph)))
      (validate-data-graph-with-config arena fast-data shapes-graph config)))

  (fn validate-data-graph ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph IndexedGraph))
    (@intent "Validate a Snarl fast data graph against a shapes graph using default config")
    (@spec ((Arena SnarlDataGraph IndexedGraph) -> ValidatorResult))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    :c-name
    "snarl_validate_data_graph"
    (validate-data-graph-with-config arena data-graph shapes-graph (default-config)))

  (fn validate-data-graph-with-config ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph IndexedGraph) (config ValidatorConfig))
    (@intent "Validate a Snarl fast data graph against a shapes graph with custom config")
    (@spec ((Arena SnarlDataGraph IndexedGraph ValidatorConfig) -> ValidatorResult))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    :c-name
    "snarl_validate_data_graph_with_config"
    (let ((shapes (parse-shapes-graph arena shapes-graph)))
      (engine-validate arena data-graph shapes config)))

  (fn conforms ((arena Arena) (data-graph IndexedGraph) (shapes-graph IndexedGraph))
    (@intent "Quick boolean check: does the data graph conform to the shapes?")
    (@spec ((Arena IndexedGraph IndexedGraph) -> Bool))
    (@alloc arena)
    (@pre (>= (indexed-graph-size data-graph) 0))
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    (@example
      (arena (indexed-graph-create arena) (indexed-graph-create arena))
      ->
      true)
    :c-name
    "snarl_conforms"
    (match (validate arena data-graph shapes-graph)
      ((validate-success report) (report-conforms report))
      ((validate-error _) false)))

  (fn conforms-data-graph ((arena Arena) (data-graph SnarlDataGraph) (shapes-graph IndexedGraph))
    (@intent "Quick boolean check for a Snarl fast data graph")
    (@spec ((Arena SnarlDataGraph IndexedGraph) -> Bool))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@pre (>= (indexed-graph-size shapes-graph) 0))
    :c-name
    "snarl_conforms_data_graph"
    (match (validate-data-graph arena data-graph shapes-graph)
      ((validate-success report) (report-conforms report))
      ((validate-error _) false)))

  (fn get-violations ((arena Arena) (report ValidationReport))
    (@intent "Get all violation-severity results from a validation report")
    (@spec ((Arena ValidationReport) -> (List ValidationResult)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (@post (<= (list-len $result) (list-len (. report results))))
    (@example (arena (make-validation-report arena)))
    :c-name
    "snarl_get_violations"
    (let ((mut result (list-new arena ValidationResult)))
      (for-each (r (. report results))
        (match (. r severity)
          (severity-violation (list-push result r))
          (_ (do))))
      result))

  (fn get-warnings ((arena Arena) (report ValidationReport))
    (@intent "Get all warning-severity results from a validation report")
    (@spec ((Arena ValidationReport) -> (List ValidationResult)))
    (@alloc arena)
    (@post (>= (list-len $result) 0))
    (@post (<= (list-len $result) (list-len (. report results))))
    (@example (arena (make-validation-report arena)))
    :c-name
    "snarl_get_warnings"
    (let ((mut result (list-new arena ValidationResult)))
      (for-each (r (. report results))
        (match (. r severity)
          (severity-warning (list-push result r))
          (_ (do))))
      result))

  (fn get-result-count ((report ValidationReport))
    (@intent "Get total number of validation results in the report")
    (@spec ((ValidationReport) -> (Int 0 ..)))
    (@pure)
    (@post (>= $result 0))
    (@post (== $result (list-len (. report results))))
    (@example ((make-validation-report arena)))
    :c-name
    "snarl_get_result_count"
    (list-len (. report results))))
