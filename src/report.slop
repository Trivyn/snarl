(module report
  (import rdf
    (Term Triple term-eq term-kind make-iri make-blank make-literal make-triple triple-subject triple-predicate triple-object IRI BlankNode Literal))
  (import index (IndexedGraph indexed-graph-create indexed-graph-add))
  (import vocab
    (RDF_TYPE RDF_FIRST RDF_REST RDF_NIL SHACL_INVERSE_PATH SHACL_ALTERNATIVE_PATH SHACL_ZERO_OR_MORE_PATH SHACL_ONE_OR_MORE_PATH SHACL_ZERO_OR_ONE_PATH XSD_BOOLEAN XSD_INTEGER SHACL_VALIDATION_REPORT SHACL_CONFORMS SHACL_RESULT SHACL_VALIDATION_RESULT SHACL_FOCUS_NODE SHACL_RESULT_PATH SHACL_RESULT_SEVERITY SHACL_SOURCE_CONSTRAINT_COMPONENT SHACL_SOURCE_SHAPE SHACL_VIOLATION SHACL_WARNING SHACL_INFO))
  (import strlib (string-build))
  (import types
    (ShaclPath Severity ValidationResult ValidationReport make-validation-report))
  (import af-vocab (SHACL_SOURCE_CONSTRAINT))
  (export
    report-to-string
    report-to-graph
    print-report
    severity-to-string
    term-to-display-string
    path-to-display-string)

  (@doc "Validation report construction and serialization")

  (fn fixture-path-list-ab ((arena Arena))
    (@intent "Create path list: [path-predicate ex:a, path-predicate ex:b]")
    (@spec ((Arena) -> (List ShaclPath)))
    (let ((mut paths (list-new arena ShaclPath)))
      (list-push
        paths
        (union-new
          ShaclPath
          path-predicate
          (make-iri arena "http://example.org/a")))
      (list-push
        paths
        (union-new
          ShaclPath
          path-predicate
          (make-iri arena "http://example.org/b")))
      paths))

  (fn print-report ((arena Arena) (report ValidationReport))
    (@intent "Print a validation report to stdout in human-readable form")
    (@spec ((Arena ValidationReport) -> Unit))
    (@alloc arena)
    (@example (arena (make-validation-report arena)))
    (let ((results (. report results))
          (result-count (list-len results)))
      (if (. report conforms)
        (println "Validation Report: CONFORMS")
        (do
          (print "Validation Report: ")
          (print (int-to-string arena result-count))
          (println " result(s)")))
      (println "---")
      (for-each (r results)
        (println "")
        (print "  Severity: ")
        (println (severity-to-string (. r severity)))
        (print "  Focus node: ")
        (println (term-to-display-string arena (. r focus-node)))
        (match (. r result-path)
          ((some p)
            (print "  Path: ")
            (println (path-to-display-string arena p)))
          ((none) (do)))
        (match (. r value)
          ((some v)
            (print "  Value: ")
            (println (term-to-display-string arena v)))
          ((none) (do)))
        (print "  Source shape: ")
        (println (term-to-display-string arena (. r source-shape)))
        (print "  Component: ")
        (println (. r source-constraint-component))
        (match (. r source-constraint)
          ((some c)
            (print "  Source constraint: ")
            (println (term-to-display-string arena c)))
          ((none) (do)))
        (match (. r message)
          ((some msg) (print "  Message: ") (println msg))
          ((none) (do)))))
    :c-name
    "snarl_print_report")

  (fn report-to-string ((arena Arena) (report ValidationReport))
    (@intent "Serialize a validation report to a human-readable string")
    (@spec ((Arena ValidationReport) -> String))
    (@alloc arena)
    (@example (arena (make-validation-report arena)))
    (let ((results (. report results))
          (result-count (list-len results))
          (mut parts (list-new arena String)))
      (if (. report conforms)
        (list-push parts "Validation Report: CONFORMS\n")
        (do
          (list-push parts "Validation Report: ")
          (list-push parts (int-to-string arena result-count))
          (list-push parts " result(s)\n")))
      (list-push parts "---\n")
      (for-each (r results)
        (list-push parts "\n")
        (list-push parts "  Severity: ")
        (list-push parts (severity-to-string (. r severity)))
        (list-push parts "\n")
        (list-push parts "  Focus node: ")
        (list-push parts (term-to-display-string arena (. r focus-node)))
        (list-push parts "\n")
        (match (. r result-path)
          ((some p)
            (list-push parts "  Path: ")
            (list-push parts (path-to-display-string arena p))
            (list-push parts "\n"))
          ((none) (do)))
        (match (. r value)
          ((some v)
            (list-push parts "  Value: ")
            (list-push parts (term-to-display-string arena v))
            (list-push parts "\n"))
          ((none) (do)))
        (list-push parts "  Source shape: ")
        (list-push parts (term-to-display-string arena (. r source-shape)))
        (list-push parts "\n")
        (list-push parts "  Component: ")
        (list-push parts (. r source-constraint-component))
        (list-push parts "\n")
        (match (. r source-constraint)
          ((some c)
            (list-push parts "  Source constraint: ")
            (list-push parts (term-to-display-string arena c))
            (list-push parts "\n"))
          ((none) (do)))
        (match (. r message)
          ((some msg)
            (list-push parts "  Message: ")
            (list-push parts msg)
            (list-push parts "\n"))
          ((none) (do))))
      (string-build arena parts))
    :c-name
    "snarl_report_to_string")

  (fn report-to-graph ((arena Arena) (report ValidationReport))
    (@intent "Serialize a validation report to an RDF graph (IndexedGraph)")
    (@spec ((Arena ValidationReport) -> IndexedGraph))
    (@alloc arena)
    (@example (arena (make-validation-report arena)))
    ;; The report's own blank nodes are numbered above every blank node a
    ;; result refers to (an inline shape, an sh:expression node, a blank
    ;; focus node or value), so the two can never collide.
    (let ((base (+ (report-max-blank-id report) 1))
          (mut g (indexed-graph-create arena))
          (report-node (make-blank arena base))
          (type-pred (make-iri arena RDF_TYPE))
          (report-type (make-iri arena SHACL_VALIDATION_REPORT))
          (conforms-pred (make-iri arena SHACL_CONFORMS))
          (conforms-val (make-literal arena (if (. report conforms) "true" "false") (some XSD_BOOLEAN) (none))))
      (set!
        g
        (indexed-graph-add
          arena
          g
          (make-triple arena report-node type-pred report-type)))
      (set!
        g
        (indexed-graph-add
          arena
          g
          (make-triple arena report-node conforms-pred conforms-val)))
      (let ((mut result-id (+ base 1))
            (mut path-id (+ (+ base 1) (list-len (. report results)))))
        (for-each (r (. report results))
          (let ((result-node (make-blank arena result-id))
                (result-pred (make-iri arena SHACL_RESULT))
                (result-type (make-iri arena SHACL_VALIDATION_RESULT))
                (focus-pred (make-iri arena SHACL_FOCUS_NODE))
                (sev-pred (make-iri arena SHACL_RESULT_SEVERITY))
                (sev-val (match (. r severity-iri)
                           ((some custom) custom)
                           ((none) (make-iri arena (match (. r severity) (severity-violation SHACL_VIOLATION) (severity-warning SHACL_WARNING) (severity-info SHACL_INFO))))))
                (src-shape-pred (make-iri arena SHACL_SOURCE_SHAPE))
                (src-comp-pred (make-iri arena SHACL_SOURCE_CONSTRAINT_COMPONENT)))
            (set!
              g
              (indexed-graph-add
                arena
                g
                (make-triple arena report-node result-pred result-node)))
            (set!
              g
              (indexed-graph-add
                arena
                g
                (make-triple arena result-node type-pred result-type)))
            (set!
              g
              (indexed-graph-add
                arena
                g
                (make-triple arena result-node focus-pred (. r focus-node))))
            (set!
              g
              (indexed-graph-add
                arena
                g
                (make-triple arena result-node sev-pred sev-val)))
            (set!
              g
              (indexed-graph-add
                arena
                g
                (make-triple
                  arena
                  result-node
                  src-shape-pred
                  (. r source-shape))))
            (set!
              g
              (indexed-graph-add
                arena
                g
                (make-triple
                  arena
                  result-node
                  src-comp-pred
                  (make-iri arena (. r source-constraint-component)))))
            (match (. r value)
              ((some v)
                (let ((val-pred (make-iri arena "http://www.w3.org/ns/shacl#value")))
                  (set!
                    g
                    (indexed-graph-add
                      arena
                      g
                      (make-triple arena result-node val-pred v)))))
              ((none) (do)))
            (match (. r source-constraint)
              ((some c)
                (set!
                  g
                  (indexed-graph-add
                    arena
                    g
                    (make-triple arena result-node (make-iri arena SHACL_SOURCE_CONSTRAINT) c))))
              ((none) (do)))
            (match (. r result-path)
              ((some p)
                (let ((path-pred (make-iri arena SHACL_RESULT_PATH)))
                  ;; A predicate path is its IRI; any other path is written
                  ;; out as SHACL path syntax on fresh blank nodes.
                  (let ((e (emit-path arena g p path-id)))
                    (set! path-id (. e next))
                    (set!
                      g
                      (indexed-graph-add
                        arena
                        (. e graph)
                        (make-triple arena result-node path-pred (. e node)))))))
              ((none) (do)))
            (match (. r message)
              ((some msg)
                (let ((msg-pred (make-iri arena "http://www.w3.org/ns/shacl#resultMessage")))
                  (set!
                    g
                    (indexed-graph-add
                      arena
                      g
                      (make-triple
                        arena
                        result-node
                        msg-pred
                        (make-literal arena msg (none) (none)))))))
              ((none) (do))))
          (set! result-id (+ result-id 1))))
      g)
    :c-name
    "snarl_report_to_graph")

  ;; A path written into a graph: the graph, the node that stands for the
  ;; path, and the next unused blank node id.
  (type PathEmit (record
    (graph IndexedGraph)
    (node Term)
    (next Int)))

  (fn emit-path-list ((arena Arena) (g IndexedGraph) (members (List ShaclPath)) (next Int))
    (@intent "Write paths as an rdf:List, on blank nodes numbered from next. The node is the list head (rdf:nil for no members).")
    (@spec ((Arena IndexedGraph (List ShaclPath) Int) -> PathEmit))
    (@alloc arena)
    (let ((n (list-len members))
          (first-pred (make-iri arena RDF_FIRST))
          (rest-pred (make-iri arena RDF_REST))
          (list-end (make-iri arena RDF_NIL))
          (mut graph g)
          (mut free (+ next (list-len members)))
          (mut i 0))
      (for-each (m members)
        (let ((e (emit-path arena graph m free))
              (cell (make-blank arena (+ next i)))
              (rest (if (< (+ i 1) n) (make-blank arena (+ next (+ i 1))) list-end)))
          (set! free (. e next))
          (set! graph (indexed-graph-add arena (. e graph) (make-triple arena cell first-pred (. e node))))
          (set! graph (indexed-graph-add arena graph (make-triple arena cell rest-pred rest)))
          (set! i (+ i 1))))
      (record-new PathEmit
        (graph graph)
        (node (if (> n 0) (make-blank arena next) list-end))
        (next free))))

  (fn emit-path-wrapper ((arena Arena) (g IndexedGraph) (pred String) (inner PathEmit))
    (@intent "Write [ pred inner ] on a fresh blank node, for the path forms that wrap one path or list")
    (@spec ((Arena IndexedGraph String PathEmit) -> PathEmit))
    (@alloc arena)
    (@post (== (. $result next) (+ (. inner next) 1)))
    (let ((node (make-blank arena (. inner next))))
      (record-new PathEmit
        (graph (indexed-graph-add arena (. inner graph) (make-triple arena node (make-iri arena pred) (. inner node))))
        (node node)
        (next (+ (. inner next) 1)))))

  (fn emit-path ((arena Arena) (g IndexedGraph) (p ShaclPath) (next Int))
    (@intent "Write a SHACL path into g in SHACL path syntax (SHACL 2.3.1), using blank nodes numbered from next. A predicate path adds nothing and is its own node.")
    (@spec ((Arena IndexedGraph ShaclPath Int) -> PathEmit))
    (@alloc arena)
    (match p
      ((path-predicate pred) (record-new PathEmit (graph g) (node pred) (next next)))
      ((path-sequence steps) (emit-path-list arena g steps next))
      ((path-alternative alts)
        (emit-path-wrapper arena g SHACL_ALTERNATIVE_PATH (emit-path-list arena g alts next)))
      ((path-inverse inner)
        (emit-path-wrapper arena g SHACL_INVERSE_PATH (emit-path arena g (deref inner) next)))
      ((path-zero-or-more inner)
        (emit-path-wrapper arena g SHACL_ZERO_OR_MORE_PATH (emit-path arena g (deref inner) next)))
      ((path-one-or-more inner)
        (emit-path-wrapper arena g SHACL_ONE_OR_MORE_PATH (emit-path arena g (deref inner) next)))
      ((path-zero-or-one inner)
        (emit-path-wrapper arena g SHACL_ZERO_OR_ONE_PATH (emit-path arena g (deref inner) next)))))

  (fn blank-id-or-minus-one ((t Term))
    (@intent "The id of a blank node, or -1 for any other term")
    (@spec ((Term) -> Int))
    (@pure)
    (@post (>= $result -1))
    (match t
      ((term-blank b) (. b id))
      (_ -1)))

  (fn report-max-blank-id ((report ValidationReport))
    (@intent "The largest blank node id among the terms the report's results refer to, or -1 if none is a blank node")
    (@spec ((ValidationReport) -> Int))
    (@pure)
    (@post (>= $result -1))
    (let ((mut m -1))
      (for-each (r (. report results))
        (@loop-invariant (>= m -1))
        (let ((a (blank-id-or-minus-one (. r focus-node)))
              (b (blank-id-or-minus-one (. r source-shape)))
              (c (match (. r value) ((some v) (blank-id-or-minus-one v)) ((none) -1)))
              (d (match (. r source-constraint) ((some x) (blank-id-or-minus-one x)) ((none) -1))))
          (when (> a m) (set! m a))
          (when (> b m) (set! m b))
          (when (> c m) (set! m c))
          (when (> d m) (set! m d))))
      m))

  (fn severity-to-string ((sev Severity))
    (@intent "Convert severity enum to display string")
    (@spec ((Severity) -> String))
    (@pure)
    (@example (severity-violation))
    (@example (severity-warning))
    (@example (severity-info))
    (match sev
      (severity-violation "Violation")
      (severity-warning "Warning")
      (severity-info "Info"))
    :c-name
    "snarl_severity_to_string")

  (fn term-to-display-string ((arena Arena) (t Term))
    (@intent "Convert an RDF term to a human-readable display string")
    (@spec ((Arena Term) -> String))
    (@alloc arena)
    (@example
      (arena (make-iri arena "http://example.org/x"))
      ->
      "http://example.org/x")
    (@example (arena (make-blank arena 1)) -> "_:1")
    (@example
      (arena (make-literal arena "hi" (none) (some "en")))
      ->
      "\"hi\"@en")
    (match t
      ((term-iri iri) (. iri value))
      ((term-blank blank)
        (string-concat arena "_:" (int-to-string arena (. blank id))))
      ((term-literal lit)
        (let ((mut parts (list-new arena String)))
          (list-push parts "\"")
          (list-push parts (. lit value))
          (list-push parts "\"")
          (match (. lit datatype)
            ((some dt) (list-push parts "^^") (list-push parts dt))
            ((none) (do)))
          (match (. lit lang)
            ((some lang) (list-push parts "@") (list-push parts lang))
            ((none) (do)))
          (string-build arena parts)))
      ((term-triple tt)
        (let ((tr (deref tt))
              (mut parts (list-new arena String)))
          (list-push parts "<<( ")
          (list-push parts (term-to-display-string arena (triple-subject tr)))
          (list-push parts " ")
          (list-push parts (term-to-display-string arena (triple-predicate tr)))
          (list-push parts " ")
          (list-push parts (term-to-display-string arena (triple-object tr)))
          (list-push parts " )>>")
          (string-build arena parts))))
    :c-name
    "snarl_term_to_display_string")

  (fn sequence-to-display-string ((arena Arena) (steps (List ShaclPath)))
    (@intent "Join sequence path steps with /")
    (@spec ((Arena (List ShaclPath)) -> String))
    (@alloc arena)
    (@example (arena (fixture-path-list-ab arena)))
    (let ((mut s ""))
      (let ((mut first true))
        (for-each (step steps)
          (if first (set! first false) (set! s (string-concat arena s " / ")))
          (set! s (string-concat arena s (path-to-display-string arena step)))))
      s))

  (fn alternative-to-display-string ((arena Arena) (alts (List ShaclPath)))
    (@intent "Join alternative path alts with |")
    (@spec ((Arena (List ShaclPath)) -> String))
    (@alloc arena)
    (@example (arena (fixture-path-list-ab arena)))
    (let ((mut s ""))
      (let ((mut first true))
        (for-each (alt alts)
          (if first (set! first false) (set! s (string-concat arena s " | ")))
          (set! s (string-concat arena s (path-to-display-string arena alt)))))
      s))

  (fn path-to-display-string ((arena Arena) (p ShaclPath))
    (@intent "Convert a SHACL path to a human-readable display string")
    (@spec ((Arena ShaclPath) -> String))
    (@alloc arena)
    (@example
      (arena
        (union-new
          ShaclPath
          path-predicate
          (make-iri arena "http://example.org/name")))
      ->
      "http://example.org/name")
    (match p
      ((path-predicate pred) (term-to-display-string arena pred))
      ((path-inverse inner)
        (string-concat arena "^" (path-to-display-string arena (deref inner))))
      ((path-sequence steps) (sequence-to-display-string arena steps))
      ((path-alternative alts) (alternative-to-display-string arena alts))
      ((path-zero-or-more inner)
        (string-concat arena (path-to-display-string arena (deref inner)) "*"))
      ((path-one-or-more inner)
        (string-concat arena (path-to-display-string arena (deref inner)) "+"))
      ((path-zero-or-one inner)
        (string-concat arena (path-to-display-string arena (deref inner)) "?")))
    :c-name
    "snarl_path_to_display_string"))
