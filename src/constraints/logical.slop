;; ============================================================
;; Snarl: Logical Constraints (Phase 3)
;;
;; sh:not (4.9.1)
;; sh:and (4.9.2)
;; sh:or (4.9.3)
;; sh:xone (4.9.4)
;;
;; Pure result constructors — engine handles recursion and
;; cycle detection, passes pre-evaluated Bool/Int results.
;; ============================================================

(module logical
  (@doc "SHACL logical constraints: sh:not, sh:and, sh:or, sh:xone")

  (import rdf (Term))
  (import vocab (SHACL_NOT SHACL_AND SHACL_OR SHACL_XONE))
  (import types (Severity ValidationResult ShaclPath))

  (export
    check-not
    check-and
    check-or
    check-xone)

  ;; ============================================================
  ;; sh:not — Focus node must NOT conform to the referenced shape
  ;; ============================================================

  (fn check-not ((arena Arena) (focus-node Term) (conforms-to-ref Bool)
                 (path (Option ShaclPath)) (shape-id Term)
                 (severity Severity) (message (Option String)))
    (@intent "Check sh:not: violation if focus conforms to referenced shape")
    (@spec ((Arena Term Bool (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    ;; Postcondition: ($result == (none)) iff (not conforms-to-ref)
    (if conforms-to-ref
      (some (record-new ValidationResult
        (focus-node focus-node) (result-path path) (value (none))
        (source-shape shape-id) (source-constraint-component SHACL_NOT)
        (severity severity) (message message)))
      (none))
    :c-name "snarl_check_not")

  ;; ============================================================
  ;; sh:and — Focus node must conform to ALL referenced shapes
  ;; ============================================================

  (fn check-and ((arena Arena) (focus-node Term) (all-pass Bool)
                 (path (Option ShaclPath)) (shape-id Term)
                 (severity Severity) (message (Option String)))
    (@intent "Check sh:and: violation if any referenced shape fails")
    (@spec ((Arena Term Bool (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    ;; Postcondition: ($result == (none)) iff all-pass
    (if all-pass
      (none)
      (some (record-new ValidationResult
        (focus-node focus-node) (result-path path) (value (none))
        (source-shape shape-id) (source-constraint-component SHACL_AND)
        (severity severity) (message message))))
    :c-name "snarl_check_and")

  ;; ============================================================
  ;; sh:or — Focus node must conform to at least one referenced shape
  ;; ============================================================

  (fn check-or ((arena Arena) (focus-node Term) (any-pass Bool)
                (path (Option ShaclPath)) (shape-id Term)
                (severity Severity) (message (Option String)))
    (@intent "Check sh:or: violation if no referenced shape passes")
    (@spec ((Arena Term Bool (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    ;; Postcondition: ($result == (none)) iff any-pass
    (if any-pass
      (none)
      (some (record-new ValidationResult
        (focus-node focus-node) (result-path path) (value (none))
        (source-shape shape-id) (source-constraint-component SHACL_OR)
        (severity severity) (message message))))
    :c-name "snarl_check_or")

  ;; ============================================================
  ;; sh:xone — Focus node must conform to exactly one referenced shape
  ;; ============================================================

  (fn check-xone ((arena Arena) (focus-node Term) (pass-count Int)
                  (path (Option ShaclPath)) (shape-id Term)
                  (severity Severity) (message (Option String)))
    (@intent "Check sh:xone: violation if not exactly one referenced shape passes")
    (@spec ((Arena Term Int (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    ;; Postcondition: ($result == (none)) iff (== pass-count 1)
    (if (== pass-count 1)
      (none)
      (some (record-new ValidationResult
        (focus-node focus-node) (result-path path) (value (none))
        (source-shape shape-id) (source-constraint-component SHACL_XONE)
        (severity severity) (message message))))
    :c-name "snarl_check_xone"))
