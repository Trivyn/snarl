;; ============================================================
;; Snarl: Other Constraints (Phase 2)
;;
;; sh:closed, sh:ignoredProperties (4.11)
;; sh:hasValue (4.12.1)
;; sh:in (4.12.2)
;; ============================================================

(module other
  (@doc "SHACL other constraints: sh:closed, sh:hasValue, sh:in")

  (import rdf (Term Triple term-eq triple-predicate make-iri make-literal make-triple))
  (import index (IndexedGraph indexed-graph-match indexed-graph-create indexed-graph-add))
  (import vocab (SHACL_CLOSED SHACL_HAS_VALUE SHACL_IN))
  (import types (Severity Constraint ValidationResult ShaclPath))

  ;; Test URI constants
  (const EX_FOCUS String "http://example.org/focus")
  (const EX_SHAPE String "http://example.org/Shape1")
  (const EX_A String "http://example.org/a")
  (const EX_B String "http://example.org/b")
  (const EX_C String "http://example.org/c")
  (const EX_NAME String "http://example.org/name")

  ;; ============================================================
  ;; Test Fixtures
  ;; ============================================================

  (fn fixture-term-list-ab ((arena Arena))
    (@intent "Create term list: [ex:a, ex:b]")
    (@spec ((Arena) -> (List Term)))
    (let ((mut terms (list-new arena Term)))
      (list-push terms (make-iri arena EX_A))
      (list-push terms (make-iri arena EX_B))
      terms))

  (fn fixture-allowed-terms-abc ((arena Arena))
    (@intent "Create allowed term list: [ex:a, ex:b, ex:c]")
    (@spec ((Arena) -> (List Term)))
    (let ((mut terms (list-new arena Term)))
      (list-push terms (make-iri arena EX_A))
      (list-push terms (make-iri arena EX_B))
      (list-push terms (make-iri arena EX_C))
      terms))

  (fn fixture-allowed-path-name ((arena Arena))
    (@intent "Create allowed paths list: [path-predicate ex:name]")
    (@spec ((Arena) -> (List ShaclPath)))
    (let ((mut paths (list-new arena ShaclPath)))
      (list-push paths (union-new ShaclPath path-predicate (make-iri arena EX_NAME)))
      paths))

  (fn fixture-g-focus-name ((arena Arena))
    (@intent "Graph with (focus ex:name 'Alice')")
    (@spec ((Arena) -> IndexedGraph))
    (let ((mut g (indexed-graph-create arena)))
      (set! g (indexed-graph-add arena g
        (make-triple arena (make-iri arena EX_FOCUS) (make-iri arena EX_NAME) (make-literal arena "Alice" (none) (none)))))
      g))

  (fn fixture-g-focus-name-age ((arena Arena))
    (@intent "Graph with (focus ex:name 'Alice'), (focus ex:age 30) — age not allowed")
    (@spec ((Arena) -> IndexedGraph))
    (let ((mut g (indexed-graph-create arena)))
      (set! g (indexed-graph-add arena g
        (make-triple arena (make-iri arena EX_FOCUS) (make-iri arena EX_NAME) (make-literal arena "Alice" (none) (none)))))
      (set! g (indexed-graph-add arena g
        (make-triple arena (make-iri arena EX_FOCUS) (make-iri arena "http://example.org/age") (make-literal arena "30" (none) (none)))))
      g))

  (export
    check-has-value
    check-in
    check-closed)

  ;; ============================================================
  ;; Membership predicate — extracted so the result <-> predicate
  ;; equivalence is a single uninterpreted call the verifier can prove
  ;; (an `exists` quantifier over a loop is silently skipped by slop verify).
  ;; ============================================================

  (fn list-contains-term ((terms (List Term)) (target Term))
    (@intent "True if some term in the list is term-equal to target")
    (@spec (((List Term) Term) -> Bool))
    (@pure)
    (let ((mut found false))
      (for-each (t terms)
        (when (term-eq t target)
          (set! found true)))
      found))

  ;; ============================================================
  ;; sh:hasValue — At least one value node must equal the given value
  ;; ============================================================

  (fn check-has-value ((arena Arena) (focus-node Term) (value-nodes (List Term))
                       (required-value Term) (path (Option ShaclPath))
                       (shape-id Term) (severity Severity) (message (Option String)))
    (@intent "Check sh:hasValue constraint: at least one value must equal the required value")
    (@spec ((Arena Term (List Term) Term (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    (@pre {(list-len value-nodes) >= 0})
    ;; Conforms (no result) iff some value node equals the required value.
    (@post {(== (== $result (none)) (list-contains-term value-nodes required-value))})
    (@property correctness (== (== $result (none)) (list-contains-term value-nodes required-value)))
    (@example (arena (make-iri arena EX_FOCUS) (fixture-term-list-ab arena) (make-iri arena EX_A) (none) (make-iri arena EX_SHAPE) severity-violation (none)) -> (none))
    (@example (arena (make-iri arena EX_FOCUS) (fixture-term-list-ab arena) (make-iri arena EX_C) (none) (make-iri arena EX_SHAPE) severity-violation (none)) -> (some (ValidationResult _ _ _ _ _ _ _)))
    (if (list-contains-term value-nodes required-value)
      (none)
      (some (record-new ValidationResult
              (focus-node focus-node)
              (result-path path)
              (value (none))
              (source-shape shape-id)
              (source-constraint-component SHACL_HAS_VALUE)
              (severity severity)
              (message message))))
    :c-name "snarl_check_has_value")

  ;; ============================================================
  ;; sh:in — Each value node must be in the given list
  ;; ============================================================

  (fn check-in ((arena Arena) (focus-node Term) (value-node Term)
                (allowed-values (List Term)) (path (Option ShaclPath))
                (shape-id Term) (severity Severity) (message (Option String)))
    (@intent "Check sh:in constraint: value node must be one of the allowed values")
    (@spec ((Arena Term Term (List Term) (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    (@pre {(list-len allowed-values) > 0})
    ;; Conforms (no result) iff the value node is one of the allowed values.
    (@post {(== (== $result (none)) (list-contains-term allowed-values value-node))})
    (@property correctness (== (== $result (none)) (list-contains-term allowed-values value-node)))
    (@example (arena (make-iri arena EX_FOCUS) (make-iri arena EX_A) (fixture-allowed-terms-abc arena) (none) (make-iri arena EX_SHAPE) severity-violation (none)) -> (none))
    (@example (arena (make-iri arena EX_FOCUS) (make-iri arena EX_FOCUS) (fixture-allowed-terms-abc arena) (none) (make-iri arena EX_SHAPE) severity-violation (none)) -> (some (ValidationResult _ _ _ _ _ _ _)))
    (if (list-contains-term allowed-values value-node)
      (none)
      (some (record-new ValidationResult
              (focus-node focus-node)
              (result-path path)
              (value (some value-node))
              (source-shape shape-id)
              (source-constraint-component SHACL_IN)
              (severity severity)
              (message message))))
    :c-name "snarl_check_in")

  ;; ============================================================
  ;; sh:closed — Only allowed properties may be present
  ;; ============================================================

  (fn check-closed ((arena Arena) (data-graph IndexedGraph) (focus-node Term)
                    (allowed-paths (List ShaclPath)) (path (Option ShaclPath))
                    (shape-id Term) (severity Severity) (message (Option String)))
    (@intent "Check sh:closed constraint: focus node must not have unexpected properties")
    (@spec ((Arena IndexedGraph Term (List ShaclPath) (Option ShaclPath) Term Severity (Option String))
            -> (List ValidationResult)))
    (@alloc arena)
    (@pre {(list-len allowed-paths) >= 0})
    (@post {(list-len $result) >= 0})
    ;; VERIFIER: fails — term-eq lacks equality axiom; path-predicate destructure not supported in contracts
    (@property soundness
      (forall (r $result)
        (not (exists (p allowed-paths) (term-eq (. r value) (path-iri p))))))
    (@property result-path-correct
      (forall (r $result)
        (== (. r result-path) (some (path-predicate (unwrap (. r value)))))))
    (@example (arena (fixture-g-focus-name arena) (make-iri arena EX_FOCUS) (fixture-allowed-path-name arena) (none) (make-iri arena EX_SHAPE) severity-violation (none))
      ;; Only ex:name present, which is allowed → no violations
      )
    (@example (arena (fixture-g-focus-name-age arena) (make-iri arena EX_FOCUS) (fixture-allowed-path-name arena) (none) (make-iri arena EX_SHAPE) severity-violation (none))
      ;; ex:age present but not in allowed paths → 1 violation
      )
    (let ((mut results (list-new arena ValidationResult))
          (triples (indexed-graph-match arena data-graph (some focus-node) (none) (none))))
      (for-each (triple triples)
        (let ((pred (triple-predicate triple))
              (mut allowed false))
          (for-each (ap allowed-paths)
            (match ap
              ((path-predicate p)
                (when (term-eq p pred)
                  (set! allowed true)))
              (_ (do))))
          (when (not allowed)
            (list-push results
              (record-new ValidationResult
                (focus-node focus-node)
                (result-path (some (union-new ShaclPath path-predicate pred)))
                (value (some pred))
                (source-shape shape-id)
                (source-constraint-component SHACL_CLOSED)
                (severity severity)
                (message message))))))
      results)
    :c-name "snarl_check_closed"))
