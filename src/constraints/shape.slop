;; ============================================================
;; Snarl: Shape-Based Constraints (Phase 3)
;;
;; sh:node (4.10.1)
;; sh:property (4.10.2) — handled by engine (property shapes)
;; sh:qualifiedValueShape (4.10.3)
;;
;; Pure result constructors — engine handles recursion and
;; cycle detection, passes pre-evaluated Bool/Int results.
;; ============================================================

(module shape
  (@doc "SHACL shape-based constraints: sh:node, sh:property, sh:qualifiedValueShape")

  (import rdf (Term))
  (import vocab (SHACL_NODE SHACL_QUALIFIED_VALUE_SHAPE))
  (import types (Severity ValidationResult ShaclPath))

  (export
    check-node
    check-qualified-value-shape)

  ;; ============================================================
  ;; sh:node — Value node must conform to the referenced shape
  ;; ============================================================

  (fn check-node ((arena Arena) (focus-node Term) (value-node Term) (value-conforms Bool)
                  (path (Option ShaclPath)) (shape-id Term)
                  (severity Severity) (message (Option String)))
    (@intent "Check sh:node: violation if value node fails referenced shape")
    (@spec ((Arena Term Term Bool (Option ShaclPath) Term Severity (Option String))
            -> (Option ValidationResult)))
    (@alloc arena)
    ;; Postcondition: ($result == (none)) iff value-conforms
    (if value-conforms
      (none)
      (some (record-new ValidationResult
        (focus-node focus-node) (result-path path) (value (some value-node))
        (source-shape shape-id) (source-constraint-component SHACL_NODE)
        (severity severity) (message message))))
    :c-name "snarl_check_node")

  ;; ============================================================
  ;; sh:qualifiedValueShape — Qualified cardinality over shape
  ;; ============================================================

  (fn check-qualified-value-shape ((arena Arena) (focus-node Term) (conforming-count Int)
                                   (q-min (Int 0 ..)) (q-max (Option (Int 0 ..)))
                                   (path (Option ShaclPath)) (shape-id Term)
                                   (severity Severity) (message (Option String)))
    (@intent "Check sh:qualifiedValueShape: count of conforming values must be within range")
    (@spec ((Arena Term Int (Int 0 ..) (Option (Int 0 ..)) (Option ShaclPath) Term Severity (Option String))
            -> (List ValidationResult)))
    (@alloc arena)
    (@pre {conforming-count >= 0})
    (@pre {q-min >= 0})
    (let ((mut results (list-new arena ValidationResult)))
      (when (< conforming-count q-min)
        (list-push results (record-new ValidationResult
          (focus-node focus-node) (result-path path) (value (none))
          (source-shape shape-id)
          (source-constraint-component SHACL_QUALIFIED_VALUE_SHAPE)
          (severity severity) (message message))))
      (match q-max
        ((some max-val)
          (when (> conforming-count max-val)
            (list-push results (record-new ValidationResult
              (focus-node focus-node) (result-path path) (value (none))
              (source-shape shape-id)
              (source-constraint-component SHACL_QUALIFIED_VALUE_SHAPE)
              (severity severity) (message message)))))
        ((none) (do)))
      results)
    :c-name "snarl_check_qualified_value_shape"))
