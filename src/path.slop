(module path
  (import rdf
    (Term Triple term-eq triple-subject triple-predicate triple-object make-iri make-literal make-triple))
  (import data-graph
    (SnarlDataGraph snarl-data-graph-objects snarl-data-graph-subjects snarl-data-graph-size snarl-data-graph-create snarl-data-graph-add))
  (import types (ShaclPath))
  (export resolve-path resolve-path-from)

  (@doc "SHACL property path evaluation against RDF data graphs")

  (const EX_ALICE String "http://example.org/alice")

  (const EX_BOB String "http://example.org/bob")

  (const EX_NAME String "http://example.org/name")

  (const EX_KNOWS String "http://example.org/knows")

  (const EX_NEXT String "http://example.org/next")

  (const EX_A String "http://example.org/a")

  (const EX_B String "http://example.org/b")

  (const EX_C String "http://example.org/c")

  (fn fixture-g-alice-name ((arena Arena))
    (@intent "Graph with (alice name 'Alice')")
    (@spec ((Arena) -> SnarlDataGraph))
    (let ((mut g (snarl-data-graph-create arena)))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_ALICE)
            (make-iri arena EX_NAME)
            (make-literal arena "Alice" (none) (none)))))
      g))

  (fn fixture-g-chain ((arena Arena))
    (@intent "Graph with (a next b), (b next c)")
    (@spec ((Arena) -> SnarlDataGraph))
    (let ((mut g (snarl-data-graph-create arena)))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_A)
            (make-iri arena EX_NEXT)
            (make-iri arena EX_B))))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_B)
            (make-iri arena EX_NEXT)
            (make-iri arena EX_C))))
      g))

  (fn fixture-g-alice-knows-bob ((arena Arena))
    (@intent "Graph with (alice knows bob), (bob name 'Bob')")
    (@spec ((Arena) -> SnarlDataGraph))
    (let ((mut g (snarl-data-graph-create arena)))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_ALICE)
            (make-iri arena EX_KNOWS)
            (make-iri arena EX_BOB))))
      (set!
        g
        (snarl-data-graph-add
          arena
          g
          (make-triple
            arena
            (make-iri arena EX_BOB)
            (make-iri arena EX_NAME)
            (make-literal arena "Bob" (none) (none)))))
      g))

  (fn fixture-path-seq-knows-name ((arena Arena))
    (@intent
      "Create sequence path list: [path-predicate knows, path-predicate name]")
    (@spec ((Arena) -> (List ShaclPath)))
    (let ((mut steps (list-new arena ShaclPath)))
      (list-push
        steps
        (union-new ShaclPath path-predicate (make-iri arena EX_KNOWS)))
      (list-push
        steps
        (union-new ShaclPath path-predicate (make-iri arena EX_NAME)))
      steps))

  (fn resolve-path ((arena Arena) (data-graph SnarlDataGraph) (focus-node Term) (path ShaclPath))
    (@intent
      "Resolve a SHACL property path from a focus node, returning all value nodes")
    (@spec ((Arena SnarlDataGraph Term ShaclPath) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example
      (arena
        (fixture-g-alice-name arena)
        (make-iri arena EX_ALICE)
        (union-new ShaclPath path-predicate (make-iri arena EX_NAME))))
    (match path
      ((path-predicate pred)
        (snarl-data-graph-objects arena data-graph focus-node pred))
      ((path-sequence steps)
        (resolve-sequence arena data-graph focus-node steps))
      ((path-alternative alternatives)
        (resolve-alternative arena data-graph focus-node alternatives))
      ((path-inverse inner)
        (resolve-inverse arena data-graph focus-node (deref inner)))
      ((path-zero-or-more inner)
        (resolve-zero-or-more arena data-graph focus-node (deref inner)))
      ((path-one-or-more inner)
        (resolve-one-or-more arena data-graph focus-node (deref inner)))
      ((path-zero-or-one inner)
        (resolve-zero-or-one arena data-graph focus-node (deref inner))))
    :c-name
    "snarl_resolve_path")

  (fn resolve-path-from ((arena Arena) (data-graph SnarlDataGraph) (object Term) (path ShaclPath))
    (@intent "Resolve a SHACL path in reverse: given an object, find subjects")
    (@spec ((Arena SnarlDataGraph Term ShaclPath) -> (List Term)))
    (@alloc arena)
    (@pre (>= (snarl-data-graph-size data-graph) 0))
    (@post (>= (list-len $result) 0))
    (@example
      (arena
        (fixture-g-alice-name arena)
        (make-iri arena EX_ALICE)
        (union-new ShaclPath path-predicate (make-iri arena EX_NAME))))
    (match path
      ((path-predicate pred)
        (snarl-data-graph-subjects arena data-graph pred object))
      (_ (list-new arena Term)))
    :c-name
    "snarl_resolve_path_from")

  (fn resolve-sequence ((arena Arena) (g SnarlDataGraph) (focus Term) (steps (List ShaclPath)))
    (@intent
      "Resolve sequence path by chaining each step's results as input to the next")
    (@spec ((Arena SnarlDataGraph Term (List ShaclPath)) -> (List Term)))
    (@alloc arena)
    (@example
      (arena
        (fixture-g-alice-knows-bob arena)
        (make-iri arena EX_ALICE)
        (fixture-path-seq-knows-name arena)))
    (let ((mut current-nodes (list-new arena Term)))
      (list-push current-nodes focus)
      (for-each (step steps)
        (let ((mut next-nodes (list-new arena Term)))
          (for-each (node current-nodes)
            (let ((step-results (resolve-path arena g node step)))
              (for-each (r step-results) (list-push next-nodes r))))
          (set! current-nodes next-nodes)))
      current-nodes))

  (fn resolve-alternative ((arena Arena) (g SnarlDataGraph) (focus Term) (alts (List ShaclPath)))
    (@intent
      "Resolve alternative path by collecting results from all alternatives")
    (@spec ((Arena SnarlDataGraph Term (List ShaclPath)) -> (List Term)))
    (@alloc arena)
    (@example
      (arena
        (fixture-g-alice-name arena)
        (make-iri arena EX_ALICE)
        (fixture-path-seq-knows-name arena)))
    (let ((mut result (list-new arena Term)))
      (for-each (alt alts)
        (let ((alt-results (resolve-path arena g focus alt)))
          (for-each (r alt-results) (list-push result r))))
      result))

  (fn resolve-inverse ((arena Arena) (g SnarlDataGraph) (focus Term) (inner ShaclPath))
    (@intent
      "Resolve inverse path: find nodes that reach focus-node via inner path. Nested inversions are peeled ITERATIVELY rather than by mutual recursion with resolve-path: inverse(inverse(X)) = X, so a chain of inversions collapses to its innermost non-inverse path plus a parity bit (odd = still inverted, even = forward). The old formulation bounced resolve-inverse -> resolve-path -> resolve-inverse once per two levels, costing native C stack per level with no depth bound -- a legal 50000-deep sh:inversePath chain overflowed an 8MB stack on x86-64/gcc (it survived only on arm64/clang, whose frames are smaller). This loop is O(1) stack in the length of the chain.")
    (@spec ((Arena SnarlDataGraph Term ShaclPath) -> (List Term)))
    (@alloc arena)
    (@example
      (arena
        (fixture-g-alice-knows-bob arena)
        (make-iri arena EX_BOB)
        (union-new ShaclPath path-predicate (make-iri arena EX_KNOWS))))
    (let ((mut cur inner)
          (mut inverted true)
          (mut peeling true))
      (while peeling
        (match cur
          ((path-inverse inner2)
            (set! cur (deref inner2))
            (set! inverted (not inverted)))
          (_ (set! peeling false))))
      ;; `cur` is now the innermost non-inverse path. Odd inversion count
      ;; reproduces the original terminal case (subjects-of for a plain
      ;; predicate, empty for anything else); even count is the identity,
      ;; i.e. resolve `cur` forward -- one non-recursive descent, not one
      ;; per level.
      (if inverted
        (match cur
          ((path-predicate pred) (snarl-data-graph-subjects arena g pred focus))
          (_ (list-new arena Term)))
        (resolve-path arena g focus cur))))

  (fn resolve-zero-or-more ((arena Arena) (g SnarlDataGraph) (focus Term) (inner ShaclPath))
    (@intent
      "Resolve zero-or-more path: transitive closure including start node")
    (@spec ((Arena SnarlDataGraph Term ShaclPath) -> (List Term)))
    (@alloc arena)
    (@example
      (arena
        (fixture-g-chain arena)
        (make-iri arena EX_A)
        (union-new ShaclPath path-predicate (make-iri arena EX_NEXT))))
    (let ((mut result (list-new arena Term))
          (visited (set-new arena Term))
          (mut queue (list-new arena Term))
          (mut qi 0))
      (list-push queue focus)
      (while (< qi (list-len queue))
        (match (list-get queue qi)
          ((some current)
            (set! qi (+ qi 1))
            (when (not (set-has visited current))
              (set-put visited current)
              (list-push result current)
              (let ((next (resolve-path arena g current inner)))
                (for-each (n next)
                  (when (not (set-has visited n)) (list-push queue n))))))
          ((none) (set! qi (+ qi 1)))))
      result))

  (fn resolve-one-or-more ((arena Arena) (g SnarlDataGraph) (focus Term) (inner ShaclPath))
    (@intent
      "Resolve one-or-more path: transitive closure excluding start node unless reachable")
    (@spec ((Arena SnarlDataGraph Term ShaclPath) -> (List Term)))
    (@alloc arena)
    (@example
      (arena
        (fixture-g-chain arena)
        (make-iri arena EX_A)
        (union-new ShaclPath path-predicate (make-iri arena EX_NEXT))))
    (let ((first-step (resolve-path arena g focus inner))
          (mut result (list-new arena Term))
          (visited (set-new arena Term))
          (mut queue (list-new arena Term))
          (mut qi 0))
      (for-each (node first-step) (list-push queue node))
      (while (< qi (list-len queue))
        (match (list-get queue qi)
          ((some current)
            (set! qi (+ qi 1))
            (when (not (set-has visited current))
              (set-put visited current)
              (list-push result current)
              (let ((next (resolve-path arena g current inner)))
                (for-each (n next)
                  (when (not (set-has visited n)) (list-push queue n))))))
          ((none) (set! qi (+ qi 1)))))
      result))

  (fn resolve-zero-or-one ((arena Arena) (g SnarlDataGraph) (focus Term) (inner ShaclPath))
    (@intent
      "Resolve zero-or-one path: focus node itself plus one-step results (deduplicated)")
    (@spec ((Arena SnarlDataGraph Term ShaclPath) -> (List Term)))
    (@alloc arena)
    (@example
      (arena
        (fixture-g-chain arena)
        (make-iri arena EX_A)
        (union-new ShaclPath path-predicate (make-iri arena EX_NEXT))))
    (let ((mut result (list-new arena Term))
          (visited (set-new arena Term)))
      (set-put visited focus)
      (list-push result focus)
      (let ((one-step (resolve-path arena g focus inner)))
        (for-each (n one-step)
          (when (not (set-has visited n))
            (set-put visited n)
            (list-push result n))))
      result)))
