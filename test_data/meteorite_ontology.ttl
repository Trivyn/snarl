<https://example.org/meteorite_ontology/domain/> a owl:Ontology ;
    rdfs:label "Domain Ontology (Clean Model)" ;
    rdfs:comment "Clean, publishable domain model with proper naming and domain ontology alignments" ;
    dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime ;
    dcterms:modified "2026-06-28T20:24:04Z"^^xsd:dateTime ;
    dcterms:creator "Trivyn Ontology Pipeline" ;
    dcterms:publisher "Trivyn" ;
    owl:versionInfo "0.8.4" ;
    dcterms:provenance """Generated by Trivyn v0.8.4 on 2026-06-28T20:24:04Z.
Sources: 1 CSV.
Domain ontology: Core Ontologies (BFO + CCO).
Domain hint: General.
Core fallback: yes.
Mid-level clustering enabled.""" ;
    owl:imports <https://example.org/meteorite_ontology/mapping/> .

# =============================================================================
# Annotation Property Definitions
# =============================================================================

trivyn:confidence a owl:AnnotationProperty ;
    rdfs:label "confidence score" ;
    rdfs:comment "Confidence score for automated alignments and equivalences (0.0-1.0)" ;
    rdfs:range xsd:decimal .

# =============================================================================
# Domain Ontology - Clean Publishable Model
# =============================================================================
# This ontology provides clean class/property names suitable for publication.
# Includes mid-level concepts and alignments to top-level ontologies (BFO/CCO).
# Keyless domain ontology — surrogate identifiers are confined to raw layer and bridged via owl:equivalentClass/Property axioms in mapping.ttl
# =============================================================================

# Classes
:MeteoriteLanding a owl:Class ;
    rdfs:label "Meteorite Landing" ;
    trivyn:labelProperty :hasName ;
    skos:definition "Represents data about Meteorite Landing entities." ;
    skos:historyNote "Derived from CSV file 'MeteoriteLanding'" ;
    rdfs:subClassOf cco:ont00000922 {| trivyn:confidence "0.60"^^xsd:decimal ; trivyn:l0Category "process" ; trivyn:parentLabel "Act of Arrival" ; trivyn:rrfRank "53"^^xsd:integer ; skos:historyNote "Aligned to Act of Arrival via embedding similarity" ; skos:editorialNote "LLM picked rank 53 — narrow candidate gap; manual review recommended" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |}.

# Lifted Classes (promoted from literal columns to entities)
:MeteoriteClass a owl:Class ;
    rdfs:label "Meteorite Class" ;
    skos:historyNote "Lifted from column 'Recclass' in table 'MeteoriteLanding' (low cardinality)" ;
    trivyn:labelProperty :hasMeteoriteClassName ;
    rdfs:subClassOf cco:ont00000686 {| trivyn:confidence "0.60"^^xsd:decimal ; trivyn:l0Category "designator" ; trivyn:parentLabel "Designative Information Content Entity" ; skos:historyNote "Aligned to Designative Information Content Entity via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "A classification for meteorites based on their chemical and mineralogical composition.";
    skos:altLabel "Meteorite type";
    skos:altLabel "Meteorite group";
    skos:example "Acapulcoite";
    skos:example "Achondrite";
    skos:example "Aubrite".

:hasMeteoriteClassName a owl:DatatypeProperty ;
    rdfs:label "has meteorite class name" ;
    rdfs:domain :MeteoriteClass ;
    rdfs:range xsd:string ;
    skos:historyNote "Name property for lifted class MeteoriteClass" ;
    rdfs:subPropertyOf cco:ont00001765 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has text value" ; skos:historyNote "Aligned to has text value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the classification name of a meteorite.";
    skos:altLabel "meteorite class name";
    skos:altLabel "meteorite classification";
    skos:altLabel "has meteorite class name".

# Object Properties (Unified - Many-to-Many, Foreign Keys, and Lifted)
:hasMeteoriteClass a owl:ObjectProperty ;
    rdfs:label "has meteorite class" ;
    rdfs:comment "Lifted from column 'Recclass' in table 'MeteoriteLanding' (low cardinality)" ;
    rdfs:domain :MeteoriteLanding ;
    rdfs:range :MeteoriteClass ;
    skos:historyNote "Lifted from column 'Recclass' in table 'MeteoriteLanding' (low cardinality)" ;
    owl:inverseOf :isMeteoriteClassOf ;
    skos:definition "Relates a meteorite landing to its specific meteorite classification.";
    skos:altLabel "meteorite classification";
    skos:altLabel "meteorite type";
    skos:altLabel "has meteorite class".

:isMeteoriteClassOf a owl:ObjectProperty ;
    rdfs:label "is meteorite class of" ;
    rdfs:comment "Inverse of hasMeteoriteClass (relates MeteoriteClass to MeteoriteLanding)" ;
    rdfs:domain :MeteoriteClass ;
    rdfs:range :MeteoriteLanding ;
    skos:historyNote "Inverse of hasMeteoriteClass (relates MeteoriteClass to MeteoriteLanding)" ;
    owl:inverseOf :hasMeteoriteClass ;
    skos:definition "Relates a meteorite classification to the specific landing event.";
    skos:altLabel "meteorite class of landing";
    skos:altLabel "is meteorite class of".

# Datatype Properties
:hasFall a owl:DatatypeProperty ;
    rdfs:label "has fall" ;
    rdfs:domain :MeteoriteLanding ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.Fall'" ;
    rdfs:subPropertyOf cco:ont00001765 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has text value" ; skos:historyNote "Aligned to has text value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the fall location of a meteorite landing.";
    skos:altLabel "fall location";
    skos:altLabel "landing site";
    skos:altLabel "has fall";
    rdfs:range :HasFallDatatype;
    sh:minCount "1"^^xsd:integer.

:hasGeoLocation a owl:DatatypeProperty ;
    rdfs:label "has geo location" ;
    rdfs:domain :MeteoriteLanding ;
    rdfs:range geo:wktLiteral ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.GeoLocation'" ;
    skos:definition "Records the geographic location of a meteorite landing as a WKT string.";
    skos:altLabel "geographic location";
    skos:altLabel "spatial coordinates";
    skos:altLabel "has geo location";
    skos:hiddenLabel "geo".

:hasMassG a owl:DatatypeProperty ;
    rdfs:label "has mass g" ;
    rdfs:domain :MeteoriteLanding ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.MassG'" ;
    rdfs:subPropertyOf cco:ont00001770 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has double value" ; skos:historyNote "Aligned to has double value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the mass of a meteorite landing in grams.";
    skos:altLabel "mass in grams";
    skos:altLabel "has mass g";
    skos:hiddenLabel "mass_g";
    rdfs:range :HasMassGDatatype.

:hasName a owl:DatatypeProperty ;
    rdfs:label "has name" ;
    rdfs:domain :MeteoriteLanding ;
    rdfs:range xsd:string ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.Name'" ;
    rdfs:subPropertyOf cco:ont00001765 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has text value" ; skos:historyNote "Aligned to has text value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the name of an entity as a string value.";
    skos:altLabel "label";
    skos:altLabel "designation";
    skos:altLabel "has name";
    sh:minCount "1"^^xsd:integer.

:hasNameType a owl:DatatypeProperty ;
    rdfs:label "has name type" ;
    rdfs:domain :MeteoriteLanding ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.NameType'" ;
    rdfs:subPropertyOf cco:ont00001765 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has text value" ; skos:historyNote "Aligned to has text value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the classification of a name for a meteorite landing.";
    skos:altLabel "name classification";
    skos:altLabel "has name type";
    rdfs:range :HasNameTypeDatatype;
    sh:minCount "1"^^xsd:integer.

:hasReclat a owl:DatatypeProperty ;
    rdfs:label "has reclat" ;
    rdfs:domain :MeteoriteLanding ;
    rdfs:range xsd:double ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.Reclat'" ;
    rdfs:subPropertyOf cco:ont00001770 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has double value" ; skos:historyNote "Aligned to has double value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the declination of a meteorite landing site.";
    skos:altLabel "declination";
    skos:altLabel "has reclat";
    skos:hiddenLabel "decl".

:hasReclong a owl:DatatypeProperty ;
    rdfs:label "has reclong" ;
    rdfs:domain :MeteoriteLanding ;
    rdfs:range xsd:double ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.Reclong'" ;
    rdfs:subPropertyOf cco:ont00001770 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has double value" ; skos:historyNote "Aligned to has double value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the right longitude of a meteorite landing.";
    skos:altLabel "right longitude";
    skos:altLabel "has reclong".

:hasYear a owl:DatatypeProperty ;
    rdfs:label "has year" ;
    rdfs:domain :MeteoriteLanding ;
    rdfs:range xsd:gYear ;
    skos:historyNote "Mapped from CSV column 'MeteoriteLanding.Year'" ;
    rdfs:subPropertyOf cco:ont00001771 {| trivyn:confidence "0.85"^^xsd:decimal ; trivyn:parentLabel "has date value" ; skos:historyNote "Aligned to has date value via embedding similarity" ; dcterms:created "2026-06-28T20:24:04Z"^^xsd:dateTime |};
    skos:definition "Records the year of a meteorite landing as a year value.";
    skos:altLabel "landing year";
    skos:altLabel "has year".



# =============================================================================
# Mid-Level Concepts (Induced from Base Classes)
# =============================================================================

# =============================================================================
# End of Domain Ontology
# =============================================================================

# =============================================================================
# Structural SHACL Cues
# =============================================================================

:MeteoriteClass rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty rdfs:label ;
    owl:qualifiedCardinality 1 ;
    owl:onDataRange xsd:string
] .


# =============================================================================
# Value Fact Datatypes
# =============================================================================

:HasFallDatatype a rdfs:Datatype ;
    owl:onDatatype xsd:string ;
    owl:oneOf ( "Fell" "Found" ) .

:HasMassGDatatype a rdfs:Datatype ;
    owl:onDatatype xsd:double ;
    owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:double ] ) .

:HasNameTypeDatatype a rdfs:Datatype ;
    owl:onDatatype xsd:string ;
    owl:oneOf ( "Relict" "Valid" ) .

