;; ============================================================
;; Snarl CLI Integration Tests
;;
;; Tests the full pipeline: parse TTL -> validate -> report.
;; Uses fixture files in tests/fixtures/.
;; ============================================================

(module test-cli
  (@doc "Integration tests for snarl SHACL validator")

  (import rdf (Term Triple Graph GraphSize make-graph graph-size make-iri
               make-literal make-triple term-eq))
  (import index (IndexedGraph indexed-graph-create indexed-graph-add indexed-graph-size indexed-graph-objects))
  (import vocab (SHACL_PATH))
  (import parse (path-node-eval-depth path-max-eval-depth))
  (import ttl (parse-ttl-file))
  (import snarl (validate validate-with-config conforms default-config
                 ValidatorConfig ValidatorResult ValidationReport
                 get-violations get-warnings get-result-count
                 report-to-string))
  (import types (make-validation-report report-conforms))
  (import strlib (contains))

  ;; ============================================================
  ;; Test Utilities
  ;; ============================================================

  (fn load-test-graph ((arena Arena) (path String))
    (@intent "Load a TTL fixture file into an IndexedGraph for testing")
    (@spec ((Arena String) -> (Option IndexedGraph)))
    (@alloc arena)
    (match (parse-ttl-file arena path)
      ((ok g)
        (let ((mut ig (indexed-graph-create arena)))
          (for-each (t (. g triples))
            (set! ig (indexed-graph-add arena ig t)))
          (some ig)))
      ((error _) (none))))

  (fn assert-conforms ((arena Arena) (path String))
    (@intent "Assert that a file conforms (no violations)")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena path)
      ((some g)
        (let ((result (conforms arena g g)))
          (if result
            (do (print "  PASS: ") (print path) (println " conforms") true)
            (do (print "  FAIL: ") (print path) (println " expected to conform but got violations") false))))
      ((none)
        (print "  FAIL: could not load ") (println path) false)))

  (fn assert-violations ((arena Arena) (path String) (expected-count Int))
    (@intent "Assert that a file has exactly N violations")
    (@spec ((Arena String Int) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena path)
      ((some g)
        (match (validate arena g g)
          ((validate-success report)
            (let ((violations (get-violations arena report))
                  (actual-count (list-len violations)))
              (if (== actual-count expected-count)
                (do (print "  PASS: ") (print path) (print " has ")
                    (print (int-to-string arena expected-count)) (println " violation(s)") true)
                (do (print "  FAIL: ") (print path) (print " expected ")
                    (print (int-to-string arena expected-count)) (print " violation(s) but got ")
                    (println (int-to-string arena actual-count)) false))))
          ((validate-error msg)
            (print "  FAIL: validation error: ") (println msg) false)))
      ((none)
        (print "  FAIL: could not load ") (println path) false)))

  (fn assert-has-violations ((arena Arena) (path String))
    (@intent "Assert that a file has at least one violation")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena path)
      ((some g)
        (let ((result (conforms arena g g)))
          (if (not result)
            (do (print "  PASS: ") (print path) (println " has violations") true)
            (do (print "  FAIL: ") (print path) (println " expected violations but conforms") false))))
      ((none)
        (print "  FAIL: could not load ") (println path) false)))

  (fn assert-conforms-separate ((arena Arena) (data-path String) (shapes-path String))
    (@intent "Assert that separate data/shapes files conform (no violations)")
    (@spec ((Arena String String) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena data-path)
      ((some dg)
        (match (load-test-graph arena shapes-path)
          ((some sg)
            (let ((result (conforms arena dg sg)))
              (if result
                (do (print "  PASS: ") (print data-path) (println " conforms") true)
                (do (print "  FAIL: ") (print data-path) (println " expected to conform but got violations") false))))
          ((none)
            (print "  FAIL: could not load shapes ") (println shapes-path) false)))
      ((none)
        (print "  FAIL: could not load data ") (println data-path) false)))

  (fn assert-engine-error ((arena Arena) (path String) (expected-substring String))
    (@intent "Assert that validating a file triggers the engine's ValidatorResult::Error (e.g. shape recursion), not a crash or a silent conforms/violations report -- and that the error message contains expected-substring, pinning WHICH channel produced it (engine pair-revisit vs. engine depth-budget vs. path pre-scan vs. list pre-scan) so a regression that swapped in a different error class, or a future unrelated error, cannot be mistaken for this one")
    (@spec ((Arena String String) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena path)
      ((some g)
        (match (validate arena g g)
          ((validate-error msg)
            (if (contains msg expected-substring)
              (do (print "  PASS: ") (print path) (print " engine error: ") (println msg) true)
              (do (print "  FAIL: ") (print path) (print " engine error message did not contain '") (print expected-substring) (print "': ") (println msg) false)))
          ((validate-success _)
            (do (print "  FAIL: ") (print path) (println " expected engine error but validation succeeded") false))))
      ((none)
        (print "  FAIL: could not load ") (println path) false)))

  (fn assert-engine-error-separate ((arena Arena) (data-path String) (shapes-path String) (expected-substring String))
    (@intent "Assert that validating separate data/shapes files triggers the engine's ValidatorResult::Error (e.g. shape recursion), not a crash or a silent conforms/violations report -- and that the error message contains expected-substring, pinning WHICH channel produced it, same as assert-engine-error")
    (@spec ((Arena String String String) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena data-path)
      ((some dg)
        (match (load-test-graph arena shapes-path)
          ((some sg)
            (match (validate arena dg sg)
              ((validate-error msg)
                (if (contains msg expected-substring)
                  (do (print "  PASS: ") (print data-path) (print " engine error: ") (println msg) true)
                  (do (print "  FAIL: ") (print data-path) (print " engine error message did not contain '") (print expected-substring) (print "': ") (println msg) false)))
              ((validate-success _)
                (do (print "  FAIL: ") (print data-path) (println " expected engine error but validation succeeded") false))))
          ((none)
            (print "  FAIL: could not load shapes ") (println shapes-path) false)))
      ((none)
        (print "  FAIL: could not load data ") (println data-path) false)))

  (fn reset-test-arena ((arena Arena))
    (@intent "Release allocations retained by completed integration tests before running another scale regression")
    (@spec ((Arena) -> Unit))
    (@alloc arena)
    (c-inline "slop_arena_reset(arena)"))

  (fn poison-test-arena ((arena Arena) (nbytes Int))
    (@intent
      "Fill the next nbytes of the arena with 0x01 so that a subsequent reset makes every allocation land on NON-ZERO memory. Required to make the map-value-width regressions observable at all: slop_arena_alloc is a bump allocator over one large malloc, so on a fresh arena every allocation sits on kernel zero pages and a value written 4 bytes wide but read 8 bytes wide reads back CORRECTLY by accident -- which is exactly why the whole existing suite was blind to this defect. Always call as reset -> poison -> reset, so the poison starts at offset 0 and allocation restarts inside it. 0x01 is chosen deliberately: the stale upper word becomes 0x01010101, which is positive and ~7e13 over the depth budget. 0xFF would set the sign bit, making the corrupted value NEGATIVE so it compares under the budget and passes silently; 0x00 is the accidentally-correct case. Keep nbytes within the arena's base capacity, since reset frees the overflow chain.")
    (@spec ((Arena Int) -> Unit))
    (@alloc arena)
    (c-inline "memset(slop_arena_alloc(arena, (size_t)nbytes), 0x01, (size_t)nbytes)"))

  (fn path-depth-of ((arena Arena) (path String) (shape-iri String))
    (@intent
      "Measure path-node-eval-depth for a NAMED property shape's sh:path in a fixture. Asserting the depth directly is the point: the end-to-end budget comparison only fires when the corrupted value is positive, so roughly half of all corrupted draws are invisible to a conforms/errors assertion. Returns -1 if the shape has no sh:path and -2 if the fixture will not load, so a broken fixture can never masquerade as a plausible depth.")
    (@spec ((Arena String String) -> Int))
    (@alloc arena)
    (match (load-test-graph arena path)
      ((some g)
        (let ((objs (indexed-graph-objects arena g (make-iri arena shape-iri) (make-iri arena SHACL_PATH))))
          (match (list-get objs 0)
            ((some path-node) (path-node-eval-depth arena g path-node))
            ((none) -1))))
      ((none) -2)))

  (fn assert-validates ((arena Arena) (path String))
    (@intent
      "Assert that validation completes with a report -- conforming or not, violation count irrelevant -- and specifically NOT with a ValidatorResult::Error. One check covers both spurious channels this fix is about: 'Path nesting depth budget' and 'Shape recursion detected'. Used by the soak, where the fixtures' violation counts are beside the point and only the absence of engine errors matters.")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena path)
      ((some g)
        (match (validate arena g g)
          ((validate-success _)
            (do (print "  PASS: ") (print path) (println " validated (no engine error)") true))
          ((validate-error msg)
            (do (print "  FAIL: ") (print path) (print " unexpected engine error: ") (println msg) false))))
      ((none)
        (print "  FAIL: could not load ") (println path) false)))

  (fn soak-one ((arena Arena) (fixture String))
    (@intent
      "One soak iteration: poison and reset the arena, validate a structurally varied fixture, then re-measure the flat single-predicate control that runs after it. Quiet on success -- the soak prints one summary line rather than three per fixture -- and specific on failure, naming which fixture preceded the drift. The control is re-measured after EVERY fixture because the defect is about what the previous allocation pattern left behind, not about any one input.")
    (@spec ((Arena String) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 4194304)
      (reset-test-arena arena)
      (let ((mut ok true))
        (match (load-test-graph arena fixture)
          ((some g)
            (match (validate arena g g)
              ((validate-success _) (do))
              ((validate-error msg)
                (do (print "  FAIL: ") (print fixture) (print " unexpected engine error: ") (println msg)
                    (set! ok false)))))
          ((none)
            (do (print "  FAIL: could not load ") (println fixture) (set! ok false))))
        (when (not (== (path-depth-of arena "fixtures/path-depth-flat.ttl" "http://example.org/NameProp") 1))
          (do (print "  FAIL: flat control depth drifted after ") (println fixture) (set! ok false)))
        (match (load-test-graph arena "fixtures/path-depth-flat.ttl")
          ((some fg)
            (match (validate arena fg fg)
              ((validate-success _) (do))
              ((validate-error msg)
                (do (print "  FAIL: flat control errored after ") (print fixture) (print ": ") (println msg)
                    (set! ok false)))))
          ((none) (do (println "  FAIL: could not load flat control") (set! ok false))))
        ok)))

  (fn assert-depth ((arena Arena) (path String) (shape-iri String) (expected Int))
    (@intent "Assert a named property shape's path depth equals expected, printing the actual value on failure so a corrupted read is legible rather than just 'false'")
    (@spec ((Arena String String Int) -> Bool))
    (@alloc arena)
    (let ((actual (path-depth-of arena path shape-iri)))
      (if (== actual expected)
        (do (print "  PASS: ") (print shape-iri) (print " depth = ") (print actual) (println "") true)
        (do (print "  FAIL: ") (print shape-iri) (print " expected depth ") (print expected)
            (print " but got ") (print actual) (println "") false))))

  (fn assert-violations-separate ((arena Arena) (data-path String) (shapes-path String) (expected-count Int))
    (@intent "Assert that separate data/shapes files produce exactly N violations")
    (@spec ((Arena String String Int) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena data-path)
      ((some dg)
        (match (load-test-graph arena shapes-path)
          ((some sg)
            (match (validate arena dg sg)
              ((validate-success report)
                (let ((violations (get-violations arena report))
                      (actual-count (list-len violations)))
                  (if (== actual-count expected-count)
                    (do (print "  PASS: ") (print data-path) (print " has ")
                        (print (int-to-string arena expected-count)) (println " violation(s)") true)
                    (do (print "  FAIL: ") (print data-path) (print " expected ")
                        (print (int-to-string arena expected-count)) (print " violation(s) but got ")
                        (println (int-to-string arena actual-count)) false))))
              ((validate-error msg)
                (print "  FAIL: validation error: ") (println msg) false)))
          ((none)
            (print "  FAIL: could not load shapes ") (println shapes-path) false)))
      ((none)
        (print "  FAIL: could not load data ") (println data-path) false)))

  ;; ============================================================
  ;; Individual Tests
  ;; ============================================================

  (fn test-empty-graph ((arena Arena))
    (@intent "Test that an empty graph conforms")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/empty.ttl"))

  (fn test-valid-person ((arena Arena))
    (@intent "Test that a valid person conforms")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/valid-person.ttl"))

  (fn test-rdf12-annotation-block ((arena Arena))
    (@intent "Test RDF 1.2 {| |} annotation blocks parse and validate")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena "fixtures/rdf12-annotation-valid.ttl")
      ((some g)
        (let ((size (indexed-graph-size g)))
          (if (and (== size 17) (conforms arena g g))
            (do (println "  PASS: RDF 1.2 annotation block parses and conforms") true)
            (do (print "  FAIL: RDF 1.2 annotation expected 17 triples and conformance, got ")
                (println (int-to-string arena size)) false))))
      ((none)
        (do (println "  FAIL: could not load RDF 1.2 annotation fixture") false))))

  (fn test-cardinality-violation ((arena Arena))
    (@intent "Test that missing required property is detected")
    (@spec ((Arena) -> Bool))
    (assert-has-violations arena "fixtures/cardinality-violation.ttl"))

  (fn test-datatype-violation ((arena Arena))
    (@intent "Test that wrong datatype is detected")
    (@spec ((Arena) -> Bool))
    (assert-has-violations arena "fixtures/datatype-violation.ttl"))

  (fn test-class-violation ((arena Arena))
    (@intent "Test that wrong class type is detected")
    (@spec ((Arena) -> Bool))
    (assert-has-violations arena "fixtures/class-violation.ttl"))

  (fn test-nodekind-violation ((arena Arena))
    (@intent "Test that wrong node kind is detected")
    (@spec ((Arena) -> Bool))
    (assert-has-violations arena "fixtures/nodekind-violation.ttl"))

  (fn test-target-node ((arena Arena))
    (@intent "Test sh:targetNode targeting")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/target-node.ttl"))

  (fn test-multiple-violations ((arena Arena))
    (@intent "Test detection of multiple violations")
    (@spec ((Arena) -> Bool))
    (assert-has-violations arena "fixtures/multiple-violations.ttl"))

  (fn test-report-string ((arena Arena))
    (@intent "Test that report-to-string produces non-empty output")
    (@spec ((Arena) -> Bool))
    (match (load-test-graph arena "fixtures/cardinality-violation.ttl")
      ((some g)
        (match (validate arena g g)
          ((validate-success report)
            (let ((text (report-to-string arena report)))
              (if (> (string-len text) 0)
                (do (println "  PASS: report-to-string produces output") true)
                (do (println "  FAIL: report-to-string returned empty string") false))))
          ((validate-error _) (do (println "  FAIL: validation error") false))))
      ((none) (do (println "  FAIL: could not load fixture") false))))

  ;; ============================================================
  ;; Separate Data/Shapes Tests
  ;; ============================================================

  (fn test-employee-directory ((arena Arena))
    (@intent "Test employee directory with closed shape, value ranges, patterns")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/employee-dir-data.ttl" "fixtures/employee-dir-shapes.ttl" 5))

  (fn test-product-catalog ((arena Arena))
    (@intent "Test product catalog with minExclusive, sh:in, pattern")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/product-catalog-data.ttl" "fixtures/product-catalog-shapes.ttl" 3))

  (fn test-address-book ((arena Arena))
    (@intent "Test address book with logical constraints and sh:in")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/address-book-data.ttl" "fixtures/address-book-shapes.ttl" 2))

  (fn test-valid-library ((arena Arena))
    (@intent "Test all-valid library data conforms")
    (@spec ((Arena) -> Bool))
    (assert-conforms-separate arena "fixtures/library-data.ttl" "fixtures/library-shapes.ttl"))

  (fn test-multi-shape ((arena Arena))
    (@intent "Test multiple shapes targeting different classes")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/multi-shape-data.ttl" "fixtures/multi-shape-shapes.ttl" 3))

  ;; ============================================================
  ;; Regression Tests
  ;; ============================================================

  (fn test-subclass-class-conforms ((arena Arena))
    (@intent "Regression (sh:class subClassOf*): a value typed as a subclass of the required class is a SHACL instance of it and conforms (SHACL 4.1)")
    (@spec ((Arena) -> Bool))
    (assert-conforms-separate arena "fixtures/subclass-class-conforms-data.ttl" "fixtures/subclass-class-conforms-shapes.ttl"))

  (fn test-subclass-class ((arena Arena))
    (@intent "Regression (sh:class subClassOf*): direct and transitive subclass instances satisfy sh:class; an unrelated-class value still violates (exactly 1)")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/subclass-class-data.ttl" "fixtures/subclass-class-shapes.ttl" 1))

  (fn test-vacuous-or ((arena Arena))
    (@intent "Regression (sh:or vacuous satisfaction): a property-shape member with no value nodes is vacuously satisfied; only the node that fails every branch violates (exactly 1)")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/vacuous-or-data.ttl" "fixtures/vacuous-or-shapes.ttl" 1))

  (fn test-cycle-self-loop ((arena Arena))
    (@intent "Regression (shape-recursion guard): a shape whose own property shape sh:node points back at itself, evaluated over data with a matching reflexive edge, must produce the engine's shape-recursion error, not a crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-self-loop.ttl" "Shape recursion detected"))

  (fn test-cycle-mutual ((arena Arena))
    (@intent "Regression (shape-recursion guard): two shapes that reference each other (A -> B -> A) evaluated over a matching mutual data cycle must produce the engine's shape-recursion error")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-mutual.ttl" "Shape recursion detected"))

  (fn test-cycle-acyclic-chain ((arena Arena))
    (@intent "Regression (shape-recursion guard): a plain acyclic shape chain (A -> B -> C) must validate normally -- the guard must not false-positive on ordinary non-recursive shape references")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-chain.ttl"))

  (fn test-cycle-diamond ((arena Arena))
    (@intent "Regression (shape-recursion guard): a diamond shape DAG (A references B and C; B and C both reference D) is a shared reference, not a cycle -- must validate normally")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-diamond.ttl"))

  (fn test-cycle-recursive-person-acyclic ((arena Arena))
    (@intent "Regression (shape-recursion guard): a recursive PersonShape (sh:property path knows with sh:node PersonShape) over acyclic data (alice knows bob, no back-edge) must validate normally -- the guard must be pair-keyed by (shape, node), not shape alone, or it would falsely refuse this")
    (@spec ((Arena) -> Bool))
    (assert-conforms-separate arena "fixtures/cycle-recursive-person-acyclic-data.ttl" "fixtures/cycle-recursive-person-shapes.ttl"))

  (fn test-cycle-recursive-person-cyclic ((arena Arena))
    (@intent "Regression (shape-recursion guard): the same recursive PersonShape over cyclic data (alice knows bob, bob knows alice) must produce the engine's shape-recursion error, not unbounded recursion")
    (@spec ((Arena) -> Bool))
    (assert-engine-error-separate arena "fixtures/cycle-recursive-person-cyclic-data.ttl" "fixtures/cycle-recursive-person-shapes.ttl" "Shape recursion detected"))

  (fn test-cycle-path-inverse-self ((arena Arena))
    (@intent "Regression (parse-time recursion hazard): a path expression whose sh:inversePath points back at itself must produce a deterministic parse/engine error -- parse-path has no cycle guard of its own and used to overflow the C stack (process abort) on this input")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-path-inverse-self.ttl" "Cyclic sh:path expression detected"))

  (fn test-cycle-in-list ((arena Arena))
    (@intent "Regression (parse-time recursion hazard): sh:in's list has a cyclic rdf:rest chain that never reaches rdf:nil -- the vendored rdf-list-elements-indexed has no visited set and used to hang forever; must now produce a deterministic parse/engine error")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-in-list.ttl" "Malformed RDF list detected"))

  (fn test-cycle-path-legitimate ((arena Arena))
    (@intent "Regression (parse-time recursion hazard): the pre-parse hazard scan must not false-positive on legitimate, non-cyclic sequence paths and alternative paths")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-path-legitimate.ttl"))

  ;; ============================================================
  ;; Fix-round regression tests (FB1-FB4, CLEANUPs)
  ;; ============================================================

  (fn test-cycle-propshape-node ((arena Arena))
    (@intent "Regression (FB1: property-shape-map bypass, sh:node): a shape-reference cycle routed through a bare PropertyShape via sh:node must be guarded, not crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-propshape-node.ttl" "Shape recursion detected"))

  (fn test-cycle-propshape-and ((arena Arena))
    (@intent "Regression (FB1: property-shape-map bypass, sh:and): a shape-reference cycle routed through a bare PropertyShape via sh:and must be guarded, not crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-propshape-and.ttl" "Shape recursion detected"))

  (fn test-cycle-propshape-or ((arena Arena))
    (@intent "Regression (FB1: property-shape-map bypass, sh:or): a shape-reference cycle routed through a bare PropertyShape via sh:or must be guarded, not crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-propshape-or.ttl" "Shape recursion detected"))

  (fn test-cycle-propshape-xone ((arena Arena))
    (@intent "Regression (FB1: property-shape-map bypass, sh:xone): a shape-reference cycle routed through a bare PropertyShape via sh:xone must be guarded, not crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-propshape-xone.ttl" "Shape recursion detected"))

  (fn test-cycle-propshape-not ((arena Arena))
    (@intent "Regression (FB1: property-shape-map bypass, sh:not): a shape-reference cycle routed through a bare PropertyShape via sh:not must be guarded, not crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-propshape-not.ttl" "Shape recursion detected"))

  (fn test-cycle-propshape-acyclic-control ((arena Arena))
    (@intent "Regression (FB1 control): the same sh:node -> PropertyShape structure with no data back-edge must validate normally -- the property-shape-map arm's guard must not false-positive")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-propshape-acyclic-control.ttl"))

  (fn test-cycle-propshape-swallowed ((arena Arena))
    (@intent "Regression (FB1 lens-1 g1 case): a cycle detected INSIDE a property-shape-map subtree must surface as the engine's shape-recursion error, NEVER a fabricated violation report from a fail-closed cut-short")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-propshape-swallowed.ttl" "Shape recursion detected"))

  (fn test-cycle-propshape-swallowed-control ((arena Arena))
    (@intent "Regression (FB1 g1 control): the same nested property/node shape structure with no data back-edge must validate normally")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-propshape-swallowed-control.ttl"))

  (fn test-cycle-qualified-value-shape ((arena Arena))
    (@intent "Regression (CLEANUP: named sh:qualifiedValueShape coverage): a cycle reached only via sh:qualifiedValueShape must produce the engine's shape-recursion error")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-qualified-value-shape.ttl" "Shape recursion detected"))

  (fn test-cycle-list-and ((arena Arena))
    (@intent "Regression (CLEANUP: named per-predicate list-cycle coverage, sh:and)")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-list-and.ttl" "Malformed RDF list detected"))

  (fn test-cycle-list-or ((arena Arena))
    (@intent "Regression (CLEANUP: named per-predicate list-cycle coverage, sh:or)")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-list-or.ttl" "Malformed RDF list detected"))

  (fn test-cycle-list-xone ((arena Arena))
    (@intent "Regression (CLEANUP: named per-predicate list-cycle coverage, sh:xone)")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-list-xone.ttl" "Malformed RDF list detected"))

  (fn test-cycle-list-language-in ((arena Arena))
    (@intent "Regression (CLEANUP: named per-predicate list-cycle coverage, sh:languageIn)")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-list-language-in.ttl" "Malformed RDF list detected"))

  (fn test-cycle-list-ignored-properties ((arena Arena))
    (@intent "Regression (CLEANUP: named per-predicate list-cycle coverage, sh:ignoredProperties)")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-list-ignored-properties.ttl" "Malformed RDF list detected"))

  (fn test-max-errors-precedence ((arena Arena))
    (@intent "Regression (CLEANUP: max-errors precedence): with max-errors=1, an ordinary violation (evaluated first) must not truncate the run before a later node-shape's genuine cycle is detected -- an engine error always takes precedence over a capped success report")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena "fixtures/cycle-maxerrors-data.ttl")
      ((some dg)
        (match (load-test-graph arena "fixtures/cycle-maxerrors-shapes.ttl")
          ((some sg)
            (let ((config (record-new ValidatorConfig (verbose false) (max-errors 1) (include-warnings true) (include-infos true))))
              (match (validate-with-config arena dg sg config)
                ((validate-error msg)
                  (if (contains msg "Shape recursion")
                    (do (println "  PASS: max-errors=1 still surfaces the engine error") true)
                    (do (print "  FAIL: max-errors=1 error message did not contain 'Shape recursion': ") (println msg) false)))
                ((validate-success _)
                  (do (println "  FAIL: max-errors=1 silently truncated the engine error into a success report") false)))))
          ((none) (do (println "  FAIL: could not load fixtures/cycle-maxerrors-shapes.ttl") false))))
      ((none) (do (println "  FAIL: could not load fixtures/cycle-maxerrors-data.ttl") false))))

  (fn test-cycle-scale-acyclic-3000 ((arena Arena))
    (@intent "Regression (FB2, KNOWN GAP vs. the fix-round brief's literal target): the fix-round brief asked for 'legit acyclic chain at N=3000 => CONFORMS in bounded time'. The false-positive hash-table hazard behind N=50/200 IS fixed (see test-cycle-scale-acyclic-3000's sibling coverage in the FB1/list tests and the fix-round report's FB2 disposition) -- but N=3000 native recursion through this engine's mutually-recursive evaluate-* family independently overflows the C stack around depth ~780 on this machine, a SEPARATE hazard from the hash bug, requiring a full iterative rewrite of the core evaluator to close (out of this round's scope; see engine.slop's depth-budget note). This test asserts the delivered, honest behavior instead: a clean depth-budget ValidatorResult::Error, never a crash -- not the originally-hoped-for CONFORMS. Genuinely closing this gap is the recommended follow-up.")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-scale-acyclic-3000.ttl" "depth budget"))

  (fn test-cycle-scale-cyclic-1000 ((arena Arena))
    (@intent "Regression (FB2): the same recursive PersonShape over a cyclic 1000-node ring must produce the engine's ValidatorResult::Error -- never a crash. (At this depth the depth-budget backstop, not the pair-revisit check, is what fires first -- see the fix-round report's FB2 disposition -- so this asserts only the error class, not a specific message channel.)")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena "fixtures/cycle-scale-cyclic-1000.ttl")
      ((some g)
        (match (validate arena g g)
          ((validate-error msg)
            (do (print "  PASS: fixtures/cycle-scale-cyclic-1000.ttl engine error: ") (println msg) true))
          ((validate-success _)
            (do (println "  FAIL: fixtures/cycle-scale-cyclic-1000.ttl expected engine error but validation succeeded") false))))
      ((none) (do (println "  FAIL: could not load fixtures/cycle-scale-cyclic-1000.ttl") false))))

  (fn test-cycle-path-linear-50000 ((arena Arena))
    (@intent "Regression (FB3: path pre-scan/parser reproduced the crash class they guard against): a legitimate sh:inversePath chain 50000 levels deep must validate (CONFORMS) in bounded time -- both the pre-scan and the real parser are now iterative, not natively recursive")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-path-linear-50000.ttl"))

  (fn test-cycle-path-shared-dag-30 ((arena Arena))
    (@intent "Regression (FB3): a legitimate, non-cyclic sh:alternativePath DAG with shared sub-paths (2^30 unmemoized re-walks) must validate (CONFORMS) fast -- both the pre-scan and the real parser now memoize, visiting each path node once")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-path-shared-dag-30.ttl"))

  ;; ============================================================
  ;; Map value-width regressions (SLOP map-put 4-byte/8-byte defect)
  ;;
  ;; Every test below runs on a POISONED arena. That is not incidental: the
  ;; arena is one large malloc, so on a clean run every allocation lands on
  ;; kernel zero pages and a 4-byte write read back 8 bytes wide is correct by
  ;; accident. Without reset -> poison -> reset these tests are vacuous, and the
  ;; 46 tests above are precisely why the defect shipped -- none of them dirty
  ;; the arena, so none of them could see it.
  ;; ============================================================

  (fn test-path-depth-structural ((arena Arena))
    (@intent "Regression (map-put value width): path-node-eval-depth is the structural nesting depth resolve-path would descend -- 1 for a flat predicate, otherwise 1 + the deepest child, with an entire sh:inversePath chain counting as ONE level because resolve-inverse peels it iteratively. Asserted on the memo's returned value rather than laundered through the budget comparison, so a corrupted depth whose garbage upper half sets the sign bit (roughly half of all draws) cannot pass unnoticed.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Poisoned like the rest of this block. Measured unpoisoned, this test can
    ;; pass by luck -- pre-fix it did, while the purity test running immediately
    ;; after read 25769803779 for one of these very same paths. A test that can
    ;; pass by accident is not a detector.
    (reset-test-arena arena)
    (poison-test-arena arena 16777216)
    (reset-test-arena arena)
    (let ((p "fixtures/path-depth-cases.ttl")
          (mut ok true))
      (when (not (assert-depth arena p "http://example.org/FlatProp" 1)) (set! ok false))
      (when (not (assert-depth arena p "http://example.org/SeqProp" 2)) (set! ok false))
      (when (not (assert-depth arena p "http://example.org/AltProp" 2)) (set! ok false))
      (when (not (assert-depth arena p "http://example.org/InverseChainProp" 2)) (set! ok false))
      (when (not (assert-depth arena p "http://example.org/NestedProp" 3)) (set! ok false))
      (when (not (assert-depth arena p "http://example.org/DeepSeqProp" 4)) (set! ok false))
      ok))

  (fn test-path-depth-purity ((arena Arena))
    (@intent "Regression (map-put value width): the computed depth is a PURE FUNCTION of graph structure. Measures every case, then churns the arena and poisons it, reloads the same fixture and measures again -- the two vectors must be identical and equal to the structural constants. Pre-fix the second pass drew different garbage than the first, which is exactly the downstream report's 'two identical runs, different failure sets'.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((p "fixtures/path-depth-cases.ttl")
          (d1 (path-depth-of arena p "http://example.org/FlatProp"))
          (d2 (path-depth-of arena p "http://example.org/SeqProp"))
          (d3 (path-depth-of arena p "http://example.org/NestedProp"))
          (d4 (path-depth-of arena p "http://example.org/DeepSeqProp")))
      (reset-test-arena arena)
      (poison-test-arena arena 16777216)
      (reset-test-arena arena)
      (let ((e1 (path-depth-of arena p "http://example.org/FlatProp"))
            (e2 (path-depth-of arena p "http://example.org/SeqProp"))
            (e3 (path-depth-of arena p "http://example.org/NestedProp"))
            (e4 (path-depth-of arena p "http://example.org/DeepSeqProp")))
        (if (and (and (== d1 e1) (== d2 e2)) (and (== d3 e3) (== d4 e4)))
          (if (and (and (== e1 1) (== e2 2)) (and (== e3 3) (== e4 4)))
            (do (println "  PASS: path depth is stable and correct across a poisoned arena reset") true)
            (do (println "  FAIL: path depths stable but structurally wrong") false))
          (do (print "  FAIL: path depth changed across arena reuse: ")
              (print d1) (print ",") (print d2) (print ",") (print d3) (print ",") (print d4)
              (print " -> ") (print e1) (print ",") (print e2) (print ",") (print e3) (print ",") (println e4)
              false)))))

  (fn test-path-depth-poisoned-arena ((arena Arena))
    (@intent "Regression (map-put value width, the downstream-reported bug): (map-put depths n (+ best 1)) allocated sizeof(int) = 4 bytes for a value the declared (Map Term Int) reads back as int64_t, so the upper 32 bits were whatever the bump allocator last left there. Poisons the arena with 0x01 and resets so allocation restarts inside the poisoned region, then asserts BOTH the memo's direct value (exactly 1 for a flat predicate path) and the end-to-end outcome (CONFORMS, i.e. no spurious 'Path nesting depth budget (1000) exceeded'). Fails on both pre-fix; on a pristine arena it cannot fail at all.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 16777216)
      (reset-test-arena arena)
      (let ((depth-ok (assert-depth arena "fixtures/path-depth-flat.ttl" "http://example.org/NameProp" 1))
            (conforms-ok (assert-conforms arena "fixtures/path-depth-flat.ttl")))
        (and depth-ok conforms-ok))))

  (fn test-cycle-guard-revisit-after-unwind ((arena Arena))
    (@intent "Regression (map-put value width, CycleGuard reference counts): cycle-guard-add stored the count literal 1 as 4 bytes into a slot read back as int64_t, so cycle-guard-remove's (c - 1) left garbage<<32 rather than 0 and the pair stayed permanently 'active'. Two focus nodes referencing the SAME (ChildShape, ex:kid) pair is a legitimate add -> remove -> add, and must conform rather than report 'Shape recursion detected'. Run poisoned, since on virgin memory the count is correct by accident.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 16777216)
      (reset-test-arena arena)
      (assert-conforms arena "fixtures/cycle-guard-revisit-after-unwind.ttl")))

  (fn test-cycle-diamond-poisoned ((arena Arena))
    (@intent "Regression (map-put value width): cycle-diamond.ttl ALREADY exercised the CycleGuard count corruption -- ex:BShape and ex:CShape both apply sh:node ex:DShape to the same focus node, so (DShape, ex:a) is add -> remove -> add. It passed pre-fix only because it ran on virgin arena memory. Re-running it poisoned converts a long-standing false negative into a real assertion.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 16777216)
      (reset-test-arena arena)
      (assert-conforms arena "fixtures/cycle-diamond.ttl")))

  (fn test-cycle-acyclic-controls-poisoned ((arena Arena))
    (@intent "Regression (map-put value width): the remaining acyclic control fixtures re-run on a poisoned arena. Each one legitimately revisits shape/node pairs after unwinding, so each was a potential false 'Shape recursion detected' pre-fix and a false negative in the suite.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 16777216)
      (reset-test-arena arena)
      (let ((a (assert-conforms arena "fixtures/cycle-propshape-acyclic-control.ttl"))
            (b (assert-conforms arena "fixtures/cycle-propshape-swallowed-control.ttl"))
            (c (assert-conforms arena "fixtures/cycle-path-shared-dag-30.ttl"))
            (d (assert-conforms-separate arena "fixtures/cycle-recursive-person-acyclic-data.ttl" "fixtures/cycle-recursive-person-shapes.ttl")))
        (and (and a b) (and c d)))))

  (fn test-path-depth-over-budget ((arena Arena))
    (@intent "The budget itself must still be enforced: a path nested 1002 deep produces the pre-scan's depth-budget ERROR rather than a native stack overflow. The expected substring pins the PATH budget channel specifically, distinguishing it from engine.slop's separate 'Shape recursion depth budget'.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 4194304)
      (reset-test-arena arena)
      (assert-engine-error arena "fixtures/path-depth-over-budget.ttl" "Path nesting depth budget")))

  (fn test-path-depth-at-budget ((arena Arena))
    (@intent "Off-by-one guard on the budget boundary: depth exactly 1000 must still validate, since the comparison is (> depth budget). Post-fix this is also the strongest statement that the memo is EXACT rather than merely small -- an approximate depth would land on the wrong side of a boundary this tight.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (do
      (reset-test-arena arena)
      (poison-test-arena arena 4194304)
      (reset-test-arena arena)
      (assert-validates arena "fixtures/path-depth-at-budget.ttl")))

  (fn test-diverse-input-soak ((arena Arena))
    (@intent "Regression (map-put value width, cross-input): the depth memo and the CycleGuard counts are per-run arena allocations, so the defect only surfaces when the arena is REUSED across varied work -- which is why the downstream failure needed a long process with diverse inputs and could not be reproduced by repeating one shape set. Each iteration re-poisons and resets, validates a structurally different shapes graph (long IRIs, blank-node nesting, RDF lists, varied path nesting), then re-measures the flat control. Asserts no fixture produces ANY engine error, and that the flat control's depth is exactly 1 and conforms every single time.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    ;; Unrolled deliberately: a (List String) of fixture paths would itself be
    ;; arena-allocated, and every iteration resets that arena out from under it.
    (let ((mut ok true))
      (when (not (soak-one arena "fixtures/empty.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/valid-person.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/target-node.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/soak-long-iris.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/soak-blank-nodes.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/soak-lists.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/cycle-chain.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/cycle-diamond.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/cycle-path-legitimate.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/cycle-propshape-acyclic-control.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/cycle-path-shared-dag-30.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/cardinality-violation.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/multiple-violations.ttl")) (set! ok false))
      (when (not (soak-one arena "fixtures/rdf12-annotation-valid.ttl")) (set! ok false))
      (if ok
        (do (println "  PASS: diverse-input soak -- no engine errors, flat control stable throughout") true)
        false)))

  ;; ============================================================
  ;; Main Test Runner
  ;; ============================================================

  (fn main ((argc Int) (argv (Ptr (Ptr U8))))
    (@intent "Run all CLI integration tests")
    (@spec ((Int (Ptr (Ptr U8))) -> Int))
    :c-name "main"
    (with-arena 67108864  ;; 64MB
      (println "Snarl CLI Integration Tests")
      (println "===========================")
      (println "")

      (let ((mut passed 0)
            (mut failed 0))

        ;; Run each test
        (if (test-empty-graph arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-valid-person arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-rdf12-annotation-block arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cardinality-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-datatype-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-class-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-nodekind-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-target-node arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-multiple-violations arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-report-string arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Separate data/shapes tests
        (if (test-employee-directory arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-product-catalog arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-address-book arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-valid-library arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-multi-shape arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Regression tests
        (if (test-subclass-class-conforms arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-subclass-class arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-vacuous-or arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Shape-recursion guard regression tests
        (if (test-cycle-self-loop arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-mutual arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-acyclic-chain arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-diamond arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-recursive-person-acyclic arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-recursive-person-cyclic arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-path-inverse-self arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-in-list arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-path-legitimate arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Fix-round regression tests (FB1-FB4, CLEANUPs)
        (if (test-cycle-propshape-node arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-and arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-or arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-xone arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-not arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-acyclic-control arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-swallowed arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-swallowed-control arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-qualified-value-shape arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-and arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-or arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-xone arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-language-in arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-ignored-properties arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-max-errors-precedence arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-scale-acyclic-3000 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-scale-cyclic-1000 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-path-linear-50000 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-path-shared-dag-30 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Map value-width regressions. Deliberately LAST: every test above runs
        ;; on a pristine arena and their expectations depend on that, whereas
        ;; each of these resets and poisons the arena as part of the assertion.
        (if (test-path-depth-structural arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-purity arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-poisoned-arena arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-guard-revisit-after-unwind arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-diamond-poisoned arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-acyclic-controls-poisoned arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-over-budget arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-at-budget arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-diverse-input-soak arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Summary
        (println "")
        (println "---")
        (print (int-to-string arena passed))
        (print " passed, ")
        (print (int-to-string arena failed))
        (println " failed")

        (if (== failed 0) 0 1)))))
