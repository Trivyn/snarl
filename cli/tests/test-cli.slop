  (fn test-core-flags-unsupported ((arena Arena))
    (@intent "An sh:flags value snarl does not implement is an engine error")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/core-flags-unsupported.ttl" "sh:flags \"x\" of shape [anonymous shape] is not supported"))

  (fn test-pattern-uncompilable ((arena Arena))
    (@intent "Test an sh:pattern the regex engine cannot compile is an engine error naming the pattern and the regcomp error, not a violation for every value")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/pattern-uncompilable.ttl" "sh:pattern \"^(ab$\" of shape [anonymous shape] does not compile as a regular expression (REG_EPAREN)"))

  ;; ============================================================
  ;; Regression Tests
  ;; ============================================================

  (fn test-subclass-class-conforms ((arena Arena))
    (@intent "Regression (sh:class subClassOf*): a value typed as a subclass of the required class is a SHACL instance of it and conforms (SHACL 4.1)")
    (@spec ((Arena) -> Bool))
    (assert-conforms-separate arena "fixtures/subclass-class-conforms-data.ttl" "fixtures/subclass-class-conforms-shapes.ttl"))

  (fn test-subclass-class ((arena Arena))
    (@intent "Regression (sh:class subClassOf*): direct and transitive subclass instances satisfy sh:class; an unrelated-class value still violates (exactly 1)")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/subclass-class-data.ttl" "fixtures/subclass-class-shapes.ttl" 1))

  (fn test-vacuous-or ((arena Arena))
    (@intent "Regression (sh:or vacuous satisfaction): a property-shape member with no value nodes is vacuously satisfied; only the node that fails every branch violates (exactly 1)")
    (@spec ((Arena) -> Bool))
    (assert-violations-separate arena "fixtures/vacuous-or-data.ttl" "fixtures/vacuous-or-shapes.ttl" 1))

  (fn test-cycle-self-loop ((arena Arena))
    (@intent "Regression (shape-recursion guard): a shape whose own property shape sh:node points back at itself, evaluated over data with a matching reflexive edge, must produce the engine's shape-recursion error, not a crash")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-self-loop.ttl" "Shape recursion detected"))

  (fn test-cycle-mutual ((arena Arena))
    (@intent "Regression (shape-recursion guard): two shapes that reference each other (A -> B -> A) evaluated over a matching mutual data cycle must produce the engine's shape-recursion error")
    (@spec ((Arena) -> Bool))
    (assert-engine-error arena "fixtures/cycle-mutual.ttl" "Shape recursion detected"))

  (fn test-cycle-acyclic-chain ((arena Arena))
    (@intent "Regression (shape-recursion guard): a plain acyclic shape chain (A -> B -> C) must validate normally -- the guard must not false-positive on ordinary non-recursive shape references")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-chain.ttl"))

  (fn test-cycle-diamond ((arena Arena))
    (@intent "Regression (shape-recursion guard): a diamond shape DAG (A references B and C; B and C both reference D) is a shared reference, not a cycle -- must validate normally")
    (@spec ((Arena) -> Bool))
    (assert-conforms arena "fixtures/cycle-diamond.ttl"))

  (fn test-cycle-recursive-person-acyclic ((arena Arena))
    (@intent "Regression (shape-recursion guard): a recursive PersonShape (sh:property path knows with sh:node PersonShape) over acyclic data (alice knows bob, no back-edge) must validate normally -- the guard must be pair-keyed by (shape, node), not shape alone, or it would falsely refuse this")
    (@spec ((Arena) -> Bool))
    (assert-conforms-separate arena "fixtures/cycle-recursive-person-acyclic-data.ttl" "fixtures/cycle-recursive-person-shapes.ttl"))

  (fn test-cycle-recursive-person-cyclic ((arena Arena))
