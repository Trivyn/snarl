  ;; ============================================================
  ;; SPARQL rules beside triple rules (0.8.1)
  ;; ============================================================

  (fn report-text ((arena Arena) (data-path String) (shapes-path String))
    (@intent "The validation report text for a data file and a shapes file validated with the default config (no rules run), or none on a load failure or engine error (printed)")
    (@spec ((Arena String String) -> (Option String)))
    (@alloc arena)
    (match (load-test-graph arena data-path)
      ((some dg)
        (match (load-test-graph arena shapes-path)
          ((some sg)
            (match (validate arena dg sg)
              ((validate-success report) (some (report-to-string arena report)))
              ((validate-error msg)
                (print "  FAIL: ") (print shapes-path) (print " engine error: ") (println msg) (none))))
          ((none) (print "  FAIL: could not load ") (println shapes-path) (none))))
      ((none) (print "  FAIL: could not load ") (println data-path) (none))))

  (fn assert-same-report ((arena Arena) (data-path String) (shapes-a String) (shapes-b String) (expected-marker String))
    (@intent "Assert that a data file validates to the same report text against two shapes files, and that the text contains expected-marker")
    (@spec ((Arena String String String String) -> Bool))
    (@alloc arena)
    (match (report-text arena data-path shapes-a)
      ((some a)
        (match (report-text arena data-path shapes-b)
          ((some b)
            (if (and (string-eq a b) (contains a expected-marker))
              (do (print "  PASS: ") (print data-path) (print " validates the same against ") (print shapes-a) (print " and ") (println shapes-b) true)
              (do (print "  FAIL: ") (print data-path) (print " reports differ, or lack '") (print expected-marker) (print "':\n") (println a) (println b) false)))
          ((none) false)))
      ((none) false)))

  (fn test-sparql-rule-validate-only-violates ((arena Arena))
    (@intent "Validation that runs no rules reports the same violation with unexecutable rules in the shapes graph as without them")
    (@spec ((Arena) -> Bool))
    (assert-same-report arena "fixtures/af-sparql-data-bad.ttl" "fixtures/af-sparql-shapes.ttl" "fixtures/af-sparql-shapes-norules.ttl" "MinCountConstraintComponent"))

  (fn test-sparql-rule-validate-only-conforms ((arena Arena))
    (@intent "Validation that runs no rules conforms with unexecutable rules in the shapes graph exactly as without them")
    (@spec ((Arena) -> Bool))
    (assert-same-report arena "fixtures/af-sparql-data-ok.ttl" "fixtures/af-sparql-shapes.ttl" "fixtures/af-sparql-shapes-norules.ttl" "CONFORMS"))

