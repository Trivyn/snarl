  (fn test-af-expression-report ((arena Arena))
    (@intent "An sh:expression violation carries sh:sourceConstraint, the expression's sh:message and the ExpressionConstraintComponent")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena "fixtures/af-expression.ttl")
      ((some g)
        (match (validate arena g g)
          ((validate-success report)
            (let ((text (report-to-string arena report)))
              (if (and (contains text "Source constraint: ")
                       (contains text "Person must be verified")
                       (contains text "ExpressionConstraintComponent"))
                (do (println "  PASS: sh:expression results carry sourceConstraint and message") true)
                (do (print "  FAIL: sh:expression report is missing sourceConstraint or message:\n") (println text) false))))
          ((validate-error msg) (print "  FAIL: validation error: ") (println msg) false)))
      ((none) (println "  FAIL: could not load fixtures/af-expression.ttl") false)))

  (fn test-af-report-blank-nodes ((arena Arena))
    (@intent "Regression: report-to-graph numbered its own blank nodes from 0, so an inline sh:expression (shapes-graph blank node 0) emitted as sh:sourceConstraint came out as the report node itself. No sh:sourceConstraint may point at a node typed sh:ValidationReport or sh:ValidationResult.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-graph arena "fixtures/af-expression.ttl")
      ((some g)
        (match (validate arena g g)
          ((validate-success report)
            (let ((rg (report-to-graph arena report))
                  (no-term (Option Term) (none))
                  (type-pred (make-iri arena "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"))
                  (mut seen 0)
                  (mut clashes 0))
              (for-each (tr (indexed-graph-match arena rg no-term (some (make-iri arena "http://www.w3.org/ns/shacl#sourceConstraint")) no-term))
                (set! seen (+ seen 1))
                (when (> (list-len (indexed-graph-objects arena rg (triple-object tr) type-pred)) 0)
                  (set! clashes (+ clashes 1))))
              (if (and (== seen 4) (== clashes 0))
                (do (println "  PASS: report blank nodes do not collide with sh:sourceConstraint nodes") true)
                (do (print "  FAIL: ") (print (int-to-string arena clashes)) (print " of ")
                    (print (int-to-string arena seen)) (println " sh:sourceConstraint values are report nodes") false))))
          ((validate-error msg) (print "  FAIL: validation error: ") (println msg) false)))
      ((none) (println "  FAIL: could not load fixtures/af-expression.ttl") false)))

