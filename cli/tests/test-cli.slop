    (@intent "The same shapes graph is an engine error once rules run")
    (@spec ((Arena) -> Bool))
    (assert-af-error arena "fixtures/af-sparql-shapes.ttl" (af-config true false) "sh:SPARQLRule"))

  (fn test-sparql-rule-entailment-fails ((arena Arena))
    (@intent "With sh:entailment sh:Rules declared, plain validation runs the rules, so an sh:SPARQLRule is still an engine error")
    (@spec ((Arena) -> Bool))
    (assert-af-error arena "fixtures/af-sparql-entailment.ttl" (af-config false false) "sh:SPARQLRule"))

  (fn test-af12-rules-validate-only ((arena Arena))
    (@intent "In SHACL 1.2 mode, rule-only constructs snarl lacks (global rule, rule template, sh:runOnce) do not fail validation that runs no rules")
    (@spec ((Arena) -> Bool))
    (assert-inference arena "fixtures/af12-rules-validate-only.ttl" (af-config false true) 0 0))

  (fn test-af12-rules-run-fails ((arena Arena))
    (@intent "The same SHACL 1.2 rule constructs are an engine error once rules run")
    (@spec ((Arena) -> Bool))
    (assert-af-error arena "fixtures/af12-rules-validate-only.ttl" (af-config true true) "not supported"))

  (fn rule-config ((run-rules Bool) (shacl12 Bool) (defer Bool) (order-min (Option RuleOrder)) (order-max (Option RuleOrder)))
    (@intent "Default validator config with the rule options set")
    (@spec ((Bool Bool Bool (Option RuleOrder) (Option RuleOrder)) -> ValidatorConfig))
    (@pure)
    (record-new ValidatorConfig (verbose false) (max-errors 0) (include-warnings true) (include-infos true)
      (run-rules run-rules) (shacl12 shacl12) (defer-sparql-rules defer) (order-min order-min) (order-max order-max)))

  (fn order-key ((shape-order Float) (rule-order Float))
    (@intent "An order-range bound")
    (@spec ((Float Float) -> (Option RuleOrder)))
    (@pure)
    (some (record-new RuleOrder (shape-order shape-order) (rule-order rule-order))))

  (fn no-order ()
    (@intent "An open order-range bound")
    (@spec (() -> (Option RuleOrder)))
    (@pure)
    (none))

  (fn ex-iri ((arena Arena) (local String))
    (@intent "The IRI http://example.org/<local>")
    (@spec ((Arena String) -> Term))
    (@alloc arena)
    (make-iri arena (string-concat arena "http://example.org/" local)))

  (fn has-inferred ((arena Arena) (inferred (List InferredTriple)) (s String) (p String) (o Term) (rule String) (focus String))
    (@intent "True when inferred holds exactly one entry for the triple (ex:s ex:p o), and it names ex:rule and ex:focus")
    (@spec ((Arena (List InferredTriple) String String Term String String) -> Bool))
    (@alloc arena)
    (let ((want (make-triple arena (ex-iri arena s) (ex-iri arena p) o))
          (mut hits 0)
          (mut right 0))
      (for-each (it inferred)
        (when (and
                (term-eq (. (. it triple) subject) (. want subject))
                (and
                  (term-eq (. (. it triple) predicate) (. want predicate))
                  (term-eq (. (. it triple) object) (. want object))))
          (set! hits (+ hits 1))
          (when (and (term-eq (. it rule) (ex-iri arena rule)) (term-eq (. it focus-node) (ex-iri arena focus)))
            (set! right (+ right 1)))))
      (and (== hits 1) (== right 1))))

  (fn infer-count ((arena Arena) (path String) (config ValidatorConfig))
    (@intent "Run infer on a fresh load of a fixture (data and shapes in one file): the number of inferred triples, or -1 on a load failure or engine error (printed)")
    (@spec ((Arena String ValidatorConfig) -> Int))
    (@alloc arena)
    (match (load-test-data-graph arena path)
      ((some dg)
        (match (load-test-graph arena path)
          ((some sg)
            (match (infer arena dg sg config)
              ((infer-success out) (list-len (. out inferred)))
              ((infer-error msg) (print "  infer error: ") (println msg) -1)))
          ((none) -1)))
      ((none) -1)))

  (fn assert-infer-count ((arena Arena) (label String) (path String) (config ValidatorConfig) (expected Int))
    (@intent "Assert that infer on a fresh load of a fixture infers exactly expected triples")
    (@spec ((Arena String String ValidatorConfig Int) -> Bool))
    (@alloc arena)
    (let ((got (infer-count arena path config)))
      (if (== got expected)
        (do (print "  PASS: ") (print label) (print ": ") (print (int-to-string arena got)) (println " inferred") true)
        (do (print "  FAIL: ") (print label) (print ": expected ") (print (int-to-string arena expected))
            (print " inferred, got ") (println (int-to-string arena got)) false))))

  (fn assert-infer-error ((arena Arena) (path String) (config ValidatorConfig) (expected-substring String))
    (@intent "Assert that infer on a fixture fails with an engine error containing expected-substring")
    (@spec ((Arena String ValidatorConfig String) -> Bool))
    (@alloc arena)
    (match (load-test-data-graph arena path)
      ((some dg)
        (match (load-test-graph arena path)
          ((some sg)
            (match (infer arena dg sg config)
              ((infer-error msg)
                (if (contains msg expected-substring)
                  (do (print "  PASS: ") (print path) (print " infer error: ") (println msg) true)
                  (do (print "  FAIL: ") (print path) (print " infer error did not contain '") (print expected-substring) (print "': ") (println msg) false)))
              ((infer-success _)
                (do (print "  FAIL: ") (print path) (println " expected an infer error but inference succeeded") false))))
          ((none) (print "  FAIL: could not load ") (println path) false)))
      ((none) (print "  FAIL: could not load ") (println path) false)))

  (fn assert-deferred ((arena Arena) (label String) (path String) (config ValidatorConfig) (expected-inferred Int) (expected-deferred Int) (rule String) (shape String) (shape-order Float) (rule-order Float))
    (@intent "Assert that infer on a fixture infers expected-inferred triples and defers expected-deferred SPARQL rules; when one is expected, that it is ex:rule of ex:shape with the given order key")
    (@spec ((Arena String String ValidatorConfig Int Int String String Float Float) -> Bool))
    (@alloc arena)
    (match (load-test-data-graph arena path)
      ((some dg)
        (match (load-test-graph arena path)
          ((some sg)
            (match (infer arena dg sg config)
              ((infer-success out)
                (let ((mut ok (and (== (list-len (. out inferred)) expected-inferred) (== (list-len (. out deferred)) expected-deferred))))
                  (when (and ok (> expected-deferred 0))
                    (match (list-get (. out deferred) 0)
                      ((some d)
                        (when (not (and
                                     (and (term-eq (. d rule) (ex-iri arena rule)) (term-eq (. d shape) (ex-iri arena shape)))
                                     (and (== (. (. d order) shape-order) shape-order) (== (. (. d order) rule-order) rule-order))))
                          (set! ok false)))
                      ((none) (set! ok false))))
                  (if ok
                    (do (print "  PASS: ") (print label) (print ": ") (print (int-to-string arena (list-len (. out inferred)))) (print " inferred, ")
                        (print (int-to-string arena (list-len (. out deferred)))) (println " deferred") true)
                    (do (print "  FAIL: ") (print label) (print ": got ") (print (int-to-string arena (list-len (. out inferred)))) (print " inferred, ")
                        (print (int-to-string arena (list-len (. out deferred)))) (println " deferred, or the deferred rule is not the expected one") false))))
              ((infer-error msg) (print "  FAIL: ") (print label) (print " infer error: ") (println msg) false)))
          ((none) (print "  FAIL: could not load ") (println path) false)))
      ((none) (print "  FAIL: could not load ") (println path) false)))

  (fn test-defer-sparql-rules ((arena Arena))
    (@intent "With defer-sparql-rules, infer runs the two triple rules and reports the one active SPARQL rule with its shape and order key (3, 2); a deactivated SPARQL rule and one on a deactivated shape are not reported")
    (@spec ((Arena) -> Bool))
    (assert-deferred arena "defer-sparql-rules" "fixtures/af-defer-sparql.ttl" (rule-config true false true (no-order) (no-order)) 2 1 "SparqlRule" "NodeShape" 3.0 2.0))

  (fn test-defer-sparql-rules-shacl12 ((arena Arena))
    (@intent "In SHACL 1.2 mode the deferred rule's order key ignores the shape's sh:order: (0, 2)")
    (@spec ((Arena) -> Bool))
    (assert-deferred arena "defer-sparql-rules, shacl12" "fixtures/af-defer-sparql.ttl" (rule-config true true true (no-order) (no-order)) 2 1 "SparqlRule" "NodeShape" 0.0 2.0))

  (fn test-defer-off-fails ((arena Arena))
    (@intent "Without defer-sparql-rules, infer fails on the SPARQL rule as 0.8.0 does")
    (@spec ((Arena) -> Bool))
    (assert-infer-error arena "fixtures/af-defer-sparql.ttl" (rule-config true false false (no-order) (no-order)) "sh:SPARQLRule at http://example.org/SparqlRule is not supported"))

  (fn test-defer-unknown-rule-type-fails ((arena Arena))
    (@intent "Deferral covers sh:SPARQLRule only: an unknown rule type still fails")
    (@spec ((Arena) -> Bool))
    (assert-infer-error arena "fixtures/af-unknown-rule-type.ttl" (rule-config true false true (no-order) (no-order)) "Unsupported SHACL rule type"))

  (fn test-defer-follows-order-range ((arena Arena))
    (@intent "The deferred list covers the order range: with the range ending before the SPARQL rule's key (3, 2), one triple rule runs and nothing is deferred")
    (@spec ((Arena) -> Bool))
    (assert-deferred arena "defer-sparql-rules, range below the SPARQL rule" "fixtures/af-defer-sparql.ttl" (rule-config true false true (no-order) (order-key 3.0 1.0)) 1 0 "" "" 0.0 0.0))

  (fn test-defer-validate-entailment ((arena Arena))
    (@intent "With defer-sparql-rules, a shapes graph that declares the rules entailment and holds an sh:SPARQLRule validates: the triple rule infers 1 triple and the SPARQL rule is reported in the outcome")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-data-graph arena "fixtures/af-sparql-entailment.ttl")
      ((some dg)
        (match (load-test-graph arena "fixtures/af-sparql-entailment.ttl")
          ((some sg)
            (let ((outcome (validate-data-graph-with-inference arena dg sg (rule-config false false true (no-order) (no-order)))))
              (match (. outcome result)
                ((validate-success _)
                  (if (and
                        (== (list-len (. outcome inferred)) 1)
                        (and
                          (== (list-len (. outcome deferred)) 1)
                          (match (list-get (. outcome deferred) 0)
                            ((some d) (term-eq (. d rule) (ex-iri arena "SparqlRule")))
                            ((none) false))))
                    (do (println "  PASS: validation with deferral reports the SPARQL rule in the outcome") true)
                    (do (println "  FAIL: validation with deferral: wrong inferred or deferred lists") false)))
                ((validate-error msg) (print "  FAIL: validation with deferral: ") (println msg) false))))
          ((none) (println "  FAIL: could not load fixtures/af-sparql-entailment.ttl") false)))
      ((none) (println "  FAIL: could not load fixtures/af-sparql-entailment.ttl") false)))

  (fn test-order-range-bounds ((arena Arena))
    (@intent "order-min / order-max on a fresh graph each time (see af-order-range.ttl for the levels): both bounds are inclusive, an absent bound is open, keys compare shape order first, and an empty range runs nothing")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (let ((f "fixtures/af-order-range.ttl")
          (mut ok true))
      (when (not (assert-infer-count arena "no range: a b d e" f (rule-config true false false (no-order) (no-order)) 4)) (set! ok false))
      (when (not (assert-infer-count arena "max (0,1): a" f (rule-config true false false (no-order) (order-key 0.0 1.0)) 1)) (set! ok false))
      (when (not (assert-infer-count arena "max (0,2): a b" f (rule-config true false false (no-order) (order-key 0.0 2.0)) 2)) (set! ok false))
      (when (not (assert-infer-count arena "(0,1)..(0,2): a b" f (rule-config true false false (order-key 0.0 1.0) (order-key 0.0 2.0)) 2)) (set! ok false))
      (when (not (assert-infer-count arena "max (0,3): a b d" f (rule-config true false false (no-order) (order-key 0.0 3.0)) 3)) (set! ok false))
      (when (not (assert-infer-count arena "(0,2)..(0,2) on a fresh graph: nothing has ex:a" f (rule-config true false false (order-key 0.0 2.0) (order-key 0.0 2.0)) 0)) (set! ok false))
      (when (not (assert-infer-count arena "min (0,2): only e, at (1,0)" f (rule-config true false false (order-key 0.0 2.0) (no-order)) 1)) (set! ok false))
      (when (not (assert-infer-count arena "min (1,0): e" f (rule-config true false false (order-key 1.0 0.0) (no-order)) 1)) (set! ok false))
      (when (not (assert-infer-count arena "max (0,0): nothing" f (rule-config true false false (no-order) (order-key 0.0 0.0)) 0)) (set! ok false))
      (when (not (assert-infer-count arena "empty range (0,3)..(0,1)" f (rule-config true false false (order-key 0.0 3.0) (order-key 0.0 1.0)) 0)) (set! ok false))
      (when (not (assert-infer-count arena "shacl12, max (0,0): e, whose key is then (0,0)" f (rule-config true true false (no-order) (order-key 0.0 0.0)) 1)) (set! ok false))
      ok))

  (fn infer-step ((arena Arena) (dg SnarlDataGraph) (sg IndexedGraph) (lo Float) (hi Float))
    (@intent "Run the rules with rule order in [lo, hi] (shape order 0) over dg; the inference output, or none on an engine error (printed)")
    (@spec ((Arena SnarlDataGraph IndexedGraph Float Float) -> (Option InferOutput)))
    (@alloc arena)
    (match (infer arena dg sg (rule-config true false false (order-key 0.0 lo) (order-key 0.0 hi)))
      ((infer-success out) (some out))
      ((infer-error msg) (print "  infer error: ") (println msg) (none))))

  (fn test-order-range-stepping ((arena Arena))
    (@intent "A caller stepping one level at a time over one graph, as an orchestrator does: level 1 infers a; level 2 infers b but not c, because the two level-2 rules do not see each other's triples; level 3 infers d; level 2 again infers c, now that b is in the graph")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-data-graph arena "fixtures/af-order-range.ttl")
      ((some dg0)
        (match (load-test-graph arena "fixtures/af-order-range.ttl")
          ((some sg)
            (let ((t (make-literal arena "true" (some "http://www.w3.org/2001/XMLSchema#boolean") (none)))
                  (mut ok true)
                  (mut dg dg0))
              (match (infer-step arena dg sg 1.0 1.0)
                ((some out)
                  (set! dg (. out graph))
                  (when (not (and (== (list-len (. out inferred)) 1) (triple-inferred arena (. out inferred) "n" "a" t))) (set! ok false)))
                ((none) (set! ok false)))
              (match (infer-step arena dg sg 2.0 2.0)
                ((some out)
                  (set! dg (. out graph))
                  (when (not (and (== (list-len (. out inferred)) 1) (triple-inferred arena (. out inferred) "n" "b" t))) (set! ok false)))
                ((none) (set! ok false)))
              (match (infer-step arena dg sg 3.0 3.0)
                ((some out)
                  (set! dg (. out graph))
                  (when (not (and (== (list-len (. out inferred)) 1) (triple-inferred arena (. out inferred) "n" "d" t))) (set! ok false)))
                ((none) (set! ok false)))
              (match (infer-step arena dg sg 2.0 2.0)
                ((some out)
                  (set! dg (. out graph))
                  (when (not (and (== (list-len (. out inferred)) 1) (triple-inferred arena (. out inferred) "n" "c" t))) (set! ok false)))
                ((none) (set! ok false)))
              (if ok
                (do (println "  PASS: stepping levels 1, 2, 3, 2 infers a, b, d, c") true)
                (do (println "  FAIL: stepping levels 1, 2, 3, 2 did not infer a, b, d, c one at a time") false))))
          ((none) (println "  FAIL: could not load fixtures/af-order-range.ttl") false)))
      ((none) (println "  FAIL: could not load fixtures/af-order-range.ttl") false)))

  (fn triple-inferred ((arena Arena) (inferred (List InferredTriple)) (s String) (p String) (o Term))
    (@intent "True when inferred holds the triple (ex:s ex:p o)")
    (@spec ((Arena (List InferredTriple) String String Term) -> Bool))
    (@alloc arena)
    (let ((mut found false))
      (for-each (it inferred)
        (when (and
                (term-eq (. (. it triple) subject) (ex-iri arena s))
                (and
                  (term-eq (. (. it triple) predicate) (ex-iri arena p))
                  (term-eq (. (. it triple) object) o)))
          (set! found true)))
      found))

  (fn test-attribution ((arena Arena))
    (@intent "Every inferred triple names the rule and focus node that produced it: two rules on one shape over two focus nodes, a rule that repeats another's triples (nothing new, the first keeps them), and one triple produced for both focus nodes (attributed to the first). The list is in inference order: rule by rule, focus node by focus node.")
    (@spec ((Arena) -> Bool))
    (@alloc arena)
    (match (load-test-data-graph arena "fixtures/af-attribution.ttl")
      ((some dg)
        (match (load-test-graph arena "fixtures/af-attribution.ttl")
          ((some sg)
            (match (infer arena dg sg (rule-config true false false (no-order) (no-order)))
              ((infer-success out)
                (let ((inf (. out inferred)))
                  (if (and
                        (== (list-len inf) 5)
                        (and
                          (and
                            (has-inferred arena inf "n1" "p" (ex-iri arena "v") "RuleA" "n1")
                            (has-inferred arena inf "n2" "p" (ex-iri arena "v") "RuleA" "n2"))
                          (and
                            (and
                              (has-inferred arena inf "n1" "q" (ex-iri arena "w") "RuleB" "n1")
                              (has-inferred arena inf "n2" "q" (ex-iri arena "w") "RuleB" "n2"))
                            (and
                              (has-inferred arena inf "shared" "from" (ex-iri arena "k") "RuleD" "n1")
                              (match (list-get inf 0)
                                ((some first) (term-eq (. first rule) (ex-iri arena "RuleA")))
                                ((none) false))))))
                    (do (println "  PASS: each inferred triple names its rule and focus node") true)
                    (do (print "  FAIL: attribution: ") (print (int-to-string arena (list-len inf))) (println " inferred, or a wrong rule or focus node")
                        (for-each (it inf)
                          (print "    ") (print (term-display arena (. (. it triple) subject))) (print " ") (print (term-display arena (. (. it triple) predicate)))
                          (print " by ") (print (term-display arena (. it rule))) (print " for ") (println (term-display arena (. it focus-node))))
                        false))))
              ((infer-error msg) (print "  FAIL: attribution: infer error: ") (println msg) false)))
          ((none) (println "  FAIL: could not load fixtures/af-attribution.ttl") false)))
      ((none) (println "  FAIL: could not load fixtures/af-attribution.ttl") false)))

  (fn term-display ((arena Arena) (t Term))
    (@intent "An IRI's string, or a placeholder for any other term")
    (@spec ((Arena Term) -> String))
    (@pure)
    (match t
      ((term-iri iri) (. iri value))
      (_ "[non-IRI]")))

  (fn main ((argc Int) (argv (Ptr (Ptr U8))))
    (@intent "Run all CLI integration tests")
    (@spec ((Int (Ptr (Ptr U8))) -> Int))
    :c-name "main"
    (with-arena 67108864  ;; 64MB
      (println "Snarl CLI Integration Tests")
      (println "===========================")
      (println "")

      (let ((mut passed 0)
            (mut failed 0))

        ;; Run each test
        (if (test-empty-graph arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-valid-person arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-rdf12-annotation-block arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cardinality-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-datatype-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-class-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-nodekind-violation arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-target-node arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-multiple-violations arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-report-string arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Separate data/shapes tests
        (if (test-employee-directory arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-product-catalog arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-address-book arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-streamed-data-graph-employee arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-streamed-data-graph-rdf12 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-valid-library arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-multi-shape arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-pattern-unicode arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-pattern-noncapturing arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-pattern-uncompilable arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-core-value-range-types arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-core-string-details arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-core-flags-unsupported arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Regression tests
        (if (test-subclass-class-conforms arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-subclass-class arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-vacuous-or arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Shape-recursion guard regression tests
        (if (test-cycle-self-loop arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-mutual arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-acyclic-chain arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-diamond arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-recursive-person-acyclic arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-recursive-person-cyclic arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-path-inverse-self arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-in-list arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-path-legitimate arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Fix-round regression tests (FB1-FB4, CLEANUPs)
        (if (test-cycle-propshape-node arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-and arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-or arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-xone arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-not arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-acyclic-control arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-swallowed arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-propshape-swallowed-control arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-qualified-value-shape arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-and arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-or arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-xone arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-language-in arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-list-ignored-properties arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-max-errors-precedence arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-scale-acyclic-3000 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-scale-cyclic-1000 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-path-linear-50000 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (reset-test-arena arena)
        (if (test-cycle-path-shared-dag-30 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Map value-width regressions. Deliberately LAST: every test above runs
        ;; on a pristine arena and their expectations depend on that, whereas
        ;; each of these resets and poisons the arena as part of the assertion.
        (if (test-path-depth-structural arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-purity arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-poisoned-arena arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-guard-revisit-after-unwind arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-diamond-poisoned arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-cycle-acyclic-controls-poisoned arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-over-budget arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-path-depth-at-budget arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-diverse-input-soak arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; SHACL-AF (non-SPARQL subset)
        (if (test-af-node-exprs arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-rules-off arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-rules-condition arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-entailment arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-entailment-shacl12-name arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-order-visible arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-order-same arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-deactivated arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-expression arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-expression-report arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-report-blank-nodes arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-sparql-rule arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-function-expr arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-unknown-entailment arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-shnex-without-flag arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-expr-cycle arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-triplerule-missing-slot arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af-triplerule-default-slot-shacl12 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-node-exprs arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-list-duplicates arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-unsupported-function arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-global-rule arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-global-rule-af-mode arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; SPARQL rules beside triple rules
        (if (test-sparql-rule-validate-only-violates arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-sparql-rule-validate-only-conforms arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-sparql-rule-run-rules-fails arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-sparql-rule-entailment-fails arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-rules-validate-only arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-af12-rules-run-fails arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-defer-sparql-rules arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-defer-sparql-rules-shacl12 arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-defer-off-fails arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-defer-unknown-rule-type-fails arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-defer-follows-order-range arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-defer-validate-entailment arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-order-range-bounds arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-order-range-stepping arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))
        (if (test-attribution arena) (set! passed (+ passed 1)) (set! failed (+ failed 1)))

        ;; Summary
        (println "")
        (println "---")
        (print (int-to-string arena passed))
        (print " passed, ")
        (print (int-to-string arena failed))
        (println " failed")

        (if (== failed 0) 0 1)))))
