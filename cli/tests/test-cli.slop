    (assert-violations arena "fixtures/pattern-unicode.ttl" 2))

  (fn test-pattern-noncapturing ((arena Arena))
    (@intent "Test sh:pattern accepts XPath non-capturing groups (?:...) -- alone, nested, optional, repeated and in the semver.org SemVer regex -- while a capturing group and an escaped or bracketed (?: keep their meaning")
    (@spec ((Arena) -> Bool))
    (assert-violations arena "fixtures/pattern-noncapturing.ttl" 8))

