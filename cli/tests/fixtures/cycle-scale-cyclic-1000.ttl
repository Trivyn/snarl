@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Regression (FB2): the same recursive PersonShape over a CYCLIC ring of
# 1000 distinct nodes (n0->n1->...->n999->n0). Must produce the engine's
# ValidatorResult::Error -- never a crash, never a silent conforms.
# Generated (1000 nodes, ring closed n999->n0).
ex:PersonShape a sh:NodeShape ; sh:targetClass ex:Person ;
    sh:property [ sh:path ex:knows ; sh:node ex:PersonShape ] .

