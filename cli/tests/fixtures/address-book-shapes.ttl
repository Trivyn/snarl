@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# ContactShape: logical constraints (sh:or), sh:in
ex:ContactShape
    a sh:NodeShape ;
    sh:targetClass ex:Contact ;
    sh:property [
        sh:path ex:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path ex:phone ;
        sh:datatype xsd:string ;
        sh:pattern "^[+]?[0-9]+$" ;
    ] ;
    sh:property [
        sh:path ex:contactType ;
        sh:in ( ex:Personal ex:Business ex:Emergency ) ;
    ] ;
    sh:property [
        sh:path ex:email ;
        sh:nodeKind sh:Literal ;
    ] .
